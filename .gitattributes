third-party/vanessa-automation/**/*.patch text eol=lf whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
third-party/vanessa-automation/**/manifest.json text eol=lf
# The pinned OpenSpec npm lock is authenticated by its exact source bytes.
.agents/skills/1c-workflow/resources/openspec-cli/package-lock.json -text
# Verbatim pinned upstream excerpts used by the executable regression.
tests/fixtures/vanessa-nested-selection/*.bsl text eol=lf whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
tests/fixtures/vanessa-row-criteria/navigation.bsl text eol=lf whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
tests/fixtures/vanessa-client-code/*-upstream.bsl -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
tests/fixtures/vanessa-testclient-ports/*-upstream.bsl -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
# Hash-pinned client_mcp metadata, notices and native baseline are verbatim.
third-party/client-mcp/** -text
# Designer XML keeps native BOM/CRLF; CR is the transport line ending.
third-party/client-mcp/**/Language.xml whitespace=cr-at-eol
third-party/client-mcp/**/LICENSE.upstream whitespace=cr-at-eol
tests/fixtures/client-mcp-language/Configuration.xml -text whitespace=cr-at-eol
# Native Designer dump and stand texts of the minimal gate stand.
tests/fixtures/gate-stand/** -text whitespace=cr-at-eol
tests/fixtures/gate-stand/*.md text eol=lf
tests/fixtures/gate-stand/*.json text eol=lf
# Native Designer applicability log and test-extension module keep BOM/CRLF.
tests/fixtures/project-tests-readiness/** -text whitespace=cr-at-eol
# Exact upstream HTML form and module blobs retain their native bytes.
tests/fixtures/vanessa-html-forms/lib/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol

# Exact upstream portability modules retain their native BOM and line endings.
tests/fixtures/vanessa-extension-portability/lib/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol

# Hash-pinned excerpt and new recipe notices must survive checkout unchanged.
tests/fixtures/vanessa-current-window-expression/function.upstream.bsl -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab
tests/fixtures/vanessa-current-window-expression/provenance.json text eol=lf
