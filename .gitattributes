# Verbatim PM5 artifacts (2026-11-03) for the verification-diagnostics regressions.
tests/fixtures/vanessa-verification-diagnostics/*.lgp -text
tests/fixtures/vanessa-verification-diagnostics/*.lgf -text
tests/fixtures/vanessa-verification-diagnostics/*.xml -text
