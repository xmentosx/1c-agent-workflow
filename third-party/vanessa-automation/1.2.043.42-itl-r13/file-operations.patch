+// The window can show several forms, for example on the start page; the first form
+// that owns the element is used. Form 0 keeps the upstream behavior.
+&НаКлиенте
+Функция ITLПолеHTMLДокументаОкна(Окно)
+	Для Каждого ФормаОкна Из Окно.Содержимое Цикл
+		Элемент = ФормаОкна.Элементы.Найти(ЗначениеИмяЭлементаФормы);
+		Если Элемент <> Неопределено Тогда
+			Возврат Элемент;
+		КонецЕсли;
+	КонецЦикла;
+	Возврат Окно.Содержимое[0].Элементы[ЗначениеИмяЭлементаФормы];
+КонецФункции
+
+// ITL type 3: the whole anchor text, then a part of href. Closed <details> ancestors
+// are opened before the click. Without a match the anchors are listed for the caller.
+&НаКлиенте
+Процедура ITLНажатьНаГиперссылкуПоDOM(ПолеHTMLДокумента)
+	Попытка
+		Ссылки = ПолеHTMLДокумента.Документ.getElementsByTagName("a");
+		Искомое = НРег(ITLНормализоватьТекстСсылки(ИмяГиперссылки));
+		ЧастьАдреса = НРег(СокрЛП(ИмяГиперссылки));
+		ПоТексту = Неопределено;
+		ПоАдресу = Неопределено;
+		Перечень = Новый Массив;
+		Для Сч = 0 По Ссылки.length - 1 Цикл
+			// HTMLCollection.item is a method call; indexing is the upstream fallback.
+			Попытка
+				ТекСсылка = Ссылки.item(Сч);
+			Исключение
+				ТекСсылка = Ссылки[Сч];
+			КонецПопытки;
+			Текст = ITLНормализоватьТекстСсылки(ТекСсылка.textContent);
+			Адрес = ТекСсылка.getAttribute("href");
+			Если ТипЗнч(Адрес) <> Тип("Строка") Тогда
+				Адрес = "";
+			КонецЕсли;
+			Перечень.Добавить("'" + Текст + "' -> " + Адрес);
+			Если ПоТексту = Неопределено И НРег(Текст) = Искомое Тогда
+				ПоТексту = ТекСсылка;
+			КонецЕсли;
+			Если ПоАдресу = Неопределено И ЗначениеЗаполнено(ЧастьАдреса) И СтрНайти(НРег(Адрес), ЧастьАдреса) > 0 Тогда
+				ПоАдресу = ТекСсылка;
+			КонецЕсли;
+		КонецЦикла;
+		Ссылка = ?(ПоТексту <> Неопределено, ПоТексту, ПоАдресу);
+		Если Ссылка = Неопределено Тогда
+			НайденныеСсылки = ?(Перечень.Количество() = 0, "<нет ссылок>", СтрСоединить(Перечень, " | "));
+			Возврат;
+		КонецЕсли;
+		Узел = Ссылка.parentNode;
+		Для Глубина = 1 По 200 Цикл
+			Если Узел = Неопределено Или Узел = Null Тогда
+				Прервать;
+			КонецЕсли;
+			ИмяТега = "";
+			Попытка
+				ИмяТега = ВРег(Строка(Узел.tagName));
+			Исключение
+				Прервать;
+			КонецПопытки;
+			Если ИмяТега = "DETAILS" И НЕ Узел.hasAttribute("open") Тогда
+				Узел.setAttribute("open", "");
+			КонецЕсли;
+			Узел = Узел.parentNode;
+		КонецЦикла;
+		Ссылка.click();
+		СсылкаНайдена = Истина;
+	Исключение
+		НайденныеСсылки = "ERROR: " + ОписаниеОшибки();
+	КонецПопытки;
+КонецПроцедуры
+
+&НаКлиенте
+Функция ITLНормализоватьТекстСсылки(Знач Текст)
+	Если ТипЗнч(Текст) <> Тип("Строка") Тогда
+		Возврат "";
+	КонецЕсли;
+	Текст = СтрЗаменить(Текст, Символы.НПП, " ");
+	Текст = СтрЗаменить(Текст, Символы.ВК, " ");
+	Текст = СтрЗаменить(Текст, Символы.ПС, " ");
+	Текст = СтрЗаменить(Текст, Символы.Таб, " ");
+	Пока СтрНайти(Текст, "  ") > 0 Цикл
+		Текст = СтрЗаменить(Текст, "  ", " ");
+	КонецЦикла;
+	Возврат СокрЛП(Текст);
+КонецФункции
+
