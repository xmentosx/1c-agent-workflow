+// ITL: the loaded text crosses the client/server boundary through XDTO, so a character
+// that XML forbids is rejected with its position before Vanessa reads the file. The
+// SHA-256 of the same bytes identifies the text that this call loads.
+Функция ITLПодготовитьЗагрузкуФичи(ИмяФайла, ДопПараметрыВызоваMCP)
+	ТекстФичи = Неопределено;
+	Попытка
+		ХешФичи = ITLХешИТекстФайлаФичи(ИмяФайла, ТекстФичи);
+	Исключение
+		// A missing or unreadable file keeps the existing loader diagnostics.
+		ХешФичи = "";
+		ТекстФичи = Неопределено;
+	КонецПопытки;
+	Если ТекстФичи <> Неопределено Тогда
+		НедопустимыйСимвол = ITLНедопустимыйСимволXMLВФиче(ИмяФайла, ТекстФичи);
+		Если ЗначениеЗаполнено(НедопустимыйСимвол) Тогда
+			ОтклонитьКомандуMCPДоВыполнения("ITL_FEATURE_INVALID_XML_CHARACTER: " + НедопустимыйСимвол + ". "
+				+ Ванесса.Локализовать("Удалите управляющий символ из feature файла, например \f, полученный из пути при записи через escape-последовательность."));
+			Возврат Ложь;
+		КонецЕсли;
+	КонецЕсли;
+	Если ТипЗнч(ДопПараметрыВызоваMCP) = Тип("Структура") Тогда
+		ДопПараметрыВызоваMCP.Вставить("ITLФайлФичи", ИмяФайла);
+		ДопПараметрыВызоваMCP.Вставить("ITLSha256Фичи", ХешФичи);
+	КонецЕсли;
+	Возврат Истина;
