+	Запись = Новый ЗаписьJSON;
+	Запись.ОткрытьФайл(ИмяЗапроса + ".tmp");
+	Попытка
+		ЗаписатьJSON(Запись, Запрос);
+	Исключение
+		Запись.Закрыть();
+		ВызватьИсключение;
+	КонецПопытки;
+	Запись.Закрыть();
+	ПереместитьФайл(ИмяЗапроса + ".tmp", ИмяЗапроса);
+	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
+	Предел = Начало + Макс(3000, ОжидатьСекунд * 1000 + 5000);
+	ПроверкаЖивости = Начало;
+	Пока Истина Цикл
+		Если ФайлСуществуетКомандаСистемы(ИмяОтвета) Тогда
+			Ответ = Неопределено;
+			Попытка
+				Ответ = ITLПрочитатьJSONПомощникаОкон(ИмяОтвета);
+			Исключение
+				Ответ = Неопределено;
+			КонецПопытки;
+			Если ТипЗнч(Ответ) = Тип("Структура") Тогда
+				ITLУдалитьФайлПомощникаОкон(ИмяОтвета);
+				ITLУдалитьФайлПомощникаОкон(ИмяПодтверждения);
+				Возврат Ответ;
+			КонецЕсли;
+		КонецЕсли;
+		Сейчас = ТекущаяУниверсальнаяДатаВМиллисекундах();
+		Подтвержден = ФайлСуществуетКомандаСистемы(ИмяПодтверждения);
+		Если НЕ Подтвержден И Сейчас - Начало >= 3000 Тогда
+			Прервать;
+		КонецЕсли;
+		Если Подтвержден И Сейчас >= Предел Тогда
+			Прервать;
+		КонецЕсли;
+		Если Подтвержден И Сейчас - ПроверкаЖивости >= 1000 Тогда
+			ПроверкаЖивости = Сейчас;
+			Если НЕ ITLПомощникОконЖив(Каталог) Тогда
+				Прервать;
+			КонецЕсли;
+		КонецЕсли;
+		ITLПаузаМс(25);
+	КонецЦикла;
+	ITLУдалитьФайлПомощникаОкон(ИмяЗапроса);
+	ITLУдалитьФайлПомощникаОкон(ИмяПодтверждения);
+	Возврат Неопределено;
+КонецФункции
+
+&НаКлиенте
+// The helper is disposable: its own ensure verb replaces a missing or hung helper.
+Функция ITLПерезапуститьПомощникОкон(Каталог)
+	Попытка
+		Группа = ITLПрочитатьJSONПомощникаОкон(Каталог + "\group.json");
+	Исключение
+		ЗаписатьЛогВЖРОшибка("ITLПерезапуститьПомощникОкон", ОписаниеОшибки());
+		Возврат Ложь;
+	КонецПопытки;
+	Если ТипЗнч(Группа) <> Тип("Структура") Или НЕ Группа.Свойство("executable") Тогда
+		Возврат Ложь;
+	КонецЕсли;
+	Команда = """" + Группа.executable + """ ensure """ + Каталог + """ --hung";
+	Попытка
+		Код = ВыполнитьКомандуОСБезПоказаЧерногоОкна(СтрЗаменить(Команда, "%", "%%"));
+	Исключение
+		ЗаписатьЛогВЖРОшибка("ITLПерезапуститьПомощникОкон", ОписаниеОшибки());
+		Возврат Ложь;
+	КонецПопытки;
+	Возврат Код = 0;
+КонецФункции
+
+&НаКлиенте
+// A request without a reply restarts the helper once and is repeated once; a foreign
+// protocol version counts as an unavailable helper.
+Функция ITLЗапросПомощникуОкон(Операция, Поля, ОжидатьСекунд) Экспорт
+	Каталог = ITLКаталогКаналаОкон();
+	Если НЕ ЗначениеЗаполнено(Каталог) Тогда
+		Возврат Неопределено;
+	КонецЕсли;
+	Для НомерПопытки = 1 По 2 Цикл
+		Ответ = ITLОтправитьЗапросПомощникуОкон(Каталог, Операция, Поля, ОжидатьСекунд);
+		Если Ответ <> Неопределено Тогда
+			Статус = "";
+			Ответ.Свойство("status", Статус);
+			Если Статус = "protocol-mismatch" Тогда
+				Возврат Неопределено;
+			КонецЕсли;
+			Возврат Ответ;
+		КонецЕсли;
+		Если НомерПопытки = 1 И НЕ ITLПерезапуститьПомощникОкон(Каталог) Тогда
+			Возврат Неопределено;
+		КонецЕсли;
+	КонецЦикла;
+	Возврат Неопределено;
+КонецФункции
+
+&НаКлиенте
+Процедура ITLПроверитьОтветПомощникаОкон(Ответ, Действие)
+	Если Ответ = Неопределено Тогда
+		ВызватьИсключение "ITL_WINDOW_HELPER_UNAVAILABLE: помощник окон ITL не ответил и не перезапустился; "
+			+ Действие + " не выполнено. Повторите прогон: при недоступном помощнике клиент тестирования запустится видимым; либо установите ONEC_WINDOW_MODE=visible.";
+	КонецЕсли;
+	Статус = "";
+	Ответ.Свойство("status", Статус);
+	Если Статус = "ok" Тогда
+		Возврат;
+	КонецЕсли;
+	Код = "";
+	Причина = "";
+	Заголовок = "";
+	Ответ.Свойство("code", Код);
+	Ответ.Свойство("reason", Причина);
+	Ответ.Свойство("foregroundTitle", Заголовок);
+	Если Статус = "declined" Тогда
+		ВызватьИсключение "ITL_UI_CONTROL_DECLINED: пользователь не передал управление агенту (" + Причина + "); "
+			+ Действие + " не выполнено, окно клиента тестирования осталось скрытым.";
+	КонецЕсли;
+	Если Код = "ITL_WINDOW_ACTIVATION_FAILED" Тогда
+		ВызватьИсключение "ITL_WINDOW_ACTIVATION_FAILED: окно клиента тестирования не стало активным, активно окно '"
+			+ Заголовок + "'; " + Действие + " не выполнено.";
+	КонецЕсли;
+	ВызватьИсключение "ITL_WINDOW_HELPER_UNAVAILABLE: помощник окон ITL ответил " + Статус + " " + Код + "; "
+		+ Действие + " не выполнено.";
+КонецПроцедуры
+
+&НаКлиенте
+Процедура ITLУчестьАренду(Ответ)
+	Область = ITLОбластьУправления();
+	Если ITLИтогУправления = Неопределено Или ITLИтогУправления.Область <> Область Тогда
+		ITLИтогУправления = Новый Структура("Область,Аренд,ОжиданиеСогласияМс,ОжиданиеОчередиМс", Область, 0, 0, 0);
+	КонецЕсли;
+	Активация = "";
+	Ответ.Свойство("activation", Активация);
+	Если Активация = "kept" Тогда
+		Возврат;
+	КонецЕсли;
+	ITLИтогУправления.Аренд = ITLИтогУправления.Аренд + 1;
+	Значение = 0;
+	Если Ответ.Свойство("consentWaitMs", Значение) И ТипЗнч(Значение) = Тип("Число") Тогда
+		ITLИтогУправления.ОжиданиеСогласияМс = ITLИтогУправления.ОжиданиеСогласияМс + Значение;
+	КонецЕсли;
+	Значение = 0;
+	Если Ответ.Свойство("queueWaitMs", Значение) И ТипЗнч(Значение) = Тип("Число") Тогда
+		ITLИтогУправления.ОжиданиеОчередиМс = ITLИтогУправления.ОжиданиеОчередиМс + Значение;
+	КонецЕсли;
+КонецПроцедуры
+
+&НаКлиенте
+// Ends the lease and the consent of the current scope and returns the time the agent
+// held the user's keyboard and mouse in it, for the MCP response.
+Функция ITLЗавершитьОбластьУправления() Экспорт
+	Если НЕ ЗначениеЗаполнено(ITLКаталогКаналаОкон()) Тогда
+		Возврат "";
+	КонецЕсли;
+	Область = ITLОбластьУправления();
+	Если ITLИтогУправления = Неопределено Или ITLИтогУправления.Область <> Область Или ITLИтогУправления.Аренд = 0 Тогда
+		Возврат "Agent UI control: mode=hidden leases=0";
+	КонецЕсли;
+	Ответ = ITLЗапросПомощникуОкон("lease-end", Новый Структура("scope,endScope", Область, Истина), 5);
+	СекундАренды = 0;
+	Если Ответ <> Неопределено И Ответ.Свойство("leaseMs") И ТипЗнч(Ответ.leaseMs) = Тип("Число") Тогда
+		СекундАренды = Ответ.leaseMs / 1000;
+	КонецЕсли;
+	Итог = "Agent UI control: mode=hidden leases=" + Формат(ITLИтогУправления.Аренд, "ЧН=0; ЧГ=")
+		+ " leaseSeconds=" + Формат(СекундАренды, "ЧН=0; ЧГ=; ЧДЦ=1; ЧРД=.")
+		+ " consentWaitSeconds=" + Формат(ITLИтогУправления.ОжиданиеСогласияМс / 1000, "ЧН=0; ЧГ=; ЧДЦ=1; ЧРД=.")
+		+ " queueWaitSeconds=" + Формат(ITLИтогУправления.ОжиданиеОчередиМс / 1000, "ЧН=0; ЧГ=; ЧДЦ=1; ЧРД=.");
+	ITLИтогУправления = Неопределено;
+	Возврат Итог;
+КонецФункции
+
+&НаКлиенте
+// A successful MCP response of a call that took the user's keyboard and mouse reports
+// how long and with which waits; other responses stay unchanged.
+Функция ITLДобавитьИтогУправления(Текст) Экспорт
+	Если НЕ ЗначениеЗаполнено(ITLКаталогКаналаОкон()) Или ITLИтогУправления = Неопределено
+		Или ITLИтогУправления.Область <> ITLОбластьУправления() Или ITLИтогУправления.Аренд = 0 Тогда
+		Возврат Текст;
+	КонецЕсли;
+	Попытка
+		Итог = ITLЗавершитьОбластьУправления();
+	Исключение
+		ЗаписатьЛогВЖРОшибка("ITLДобавитьИтогУправления", ОписаниеОшибки());
+		Возврат Текст;
+	КонецПопытки;
+	Возврат Строка(Текст) + Символы.ПС + Итог;
+КонецФункции
+
+&НаКлиенте
+Функция ITLТекстПомощникОконНедоступен(Действие) Экспорт
+	Возврат "ITL_WINDOW_HELPER_UNAVAILABLE: помощник окон ITL не ответил и не перезапустился; " + Действие
+		+ " недоступно для скрытого клиента тестирования. Повторите вызов после перезапуска vanessa-ui: при недоступном помощнике клиент запустится видимым; либо установите ONEC_WINDOW_MODE=visible.";
+КонецФункции
+
+&НаКлиенте
+// OS keyboard and mouse input of a hidden TestClient runs only inside a user-approved
+// lease and only while the OS foreground window belongs to the TestClient process.
+Процедура ITLАрендоватьУправлениеДляВводаОС() Экспорт
+	Если НЕ ЗначениеЗаполнено(ITLКаталогКаналаОкон())
+		Или НЕ Объект.ИспользоватьКомпонентуVanessaExt Или ВнешняяКомпонентаДляСкриншотов = Неопределено Тогда
+		Возврат;
+	КонецЕсли;
+	Поля = Новый Структура;
+	Поля.Вставить("scope", ITLОбластьУправления());
+	Если ЗначениеЗаполнено(PIDТекущегоКлиентаТестирования) Тогда
+		Поля.Вставить("pid", PIDТекущегоКлиентаТестирования);
+	КонецЕсли;
+	Ответ = ITLЗапросПомощникуОкон("lease", Поля, ITLСрокОжиданияУправленияСекунд());
+	ITLПроверитьОтветПомощникаОкон(Ответ, "ввод ОС");
+	ITLУчестьАренду(Ответ);
+	PIDКлиента = 0;
+	Ответ.Свойство("pid", PIDКлиента);
+	PIDАктивного = 0;
+	ЗаголовокАктивного = "";
+	Попытка
+		АктивноеОкно = ВнешняяКомпонентаДляСкриншотов.АктивноеОкно;
+		СвойстваОкна = ПрочитатьСтрокуJSON(ВнешняяКомпонентаДляСкриншотов.ПолучитьСвойстваОкна(АктивноеОкно));
+		Если ТипЗнч(СвойстваОкна) = Тип("Структура") Тогда
+			СвойстваОкна.Свойство("ProcessId", PIDАктивного);
+			СвойстваОкна.Свойство("Title", ЗаголовокАктивного);
+		КонецЕсли;
+	Исключение
+		ЗаписатьЛогВЖРОшибка("ITLАрендоватьУправлениеДляВводаОС", ОписаниеОшибки());
+	КонецПопытки;
+	Если НЕ ЗначениеЗаполнено(PIDКлиента) Или PIDАктивного <> PIDКлиента Тогда
+		ВызватьИсключение "ITL_WINDOW_ACTIVATION_FAILED: активно окно '" + ЗаголовокАктивного + "' процесса "
+			+ Формат(PIDАктивного, "ЧН=0; ЧГ=") + ", а не клиента тестирования " + Формат(PIDКлиента, "ЧН=0; ЧГ=")
+			+ "; ввод ОС не выполнен.";
+	КонецЕсли;
+	PIDТекущегоКлиентаТестирования = PIDКлиента;
+КонецПроцедуры
+
+&НаКлиенте
+// A hidden TestClient is shown below the user's windows without activation for a
+// capture; the helper hides it again on capture-end or after its own limit.
+Функция ITLПоказатьКлиентДляСнимка() Экспорт
+	Если НЕ ЗначениеЗаполнено(ITLКаталогКаналаОкон()) Тогда
+		Возврат Истина;
+	КонецЕсли;
+	Поля = Новый Структура;
+	Если ЗначениеЗаполнено(PIDТекущегоКлиентаТестирования) Тогда
+		Поля.Вставить("pid", PIDТекущегоКлиентаТестирования);
+	КонецЕсли;
+	Ответ = ITLЗапросПомощникуОкон("capture-show", Поля, 5);
+	Статус = "";
+	Если Ответ <> Неопределено Тогда
+		Ответ.Свойство("status", Статус);
+	КонецЕсли;
+	Если Статус <> "ok" Тогда
+		ЗаписатьЛогВЖРОшибка("ITLПоказатьКлиентДляСнимка",
+			"WARN ITL_WINDOW_HELPER_UNAVAILABLE: снимок скрытого клиента тестирования пропущен.");
+		Возврат Ложь;
+	КонецЕсли;
+	PIDИзОтвета = 0;
+	Если Ответ.Свойство("pid", PIDИзОтвета) И ЗначениеЗаполнено(PIDИзОтвета) Тогда
+		PIDТекущегоКлиентаТестирования = PIDИзОтвета;
+	КонецЕсли;
+	// The shown window needs a moment to paint before PrintWindow sees it.
+	ITLПаузаМс(400);
+	ОтключитьОбработчикОжидания("ITLЗавершитьПоказДляСнимка");
+	ПодключитьОбработчикОжидания("ITLЗавершитьПоказДляСнимка", 3, Истина);
+	Возврат Истина;
+КонецФункции
+
+&НаКлиенте
+Процедура ITLЗавершитьПоказДляСнимка() Экспорт
+	Если НЕ ЗначениеЗаполнено(ITLКаталогКаналаОкон()) Тогда
+		Возврат;
+	КонецЕсли;
+	Поля = Новый Структура;
+	Если ЗначениеЗаполнено(PIDТекущегоКлиентаТестирования) Тогда
+		Поля.Вставить("pid", PIDТекущегоКлиентаТестирования);
+	КонецЕсли;
+	ITLЗапросПомощникуОкон("capture-end", Поля, 5);
+КонецПроцедуры
+
+&НаКлиенте
+// The window helper reports the hidden TestClient by its port: VanessaExt cannot find a
+// hidden window.
+Процедура ITLЗаполнитьКлиентаИзПомощникаОкон(ДанныеЗапускаКлиентаТестирования, ДопПараметры)
+	Если ДопПараметры = Неопределено Тогда
+		ДопПараметры = Новый Структура;
+	КонецЕсли;
+	ДопПараметры.Вставить("ДанныеЗапускаКлиентаТестирования", ДанныеЗапускаКлиентаТестирования);
+	Порт = ДанныеЗапускаКлиентаТестирования.ПортЗапускаТестКлиента;
+	Клиент = Неопределено;
+	Для НомерПопытки = 1 По 20 Цикл
+		Ответ = ITLЗапросПомощникуОкон("status", Новый Структура("port", Порт), 5);
+		Если Ответ <> Неопределено И Ответ.Свойство("clients") И ТипЗнч(Ответ.clients) = Тип("Массив")
+			И Ответ.clients.Количество() > 0 Тогда
+			Клиент = Ответ.clients[0];
+			Если ЗначениеЗаполнено(Клиент.hwnd) Тогда
+				Прервать;
+			КонецЕсли;
+		КонецЕсли;
+		ITLПаузаМс(250);
+	КонецЦикла;
+	Если Клиент = Неопределено Тогда
+		ЗаписатьЛогВЖРОшибка("ITLЗаполнитьКлиентаИзПомощникаОкон",
+			"Помощник окон ITL не нашёл клиент тестирования на порту " + Формат(Порт, "ЧН=0; ЧГ="));
+		Возврат;
+	КонецЕсли;
+	ДанныеКлиента = Новый Структура("Window,ProcessId", Клиент.hwnd, Клиент.pid);
+	ПолученКлиентТестирования(ЗаписатьОбъектJSON(ДанныеКлиента), Неопределено, ДопПараметры);
+КонецПроцедуры
+
+&НаКлиенте
+// Upstream relies on the connect-time activation for OS keyboard and mouse input.
+// An ITL agent run activates the TestClient immediately before such input instead.
+Процедура ITLАктивироватьКлиентТестированияДляВводаОС() Экспорт
+	Если ЗначениеЗаполнено(ITLКаталогКаналаОкон()) Тогда
+		ITLАрендоватьУправлениеДляВводаОС();
+		Возврат;
+	КонецЕсли;
+	Если НЕ ITLАгентскийЗапуск()
+		Или НЕ Объект.ИспользоватьКомпонентуVanessaExt
+		Или ВнешняяКомпонентаДляСкриншотов = Неопределено
+		Или ДескрипторОсновногоОкнаТекущегоКлиентаТестирования = Неопределено Тогда
+		Возврат;
+	КонецЕсли;
+	Попытка
+		// A foreground window of the client itself (for example its own dialog) keeps the focus.
+		АктивноеОкно = ВнешняяКомпонентаДляСкриншотов.АктивноеОкно;
+		Если ЗначениеЗаполнено(АктивноеОкно) И ЗначениеЗаполнено(PIDТекущегоКлиентаТестирования) Тогда
+			СвойстваОкна = ПрочитатьСтрокуJSON(ВнешняяКомпонентаДляСкриншотов.ПолучитьСвойстваОкна(АктивноеОкно));
+			Если ТипЗнч(СвойстваОкна) = Тип("Структура") И СвойстваОкна.Свойство("ProcessId")
+				И СвойстваОкна.ProcessId = PIDТекущегоКлиентаТестирования Тогда
+				Возврат;
+			КонецЕсли;
+		КонецЕсли;
+	Исключение
+		ЗаписатьЛогВЖРОшибка("ITLАктивироватьКлиентТестированияДляВводаОС", ОписаниеОшибки());
+	КонецПопытки;
+	Попытка
+		ВнешняяКомпонентаДляСкриншотов.АктивироватьОкно(ДескрипторОсновногоОкнаТекущегоКлиентаТестирования);
