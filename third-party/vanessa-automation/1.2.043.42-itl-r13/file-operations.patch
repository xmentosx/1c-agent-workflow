+	Если НЕ Ванесса.ИдетВыполнениеСценариев() Тогда
+		ОтключитьОбработчикОжидания(ИмяОбработчика);
+		Возврат;
+	КонецЕсли;
+	Попытка
+		ITLПроверитьЗахватКодаШагаАгента();
+	Исключение
+		ОтключитьОбработчикОжидания(ИмяОбработчика);
+		ITLПродолжитьШагСОшибкой(ОписаниеОшибки());
+		Возврат;
+	КонецПопытки;
+	ITLОжидатьРезультатКоманды(ИмяОбработчика);
+КонецПроцедуры
