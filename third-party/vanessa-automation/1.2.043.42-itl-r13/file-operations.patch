+		Возврат Ложь;
+	КонецПопытки;
+	ТекстШага = Ванесса.МногострочнаяСтрокаИзПараметраШага(ТабПарам);
+	// The consumer returns its local Результат. The plain steps return nothing, so a
+	// scenario variable with that name never has to become a JSON value.
+	ТекстКода = ТекстШага + Символы.ПС + "Результат = Неопределено;";
+	ITLОбеспечитьМониторКаналаАгента(КорневойКаталог, КлючКлиента);
