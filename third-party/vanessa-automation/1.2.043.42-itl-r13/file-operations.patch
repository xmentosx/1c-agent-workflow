+// Returns "file:line:column U+XXXX" for the first character that XML 1.0 forbids, or "".
+Функция ITLНедопустимыйСимволXMLВФиче(ИмяФайла, Текст)
+	Позиция = 0;
+	КодСимволаОшибки = 0;
+	Коды = Новый Массив;
+	Для Код = 1 По 31 Цикл
+		Если Код <> 9 И Код <> 10 И Код <> 13 Тогда
+			Коды.Добавить(Код);
+		КонецЕсли;
+	КонецЦикла;
+	Коды.Добавить(65534);
+	Коды.Добавить(65535);
+	Для Каждого Код Из Коды Цикл
+		ИскомыйСимвол = Символ(Код);
+		Если СтрДлина(ИскомыйСимвол) <> 1 Тогда
+			Продолжить;
+		КонецЕсли;
+		Найдено = СтрНайти(Текст, ИскомыйСимвол);
+		Если Найдено > 0 И (Позиция = 0 Или Найдено < Позиция) Тогда
+			Позиция = Найдено;
+			КодСимволаОшибки = Код;
+		КонецЕсли;
+	КонецЦикла;
+	Если Позиция = 0 Тогда
+		Возврат "";
+	КонецЕсли;
+	Начало = Лев(Текст, Позиция - 1);
+	НомерСтроки = СтрЧислоВхождений(Начало, Символы.ПС) + 1;
+	Колонка = Позиция - СтрНайти(Начало, Символы.ПС, НаправлениеПоиска.СКонца);
+	Шестнадцатеричный = "";
+	Остаток = КодСимволаОшибки;
+	Для Сч = 1 По 4 Цикл
+		Шестнадцатеричный = Сред("0123456789ABCDEF", Остаток % 16 + 1, 1) + Шестнадцатеричный;
+		Остаток = Цел(Остаток / 16);
+	КонецЦикла;
+	Возврат ИмяФайла + ":" + Формат(НомерСтроки, "ЧГ=0") + ":" + Формат(Колонка, "ЧГ=0") + " U+" + Шестнадцатеричный;
+КонецФункции
