+&НаКлиенте
+// Reads the current row until it stays unchanged for a full settle window. Returns ""
+// for a settled row that matches every criterion, otherwise the actual row.
+Функция ITLОшибкаТекущейСтрокиПослеПерехода(Таблица, ИмяТаблицы, Колонки, Значения, ПоляПоЗаголовку)
+	ИнтервалСекунд = 0.25;
+	ЧтенийДляУстойчивости = 4;
+	МаксимумЧтений = 24;
+	Предыдущее = Неопределено;
+	ОдинаковыхЧтений = 0;
+	Для НомерЧтения = 1 По МаксимумЧтений Цикл
+		Ванесса.Sleep(ИнтервалСекунд);
+		Представление = "";
+		Совпадает = Истина;
+		Для Каждого КлючЗначения Из Колонки Цикл
+			Заголовок = КлючЗначения.Значение;
+			Поле = ПоляПоЗаголовку[НРег(Заголовок)];
+			Попытка
+				ТекстЯчейки = Таблица.ПолучитьТекстЯчейки(Поле.Имя);
+			Исключение
+				ТекстЯчейки = Неопределено;
+			КонецПопытки;
+			Если ТипЗнч(ТекстЯчейки) <> Тип("Строка") Тогда
+				Совпадает = Ложь;
+				ТекстЯчейки = "<" + Ванесса.Локализовать("нет текущей строки") + ">";
+			ИначеЕсли ITLНормализоватьТекстЯчейки(ТекстЯчейки) <> ITLНормализоватьТекстЯчейки(Значения[КлючЗначения.Ключ]) Тогда
+				Совпадает = Ложь;
+			КонецЕсли;
+			Представление = Представление + ?(Представление = "", "", ";") + Заголовок + "=" + ТекстЯчейки;
+		КонецЦикла;
+		Если Представление = Предыдущее Тогда
+			ОдинаковыхЧтений = ОдинаковыхЧтений + 1;
+		Иначе
+			ОдинаковыхЧтений = 1;
+			Предыдущее = Представление;
+		КонецЕсли;
+		Если ОдинаковыхЧтений >= ЧтенийДляУстойчивости Тогда
+			Если Совпадает Тогда
+				Возврат "";
+			КонецЕсли;
+			Возврат "ITL_ROW_NAVIGATION_NOT_CONFIRMED: " + Ванесса.ПодставитьПараметрыВСтроку(
+				Ванесса.Локализовать("В таблице '%1' после перехода и завершения обработчиков текущей стала другая строка: %2"),
+				ИмяТаблицы, Представление);
+		КонецЕсли;
+	КонецЦикла;
+	Возврат "ITL_ROW_NAVIGATION_NOT_CONFIRMED: " + Ванесса.ПодставитьПараметрыВСтроку(
+		Ванесса.Локализовать("В таблице '%1' текущая строка не перестала меняться после перехода; последняя прочитанная строка: %2"),
+		ИмяТаблицы, Предыдущее);
+КонецФункции
+
+&НаКлиенте
+Функция ITLНормализоватьТекстЯчейки(Знач Текст)
+	// Criteria may encode a line break as \n, which the row navigation also accepts.
+	Текст = СтрЗаменить(Строка(Текст), "\n", " ");
+	Текст = СтрЗаменить(Текст, Символы.НПП, " ");
+	Текст = СтрЗаменить(Текст, Символы.ВК, " ");
+	Текст = СтрЗаменить(Текст, Символы.ПС, " ");
+	Текст = СтрЗаменить(Текст, Символы.Таб, " ");
+	Пока СтрНайти(Текст, "  ") > 0 Цикл
+		Текст = СтрЗаменить(Текст, "  ", " ");
+	КонецЦикла;
+	Возврат НРег(СокрЛП(Текст));
+КонецФункции
