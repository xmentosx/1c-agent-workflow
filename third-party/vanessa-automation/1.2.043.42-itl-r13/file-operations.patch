 КонецФункции // ПолучитьЗанятыеПорты()
 
+&НаКлиенте
+// ITL: a port is occupied only by a listening TCP socket. A netstat -ano row of a
+// listening socket has the unspecified foreign address 0.0.0.0:0 or [::]:0 in any
+// system language; TIME_WAIT, ESTABLISHED and CLOSE_WAIT rows name a real peer.
+Функция ITLПортСлушающегоTCPСокетаWindows(Знач Стр)
+	Поля = ITLПоляСтрокиСокета(Стр, 3);
+	Если Поля.Количество() < 3 Или ВРег(Поля[0]) <> "TCP" Тогда
+		Возврат Неопределено;
+	КонецЕсли;
+	Если Поля[2] <> "0.0.0.0:0" И Поля[2] <> "[::]:0" Тогда
+		Возврат Неопределено;
+	КонецЕсли;
+	Возврат ITLПортАдресаСокета(Поля[1]);
+КонецФункции
+
+&НаКлиенте
+// ITL: an ss -ltn row is State, Recv-Q, Send-Q, Local and Peer; the header is skipped.
+Функция ITLПортСлушающегоTCPСокетаLinux(Знач Стр)
+	Поля = ITLПоляСтрокиСокета(Стр, 4);
+	Если Поля.Количество() < 4 Или ВРег(Поля[0]) <> "LISTEN" Тогда
+		Возврат Неопределено;
+	КонецЕсли;
+	Возврат ITLПортАдресаСокета(Поля[3]);
+КонецФункции
+
+&НаКлиенте
+Функция ITLПоляСтрокиСокета(Знач Стр, КоличествоПолей)
+	Поля = Новый Массив;
+	Остаток = СокрЛП(СтрЗаменить(Стр, Символы.Таб, " "));
+	Пока Остаток <> "" И Поля.Количество() < КоличествоПолей Цикл
+		Позиция = Найти(Остаток, " ");
+		Если Позиция = 0 Тогда
+			Поля.Добавить(Остаток);
+			Прервать;
+		КонецЕсли;
+		Поля.Добавить(Лев(Остаток, Позиция - 1));
+		Остаток = СокрЛ(Сред(Остаток, Позиция + 1));
+	КонецЦикла;
+	Возврат Поля;
+КонецФункции
+
+&НаКлиенте
+// ITL: the port follows the last colon of host:port, [ipv6]:port or *:port.
+Функция ITLПортАдресаСокета(Знач Адрес)
+	Позиция = СтрДлина(Адрес);
+	Пока Позиция > 0 И Сред(Адрес, Позиция, 1) <> ":" Цикл
+		Позиция = Позиция - 1;
+	КонецЦикла;
+	Если Позиция = 0 Тогда
+		Возврат Неопределено;
+	КонецЕсли;
+	ТекстПорта = Сред(Адрес, Позиция + 1);
+	Если ТекстПорта = "" Или СтрДлина(ТекстПорта) > 5 Тогда
+		Возврат Неопределено;
+	КонецЕсли;
+	Для Номер = 1 По СтрДлина(ТекстПорта) Цикл
+		Если Найти("0123456789", Сред(ТекстПорта, Номер, 1)) = 0 Тогда
+			Возврат Неопределено;
+		КонецЕсли;
+	КонецЦикла;
+	Возврат Число(ТекстПорта);
+КонецФункции
+
