+// A healthy monitor claims a request within its one-second poll. An unclaimed
+// request means the TestClient process (and its monitor) was replaced: the monitor
+// is started once more for the same request. A request still unclaimed after that
+// is withdrawn with the consumer's own exclusive claim, so it can never run later.
+Процедура ITLПроверитьЗахватКодаШагаАгента()
+	Если НЕ КонтекстСохраняемый.Свойство("_ITLКодШагаАгента")
+		Или НЕ КонтекстСохраняемый.Свойство("_ITLОжиданиеКоманды")
+		Или КонтекстСохраняемый._ITLОжиданиеКоманды = Неопределено Тогда
+		Возврат;
+	КонецЕсли;
+	Шаг = КонтекстСохраняемый._ITLКодШагаАгента;
+	ИмяСобытия = КонтекстСохраняемый._ITLОжиданиеКоманды.request;
+	Если Ванесса.ФайлСуществуетКомандаСистемы(ITLИмяФайлаЗапроса(ИмяСобытия, "Claim"))
+		Или Ванесса.ФайлСуществуетКомандаСистемы(ITLИмяФайлаЗапроса(ИмяСобытия, "Result")) Тогда
+		Возврат;
+	КонецЕсли;
+	ПорогЗахвата = 60;
+	Если Шаг.restarted = '00010101' Тогда
+		Если ТекущаяДата() - Шаг.started < ПорогЗахвата Тогда Возврат; КонецЕсли;
+		Шаг.restarted = ТекущаяДата();
+		Ванесса.ЗаписатьЛогВЖРИнформация("ITLМониторКаналаАгента", "ITL_CLIENT_CODE_MONITOR_RESTARTED: " + ИмяСобытия);
+		Если КонтекстСохраняемый.Свойство("_СписокPIDКлиентовСМониторингомСобытий") Тогда
+			КонтекстСохраняемый._СписокPIDКлиентовСМониторингомСобытий.Удалить(Шаг.owner);
+		КонецЕсли;
+		ITLОбеспечитьМониторКаналаАгента(Шаг.root, Шаг.owner);
+		// Channel preparation re-derives the pending request name from a directory listing;
+		// the same file keeps the exact name the wait was bound to.
+		Если КонтекстСохраняемый.Свойство("_ITLНеподтвержденнаяКоманда") Тогда
+			// The platform does not accept a property access on a Новый expression.
+			ВосстановленнаяКоманда = Новый Файл(КонтекстСохраняемый._ITLНеподтвержденнаяКоманда);
+			ОжидаемаяКоманда = Новый Файл(ИмяСобытия);
+			Если ВосстановленнаяКоманда.ПолноеИмя = ОжидаемаяКоманда.ПолноеИмя Тогда
+				КонтекстСохраняемый.Вставить("_ITLНеподтвержденнаяКоманда", ИмяСобытия);
+				КонтекстСохраняемый.Вставить("_ИмяФайлаПоследнегоСобытия", ИмяСобытия);
+			КонецЕсли;
+		КонецЕсли;
+		Возврат;
+	КонецЕсли;
+	Если ТекущаяДата() - Шаг.restarted < ПорогЗахвата Тогда Возврат; КонецЕсли;
+	Попытка
+		Захват = Новый ФайловыйПоток(ITLИмяФайлаЗапроса(ИмяСобытия, "Claim"), РежимОткрытияФайла.СоздатьНовый);
+		Захват.Закрыть();
+	Исключение
+		Возврат; // A consumer claimed it concurrently; its result is awaited as usual.
+	КонецПопытки;
+	ФайлСобытия = Новый Файл(ИмяСобытия);
+	ITLЗаписатьJSONАтомарно(ITLИмяФайлаЗапроса(ИмяСобытия, "Result"), Новый Структура("protocol,id,status,value,error",
+		"itl-file-code-v1", Сред(ФайлСобытия.Имя, 11, 36), "failed", Неопределено,
+		"ITL_CLIENT_CODE_NOT_DISPATCHED: no TestClient monitor claimed the request; it was withdrawn and never executed"));
+КонецПроцедуры
+
+&НаКлиенте
+Процедура ITLПродолжитьШагСОшибкой(ТекстОшибки)
+	Текст = ТекстОшибки;
+	Если КонтекстСохраняемый.Свойство("_ITLКодШагаАгента") Тогда
+		Текст = Ванесса.Локализовать("Не получилось выполнить код на стороне клиента тестирования.")
+			+ Символы.ПС + ТекстОшибки + Символы.ПС + КонтекстСохраняемый._ITLКодШагаАгента.code;
+		КонтекстСохраняемый.Удалить("_ITLКодШагаАгента");
+	КонецЕсли;
+	Ванесса.ПродолжитьВыполнениеШагов(Истина, Текст);
+КонецПроцедуры
+
+&НаКлиенте
+Функция ITLИмяФайлаЗапроса(ИмяСобытия, Вид)
+    ФайлСобытия = Новый Файл(ИмяСобытия);
+    Идентификатор = Сред(ФайлСобытия.Имя, 11, 36);
+    Возврат ФайлСобытия.Путь + Вид + "_ITL_" + Идентификатор + ".json";
+КонецФункции
+
+&НаКлиенте
+Функция ITLНормализоватьКаталог(Каталог)
+    ОбъектФайла = Новый Файл(Каталог);
+    Результат = ОбъектФайла.ПолноеИмя;
+    Пока Прав(Результат, 1) = "/" Или Прав(Результат, 1) = "\" Цикл
+        Результат = Лев(Результат, СтрДлина(Результат) - 1);
+    КонецЦикла;
+    Возврат Результат;
+КонецФункции
+
+&НаКлиенте
+Процедура ITLЗаписатьJSONАтомарно(ИмяФайла, Значение)
+    Если Ванесса.ФайлСуществуетКомандаСистемы(ИмяФайла) Тогда
+        ВызватьИсключение "ITL_CLIENT_CODE_STATE_ALREADY_EXISTS: " + ИмяФайла;
+    КонецЕсли;
+    ВременныйФайл = ИмяФайла + ".tmp";
+    Если Ванесса.ФайлСуществуетКомандаСистемы(ВременныйФайл) Тогда
+        Ванесса.УдалитьФайлыКомандаСистемы(ВременныйФайл);
+    КонецЕсли;
+    Запись = Новый ЗаписьJSON;
+    Запись.ОткрытьФайл(ВременныйФайл);
+    Попытка
+        ЗаписатьJSON(Запись, Значение);
+    Исключение
+        Запись.Закрыть();
+        ВызватьИсключение;
+    КонецПопытки;
+    Запись.Закрыть();
+    ПереместитьФайл(ВременныйФайл, ИмяФайла);
+КонецПроцедуры
+
+&НаКлиенте
+Функция ITLПрочитатьJSONФайл(ИмяФайла)
+    Чтение = Новый ЧтениеJSON;
+    Чтение.ОткрытьФайл(ИмяФайла);
+    Попытка
+        Значение = ПрочитатьJSON(Чтение);
+    Исключение
+        Чтение.Закрыть();
+        ВызватьИсключение;
+    КонецПопытки;
+    Чтение.Закрыть();
+    Возврат Значение;
+КонецФункции
+
+&НаКлиенте
+Функция ITLПрочитатьСостояниеЗапроса(ИмяСобытия, ОжидаемыйВладелец)
+    ИмяСостояния = ITLИмяФайлаЗапроса(ИмяСобытия, "Pending");
+    Если НЕ Ванесса.ФайлСуществуетКомандаСистемы(ИмяСостояния) Тогда
+        ВызватьИсключение "ITL_CLIENT_CODE_PENDING_STATE_MISSING: " + ИмяСобытия;
+    КонецЕсли;
+    Состояние = ITLПрочитатьJSONФайл(ИмяСостояния);
+    ФайлСобытия = Новый Файл(ИмяСобытия);
+    Идентификатор = Сред(ФайлСобытия.Имя, 11, 36);
+    Если НЕ Состояние.Свойство("protocol") Или Состояние.protocol <> "itl-file-code-request-v1"
+        Или НЕ Состояние.Свойство("id") Или Состояние.id <> Идентификатор
+        Или НЕ Состояние.Свойство("owner") Или Состояние.owner <> ОжидаемыйВладелец
+        Или НЕ Состояние.Свойство("target") Или НЕ Состояние.Свойство("code") Тогда
+        ВызватьИсключение "ITL_CLIENT_CODE_PENDING_STATE_INVALID: " + ИмяСостояния;
+    КонецЕсли;
+    Возврат Состояние;
+КонецФункции
+
+&НаКлиенте
+Процедура ITLПроверитьПовторКоманды(ИмяСобытия, Владелец, Цель, ТекстКода)
+    Состояние = ITLПрочитатьСостояниеЗапроса(ИмяСобытия, Владелец);
+    Если Состояние.target <> Цель Или Состояние.code <> ТекстКода Тогда
+        ВызватьИсключение "ITL_CLIENT_CODE_COMPLETION_UNKNOWN: " + ИмяСобытия;
+    КонецЕсли;
+КонецПроцедуры
+
+&НаКлиенте
+Функция ITLПодготовитьКаталогКанала(БазовыйКаталог, Владелец)
+    Ванесса.СоздатьКаталогКомандаСистемы(БазовыйКаталог);
+    Незавершенные = Новый Массив;
+    Для Каждого ФайлКанала Из НайтиФайлы(БазовыйКаталог, "Channel_ITL.json", Истина) Цикл
+        Попытка
+            Канал = ITLПрочитатьJSONФайл(ФайлКанала.ПолноеИмя);
+            Если НЕ Канал.Свойство("protocol") Или Канал.protocol <> "itl-file-code-channel-v1"
+                Или НЕ Канал.Свойство("owner") Тогда
+                ВызватьИсключение "ITL_CLIENT_CODE_CHANNEL_STATE_INVALID: " + ФайлКанала.ПолноеИмя;
+            КонецЕсли;
+        Исключение
+            ВызватьИсключение "ITL_CLIENT_CODE_CHANNEL_STATE_INVALID: " + ФайлКанала.ПолноеИмя;
+        КонецПопытки;
+        Если Канал.owner <> Владелец Тогда Продолжить; КонецЕсли;
+        КоличествоНезавершенныхДо = Незавершенные.Количество();
+        Для Каждого ФайлСостояния Из НайтиФайлы(ФайлКанала.Путь, "Pending_ITL_*.json") Цикл
+            Идентификатор = Сред(ФайлСостояния.Имя, 13, 36);
+            ИмяСобытия = ФайлКанала.Путь + "Event_ITL_" + Идентификатор + ".json";
+            Состояние = ITLПрочитатьСостояниеЗапроса(ИмяСобытия, Владелец);
+            Если НЕ Ванесса.ФайлСуществуетКомандаСистемы(ITLИмяФайлаЗапроса(ИмяСобытия, "Ack")) Тогда
+                Незавершенные.Добавить(Новый Структура("directory,request,state", ФайлКанала.Путь, ИмяСобытия, Состояние));
+            Иначе
+                ITLПроверитьПодтверждениеРезультата(ИмяСобытия, Владелец);
+            КонецЕсли;
+        КонецЦикла;
+        Если Незавершенные.Количество() = КоличествоНезавершенныхДо Тогда
+            ITLОчиститьЗавершенныйКаталогКанала(ФайлКанала.Путь, Владелец);
+        КонецЕсли;
+    КонецЦикла;
+    Если Незавершенные.Количество() > 1 Тогда
+        ВызватьИсключение "ITL_CLIENT_CODE_RESTART_AMBIGUOUS";
+    КонецЕсли;
+    Если Незавершенные.Количество() = 1 Тогда
+        Незавершенная = Незавершенные[0];
+        ИмяЗахвата = ITLИмяФайлаЗапроса(Незавершенная.request, "Claim");
+        ИмяРезультата = ITLИмяФайлаЗапроса(Незавершенная.request, "Result");
+        Если НЕ Ванесса.ФайлСуществуетКомандаСистемы(Незавершенная.request)
+            И НЕ Ванесса.ФайлСуществуетКомандаСистемы(ИмяЗахвата)
+            И НЕ Ванесса.ФайлСуществуетКомандаСистемы(ИмяРезультата) Тогда
+            Запрос = Новый Структура("protocol,id,target,code", "itl-file-code-v1", Незавершенная.state.id, Незавершенная.state.target, Незавершенная.state.code);
+            ITLЗаписатьJSONАтомарно(Незавершенная.request, Запрос);
+        КонецЕсли;
+        КонтекстСохраняемый.Вставить("_ITLВладелецНеподтвержденнойКоманды", Владелец);
+        КонтекстСохраняемый.Вставить("_ITLВладелецПоследнейКоманды", Владелец);
+        КонтекстСохраняемый.Вставить("_ITLНеподтвержденнаяКоманда", Незавершенная.request);
+        КонтекстСохраняемый.Вставить("_ИмяФайлаПоследнегоСобытия", Незавершенная.request);
+        Возврат ITLНормализоватьКаталог(Незавершенная.directory);
+    КонецЕсли;
+    Каталог = БазовыйКаталог + ПолучитьРазделительПути() + "itl-" + Строка(Новый УникальныйИдентификатор) + ПолучитьРазделительПути() + "events";
+    Ванесса.СоздатьКаталогКомандаСистемы(Каталог);
+    ITLЗаписатьJSONАтомарно(Каталог + ПолучитьРазделительПути() + "Channel_ITL.json",
+        Новый Структура("protocol,owner", "itl-file-code-channel-v1", Владелец));
+    Возврат ITLНормализоватьКаталог(Каталог);
+КонецФункции
+
+&НаКлиенте
+Процедура ITLИнициализироватьПоследнееСобытиеКанала()
+    // Новый канал еще не отправлял событий. При восстановлении producer уже
+    // записал сюда durable request, и мониторинг не должен его забывать.
+    Если НЕ КонтекстСохраняемый.Свойство("_ITLНеподтвержденнаяКоманда") Тогда
+        КонтекстСохраняемый.Вставить("_ИмяФайлаПоследнегоСобытия", "");
+    КонецЕсли;
+КонецПроцедуры
+
+&НаКлиенте
+Функция ITLПроверитьПодтверждениеРезультата(ИмяСобытия, Владелец)
+    Состояние = ITLПрочитатьСостояниеЗапроса(ИмяСобытия, Владелец);
+    ИмяПодтверждения = ITLИмяФайлаЗапроса(ИмяСобытия, "Ack");
+    Если НЕ Ванесса.ФайлСуществуетКомандаСистемы(ИмяПодтверждения) Тогда Возврат Ложь; КонецЕсли;
+    Подтверждение = ITLПрочитатьJSONФайл(ИмяПодтверждения);
+    Если НЕ Подтверждение.Свойство("protocol") Или Подтверждение.protocol <> "itl-file-code-ack-v1"
+        Или НЕ Подтверждение.Свойство("id") Или Подтверждение.id <> Состояние.id
+        Или НЕ Подтверждение.Свойство("owner") Или Подтверждение.owner <> Владелец Тогда
+        ВызватьИсключение "ITL_CLIENT_CODE_ACK_STATE_INVALID: " + ИмяПодтверждения;
+    КонецЕсли;
+    Возврат Истина;
+КонецФункции
+
+&НаКлиенте
+Функция ITLКаталогКаналаЗавершен(Каталог, Владелец)
+    ИмяКанала = Каталог + ПолучитьРазделительПути() + "Channel_ITL.json";
+    Если НЕ Ванесса.ФайлСуществуетКомандаСистемы(ИмяКанала) Тогда Возврат Ложь; КонецЕсли;
+    Канал = ITLПрочитатьJSONФайл(ИмяКанала);
+    Если НЕ Канал.Свойство("protocol") Или Канал.protocol <> "itl-file-code-channel-v1"
+        Или НЕ Канал.Свойство("owner") Или Канал.owner <> Владелец Тогда
+        ВызватьИсключение "ITL_CLIENT_CODE_CHANNEL_STATE_INVALID: " + ИмяКанала;
+    КонецЕсли;
+    Для Каждого ФайлСостояния Из НайтиФайлы(Каталог, "Pending_ITL_*.json") Цикл
+        Идентификатор = Сред(ФайлСостояния.Имя, 13, 36);
+        ИмяСобытия = Каталог + ПолучитьРазделительПути() + "Event_ITL_" + Идентификатор + ".json";
+        Если НЕ ITLПроверитьПодтверждениеРезультата(ИмяСобытия, Владелец) Тогда Возврат Ложь; КонецЕсли;
+    КонецЦикла;
+    Возврат Истина;
+КонецФункции
+
+&НаКлиенте
+Функция ITLОчиститьЗавершенныйКаталогКанала(Каталог, Владелец)
+    Если НЕ ITLКаталогКаналаЗавершен(Каталог, Владелец) Тогда Возврат Ложь; КонецЕсли;
+    Ванесса.УдалитьКаталогКомандаСистемы(Каталог);
+    Если Ванесса.ФайлСуществуетКомандаСистемы(Каталог) Тогда
+        ВызватьИсключение "ITL_CLIENT_CODE_CHANNEL_CLEANUP_FAILED: " + Каталог;
+    КонецЕсли;
+    ФайлКаталога = Новый Файл(Каталог);
+    КаталогПоколения = ФайлКаталога.Путь;
+    ФайлПоколения = Новый Файл(КаталогПоколения);
+    ФайлыПоколения = НайтиФайлы(КаталогПоколения, "*", Ложь);
+    Если Лев(ФайлПоколения.Имя, 4) = "itl-"
+        И СтрДлина(ФайлПоколения.Имя) = 40
+        И ФайлыПоколения.Количество() = 0 Тогда
+        Ванесса.УдалитьКаталогКомандаСистемы(КаталогПоколения);
+        Если Ванесса.ФайлСуществуетКомандаСистемы(КаталогПоколения) Тогда
+            ВызватьИсключение "ITL_CLIENT_CODE_CHANNEL_CLEANUP_FAILED: " + КаталогПоколения;
+        КонецЕсли;
+    КонецЕсли;
+    Возврат Истина;
+КонецФункции
+
+&НаКлиенте
+Процедура ITLПодтвердитьПолучениеРезультата(ИмяСобытия, Владелец)
+    ИмяПодтверждения = ITLИмяФайлаЗапроса(ИмяСобытия, "Ack");
+    Если Ванесса.ФайлСуществуетКомандаСистемы(ИмяПодтверждения) Тогда
+        ITLПроверитьПодтверждениеРезультата(ИмяСобытия, Владелец);
+        Возврат;
+    КонецЕсли;
+    Состояние = ITLПрочитатьСостояниеЗапроса(ИмяСобытия, Владелец);
+    ITLЗаписатьJSONАтомарно(ИмяПодтверждения,
+        Новый Структура("protocol,id,owner", "itl-file-code-ack-v1", Состояние.id, Владелец));
+КонецПроцедуры
+
+&НаКлиенте
+Функция ITLКлючКлиентаМониторинга()
+    ДанныеКлиента = Ванесса.ТекущиеДанныеКлиентаТестирования();
+    Если ДанныеКлиента = Неопределено Тогда ВызватьИсключение "ITL_CLIENT_CODE_CLIENT_NOT_SELECTED"; КонецЕсли;
+    Если НЕ ЗначениеЗаполнено(ДанныеКлиента.ИмяКомпьютера) Или ДанныеКлиента.ПортЗапускаТестКлиента <= 0
+        Или НЕ ЗначениеЗаполнено(ДанныеКлиента.ПутьКИнфобазе) Тогда
+        ВызватьИсключение "ITL_CLIENT_CODE_CONNECTION_IDENTITY_MISSING";
+    КонецЕсли;
+    // PID may be zero or become known after connection. The selected endpoint stays stable.
+    Части = Новый Массив;
+    Части.Добавить(НРег(СокрЛП(ДанныеКлиента.ИмяКомпьютера)));
+    Части.Добавить(ДанныеКлиента.ПортЗапускаТестКлиента);
+    Части.Добавить(ДанныеКлиента.ПутьКИнфобазе);
+    Запись = Новый ЗаписьJSON;
+    Запись.УстановитьСтроку();
+    ЗаписатьJSON(Запись, Части);
+    Возврат Запись.Закрыть();
+КонецФункции
+
+&НаКлиенте
+Функция ITLКомандаДляОжидания()
+    КлючКлиента = ITLКлючКлиентаМониторинга();
+    Если КонтекстСохраняемый.Свойство("_ITLНеподтвержденнаяКоманда") Тогда
+        Если КонтекстСохраняемый._ITLВладелецНеподтвержденнойКоманды <> КлючКлиента Тогда
+            ВызватьИсключение "ITL_CLIENT_CODE_PENDING_BELONGS_TO_ANOTHER_CLIENT";
+        КонецЕсли;
+        Возврат Новый Структура("request,owner", КонтекстСохраняемый._ITLНеподтвержденнаяКоманда, КлючКлиента);
+    КонецЕсли;
+    Если КонтекстСохраняемый.Свойство("_ITLВладелецПоследнейКоманды") Тогда
+        Если КонтекстСохраняемый._ITLВладелецПоследнейКоманды = КлючКлиента Тогда
+            ФайлСобытия = Новый Файл(КонтекстСохраняемый._ИмяФайлаПоследнегоСобытия);
+            Если Лев(ФайлСобытия.Имя, 10) = "Event_ITL_" Тогда
+                Возврат Новый Структура("request,owner", КонтекстСохраняемый._ИмяФайлаПоследнегоСобытия, КлючКлиента);
+            КонецЕсли;
+        Иначе
+            ВызватьИсключение "ITL_CLIENT_CODE_RESULT_BELONGS_TO_ANOTHER_CLIENT";
+        КонецЕсли;
+    КонецЕсли;
+    Возврат Неопределено;
+КонецФункции
+
+&НаКлиенте
+Функция ITLПрочитатьРезультатКоманды(ИмяСобытия)
+    ФайлСобытия = Новый Файл(ИмяСобытия);
+    Идентификатор = Сред(ФайлСобытия.Имя, 11, 36);
+    ИмяРезультата = ФайлСобытия.Путь + "Result_ITL_" + Идентификатор + ".json";
+    Если НЕ Ванесса.ФайлСуществуетКомандаСистемы(ИмяРезультата) Тогда Возврат Неопределено; КонецЕсли;
+    Чтение = Новый ЧтениеJSON;
+    Чтение.ОткрытьФайл(ИмяРезультата);
+    Попытка
+        Ответ = ПрочитатьJSON(Чтение);
+    Исключение
+        Чтение.Закрыть();
+        ВызватьИсключение;
+    КонецПопытки;
+    Чтение.Закрыть();
+    Если Ответ.protocol <> "itl-file-code-v1" Или Ответ.id <> Идентификатор Тогда
+        ВызватьИсключение "ITL_CLIENT_CODE_RESPONSE_IDENTITY_MISMATCH";
+    КонецЕсли;
+    Если Ответ.status <> "succeeded" И Ответ.status <> "failed" Тогда
+        ВызватьИсключение "ITL_CLIENT_CODE_RESPONSE_STATUS_INVALID";
+    КонецЕсли;
+    Возврат Ответ;
+КонецФункции
+
+&НаКлиенте
+Функция ITLОжидатьРезультатКоманды(ИмяОбработчика)
+    Попытка
+        Если КонтекстСохраняемый.Свойство("_ITLОжиданиеКоманды") Тогда
+            КомандаОжидания = КонтекстСохраняемый._ITLОжиданиеКоманды;
+        Иначе
+            КомандаОжидания = ITLКомандаДляОжидания();
+        КонецЕсли;
+        Если КомандаОжидания = Неопределено Тогда ВызватьИсключение "ITL_CLIENT_CODE_REQUEST_NOT_SENT"; КонецЕсли;
+        ИмяСобытия = КомандаОжидания.request;
+        Ответ = ITLПрочитатьРезультатКоманды(ИмяСобытия);
+    Исключение
+        ОтключитьОбработчикОжидания(ИмяОбработчика);
+        ITLПродолжитьШагСОшибкой(ОписаниеОшибки());
+        Возврат Неопределено;
+    КонецПопытки;
+    Если Ответ <> Неопределено Тогда
+        ОтключитьОбработчикОжидания(ИмяОбработчика);
+        Если КонтекстСохраняемый.Свойство("_ITLНеподтвержденнаяКоманда") Тогда
+            Если КонтекстСохраняемый._ITLНеподтвержденнаяКоманда <> ИмяСобытия Или КонтекстСохраняемый._ITLВладелецНеподтвержденнойКоманды <> КомандаОжидания.owner Тогда
+                ITLПродолжитьШагСОшибкой("ITL_CLIENT_CODE_WAIT_OWNERSHIP_CHANGED");
+                Возврат Неопределено;
+            КонецЕсли;
+            КонтекстСохраняемый.Удалить("_ITLНеподтвержденнаяКоманда");
+            КонтекстСохраняемый.Удалить("_ITLВладелецНеподтвержденнойКоманды");
+        КонецЕсли;
+        КонтекстСохраняемый.Удалить("_ITLОжиданиеКоманды");
+        Если Ответ.status = "failed" Тогда
+            ITLПродолжитьШагСОшибкой("ITL_CLIENT_CODE_EXECUTION_FAILED: " + Ответ.error);
+        Иначе
+            // The agent route of the plain code step stores no variable.
+            Если ЗначениеЗаполнено(КонтекстСохраняемый._ИмяПеременнойРезультатаСобытия) Тогда
+                Ванесса.СохранитьЗначениеПеременнойВКонтекст(КонтекстСохраняемый._ИмяПеременнойРезультатаСобытия, Ответ.value);
+            КонецЕсли;
+            КонтекстСохраняемый.Удалить("_ITLКодШагаАгента");
+            Ванесса.ПродолжитьВыполнениеШагов();
+        КонецЕсли;
+        ITLПодтвердитьПолучениеРезультата(ИмяСобытия, КомандаОжидания.owner);
+        Возврат Неопределено;
+    КонецЕсли;
+    Если (ТекущаяДата() - ДатаНачалаОбработкиОжидания) > КоличествоСекундОбработкаОжидания Тогда
+        ОтключитьОбработчикОжидания(ИмяОбработчика);
+        ITLПродолжитьШагСОшибкой("ITL_CLIENT_CODE_COMPLETION_UNKNOWN: " + ИмяСобытия);
+    КонецЕсли;
+КонецФункции
 
