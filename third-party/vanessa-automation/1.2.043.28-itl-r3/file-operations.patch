+Процедура MCPНачатьПроверкуПути(
+		ПутьКФайлу, Запрос, ТипВызова, ДопПараметрыВызоваMCP = Неопределено)
+
+	Ванесса.УстановитьИдентификаторЗадачиMCP(Запрос.Идентификатор);
+	ПодготовкаПути = MCPПодготовитьПутьКФичам(ПутьКФайлу);
+	Если ПодготовкаПути.Статус <> "OK" Тогда
+		ДанныеОшибки = Новый Структура("Запрос,ПолныйПуть", Запрос, Строка(ПутьКФайлу));
+		MCPЗавершитьПроверкуПутиСОшибкой(ДанныеОшибки, ПодготовкаПути.Статус);
+		Возврат;
+	КонецЕсли;
+
+	РазрешитьКаталог = ТипВызова = "ОткрытьЗагрузитьИлиПерезагрузитьФичаФайл";
+	ЭтоКаталог = РазрешитьКаталог И НРег(Прав(ПодготовкаПути.ПолныйПуть, 8)) <> ".feature";
+	ДанныеПроверки = Новый Структура(
+		"Запрос,ТипВызова,ДопПараметрыВызоваMCP,ПолныйПуть,РазрешитьКаталог,ЭтоКаталог,Стадия,ТекстовыйДокумент,НайденныйФайл",
+		Запрос, ТипВызова, ДопПараметрыВызоваMCP, ПодготовкаПути.ПолныйПуть,
+		РазрешитьКаталог, ЭтоКаталог, "SEARCH", Неопределено, Неопределено);
+
+	ОписаниеОповещения = Новый ОписаниеОповещения(
+		"MCPПроверкаПутиЗавершена", ЭтаФорма, ДанныеПроверки,
+		"MCPОшибкаПроверкиПути", ЭтаФорма);
+
+	Если ЭтоКаталог Тогда
+		НачатьПоискФайлов(
+			ОписаниеОповещения, ДанныеПроверки.ПолныйПуть, "*.feature", Ложь);
+		Возврат;
+	КонецЕсли;
+
+	ПозицияРазделителя = СтрДлина(ДанныеПроверки.ПолныйПуть);
+	Пока ПозицияРазделителя > 0 Цикл
+		ТекущийСимвол = Сред(ДанныеПроверки.ПолныйПуть, ПозицияРазделителя, 1);
+		Если ТекущийСимвол = "/" Или ТекущийСимвол = "\" Тогда
+			Прервать;
+		КонецЕсли;
+		ПозицияРазделителя = ПозицияРазделителя - 1;
+	КонецЦикла;
+
+	Если ПозицияРазделителя = 0 Тогда
+		КаталогПоиска = ".";
+		МаскаПоиска = ДанныеПроверки.ПолныйПуть;
+	Иначе
+		КаталогПоиска = Лев(ДанныеПроверки.ПолныйПуть, ПозицияРазделителя);
+		МаскаПоиска = Сред(ДанныеПроверки.ПолныйПуть, ПозицияРазделителя + 1);
+	КонецЕсли;
+
+	НачатьПоискФайлов(ОписаниеОповещения, КаталогПоиска, МаскаПоиска, Ложь);
+
+КонецПроцедуры
