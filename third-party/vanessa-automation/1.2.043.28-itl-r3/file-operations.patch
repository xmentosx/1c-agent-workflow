+&НаКлиенте
+Процедура MCPЗавершитьПроверкуПутиСОшибкой(ДанныеПроверки, Статус)
+
+	Если Статус = "PATH_NOT_FOUND" Тогда
+		ТекстОшибки = Ванесса.Локализовать("Файл или каталог не найден:")
+			+ " " + ДанныеПроверки.ПолныйПуть;
+	ИначеЕсли Статус = "PATH_ACCESS_DENIED" Тогда
+		ТекстОшибки = Ванесса.Локализовать("Нет доступа к файлу или каталогу:")
+			+ " " + ДанныеПроверки.ПолныйПуть;
+	Иначе
+		ТекстОшибки = Ванесса.Локализовать("Некорректный путь к файлу или каталогу:")
+			+ " " + ДанныеПроверки.ПолныйПуть;
+	КонецЕсли;
+
+	МодульМсп_Сервер().ЗавершитьВызовИнструментаСОшибкой(
+		ДанныеПроверки.Запрос.Идентификатор, Статус, ТекстОшибки);
+
