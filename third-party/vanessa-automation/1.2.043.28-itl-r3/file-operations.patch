+Процедура MCPПроверкаТипаПутиЗавершена(ЭтоКаталог, ДанныеПроверки) Экспорт
+
+	Если ЭтоКаталог Тогда
+		Если ДанныеПроверки.РазрешитьКаталог Тогда
+			ДанныеПроверки.ЭтоКаталог = Истина;
+			MCPПродолжитьОткрытиеФичаФайла(ДанныеПроверки);
+			Возврат;
+		КонецЕсли;
+		MCPЗавершитьПроверкуПутиСОшибкой(ДанныеПроверки, "PATH_INVALID");
+		Возврат;
+	КонецЕсли;
+
+	ДанныеПроверки.Стадия = "READ";
+	ТекстовыйДокумент = Новый ТекстовыйДокумент;
+	ДанныеПроверки.ТекстовыйДокумент = ТекстовыйДокумент;
+	ОписаниеОповещения = Новый ОписаниеОповещения(
+		"MCPПроверкаЧтенияФайлаЗавершена", ЭтаФорма, ДанныеПроверки,
+		"MCPОшибкаПроверкиПути", ЭтаФорма);
+	ТекстовыйДокумент.НачатьЧтение(
+		ОписаниеОповещения, ДанныеПроверки.ПолныйПуть, КодировкаТекста.UTF8);
+
+КонецПроцедуры
+
+&НаКлиенте
+Процедура MCPПроверкаПутиЗавершена(НайденныеФайлы, ДанныеПроверки) Экспорт
+
+	Если ДанныеПроверки.ЭтоКаталог Тогда
+		MCPПродолжитьОткрытиеФичаФайла(ДанныеПроверки);
+		Возврат;
+	КонецЕсли;
+
+	Если НайденныеФайлы.Количество() = 0 Тогда
+		MCPЗавершитьПроверкуПутиСОшибкой(ДанныеПроверки, "PATH_NOT_FOUND");
+		Возврат;
+	КонецЕсли;
+
+	ДанныеПроверки.ПолныйПуть = НайденныеФайлы[0].ПолноеИмя;
+	ДанныеПроверки.Стадия = "TYPE";
+	ДанныеПроверки.НайденныйФайл = НайденныеФайлы[0];
+	ОписаниеОповещения = Новый ОписаниеОповещения(
+		"MCPПроверкаТипаПутиЗавершена", ЭтаФорма, ДанныеПроверки,
+		"MCPОшибкаПроверкиПути", ЭтаФорма);
+	ДанныеПроверки.НайденныйФайл.НачатьПроверкуЭтоКаталог(ОписаниеОповещения);
+
+КонецПроцедуры
