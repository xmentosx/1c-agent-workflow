+&НаКлиенте
+Процедура MCPОшибкаПроверкиПути(
+		ИнформацияОбОшибке, СтандартнаяОбработка, ДанныеПроверки) Экспорт
+
+	СтандартнаяОбработка = Ложь;
+	Если ДанныеПроверки.Стадия <> "SEARCH" Тогда
+		Статус = "PATH_ACCESS_DENIED";
+	Иначе
+		ТекстОшибки = НРег(КраткоеПредставлениеОшибки(ИнформацияОбОшибке));
+		Если Найти(ТекстОшибки, "доступ") > 0
+			Или Найти(ТекстОшибки, "access") > 0
+			Или Найти(ТекстОшибки, "denied") > 0 Тогда
+			Статус = "PATH_ACCESS_DENIED";
+		Иначе
+			Статус = "PATH_NOT_FOUND";
+		КонецЕсли;
+	КонецЕсли;
+
+	MCPЗавершитьПроверкуПутиСОшибкой(ДанныеПроверки, Статус);
