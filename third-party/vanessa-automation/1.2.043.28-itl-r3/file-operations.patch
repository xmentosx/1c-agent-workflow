+	Идентификатор = ДанныеПроверки.Запрос.Идентификатор;
+	Ванесса.УстановитьИдентификаторЗадачиMCP(Идентификатор);
+	МодульМсп_Сервер.УведомитьОПрогрессе(
+		Идентификатор, 0, 3, Ванесса.Локализовать("Загрузка feature файла."));
+
+	MCPOpenFeatureFileВРедакторе(
+		ДанныеПроверки.ПолныйПуть,
+		ДанныеПроверки.ТипВызова,
+		ДанныеПроверки.ДопПараметрыВызоваMCP);
+
+КонецПроцедуры
