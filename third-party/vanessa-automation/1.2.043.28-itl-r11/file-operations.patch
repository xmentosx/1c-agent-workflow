+// ITL file-code protocol: durable claim precedes execution; unknown completion is never replayed.
+Процедура VAExtension_ITLОбработатьФайлКода(ФайлСобытия)
+    Идентификатор = Сред(ФайлСобытия.Имя, 11, 36);
+    Если ФайлСобытия.Имя <> "Event_ITL_" + Идентификатор + ".json" Тогда
+        Возврат;
+    КонецЕсли;
+    Попытка
+        Если Строка(Новый УникальныйИдентификатор(Идентификатор)) <> Идентификатор Тогда Возврат; КонецЕсли;
+    Исключение
+        Возврат;
+    КонецПопытки;
+    Префикс = ФайлСобытия.Путь;
+    ФайлЗахвата = Префикс + "Claim_ITL_" + Идентификатор + ".json";
+    // CreateNew is an exclusive filesystem operation, including across competing consumers.
+    Попытка
+        Захват = Новый ФайловыйПоток(ФайлЗахвата, РежимОткрытияФайла.СоздатьНовый);
+        Захват.Закрыть();
+    Исключение
+        Возврат; // Existing or inaccessible claim does not authorize execution.
+    КонецПопытки;
+    Ответ = Новый Структура("protocol,id,status,value,error", "itl-file-code-v1", Идентификатор, "failed", Неопределено, "");
+    Попытка
+        Чтение = Новый ЧтениеJSON;
+        Чтение.ОткрытьФайл(ФайлСобытия.ПолноеИмя);
+        Попытка
+            Запрос = ПрочитатьJSON(Чтение);
+        Исключение
+            Чтение.Закрыть();
+            ВызватьИсключение;
+        КонецПопытки;
+        Чтение.Закрыть();
+        Если Запрос.protocol <> Ответ.protocol Или Запрос.id <> Идентификатор Тогда
+            ВызватьИсключение "ITL_CLIENT_CODE_REQUEST_IDENTITY_MISMATCH";
+        КонецЕсли;
+        Если ТипЗнч(Запрос.code) <> Тип("Строка") Тогда
+            ВызватьИсключение "ITL_CLIENT_CODE_INVALID_CODE";
+        КонецЕсли;
+        Результат = Неопределено;
+        Если Запрос.target = "client" Тогда
+            Выполнить(Запрос.code);
+        ИначеЕсли Запрос.target = "server" Или Запрос.target = "server-privileged" Тогда
+            Результат = VAExtensionОбщегоНазначенияВызовСервера.ВыполнитьКодСервер(Запрос.code, Запрос.target = "server-privileged");
+        Иначе
+            ВызватьИсключение "ITL_CLIENT_CODE_INVALID_TARGET";
+        КонецЕсли;
+        Ответ.value = Результат;
+        Ответ.status = "succeeded";
+    Исключение
+        Ответ.error = ОписаниеОшибки();
+    КонецПопытки;
+    // Publish only complete JSON. Retain the request and permanent claim as evidence.
+    ИмяРезультата = Префикс + "Result_ITL_" + Идентификатор + ".json";
+    ВременныйРезультат = ИмяРезультата + ".tmp";
+    Попытка
+        Запись = Новый ЗаписьJSON;
+        Запись.ОткрытьФайл(ВременныйРезультат);
+        Попытка
+            ЗаписатьJSON(Запись, Ответ);
+        Исключение
+            Запись.Закрыть();
+            ВызватьИсключение;
+        КонецПопытки;
+        Запись.Закрыть();
+        ПереместитьФайл(ВременныйРезультат, ИмяРезультата);
+    Исключение
+        // Keep the claim if response publication fails: the code may already have run.
+        Возврат;
+    КонецПопытки;
+КонецПроцедуры
