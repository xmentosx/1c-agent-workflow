+// Токен прогресса задаётся клиентом в _meta.progressToken; без него уведомления запрещены.
+&НаКлиенте
+Функция ПрогрессТокенИзЗапроса(Запрос) Экспорт
+	Токен = Неопределено;
+	Попытка
+		Контекст = Запрос.Контекст;
+	Исключение
+		Возврат Неопределено;
+	КонецПопытки;
+	Если ТипЗнч(Контекст) = Тип("Структура") Тогда
+		Контекст.Свойство("progressToken", Токен);
+	ИначеЕсли ТипЗнч(Контекст) = Тип("Соответствие") Тогда
+		Токен = Контекст.Получить("progressToken");
+	КонецЕсли;
+	Если Токен = Null Тогда
+		Токен = Неопределено;
+	КонецЕсли;
+	Возврат Токен;
+КонецФункции
