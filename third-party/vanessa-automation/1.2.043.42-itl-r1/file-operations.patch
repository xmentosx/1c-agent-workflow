+    Исключение
+        Возврат;
+    КонецПопытки;
+    Префикс = ФайлСобытия.Путь;
+    ФайлЗахвата = Префикс + "Claim_ITL_" + Идентификатор + ".json";
+    // CreateNew is an exclusive filesystem operation, including across competing consumers.
+    Попытка
+        Захват = Новый ФайловыйПоток(ФайлЗахвата, РежимОткрытияФайла.СоздатьНовый);
+        Захват.Закрыть();
+    Исключение
+        Возврат; // Existing or inaccessible claim does not authorize execution.
+    КонецПопытки;
+    Ответ = Новый Структура("protocol,id,status,value,error", "itl-file-code-v1", Идентификатор, "failed", Неопределено, "");
+    Попытка
+        Чтение = Новый ЧтениеJSON;
+        Чтение.ОткрытьФайл(ФайлСобытия.ПолноеИмя);
+        Попытка
+            Запрос = ПрочитатьJSON(Чтение);
+        Исключение
+            Чтение.Закрыть();
+            ВызватьИсключение;
+        КонецПопытки;
+        Чтение.Закрыть();
+        Если Запрос.protocol <> Ответ.protocol Или Запрос.id <> Идентификатор Тогда
+            ВызватьИсключение "ITL_CLIENT_CODE_REQUEST_IDENTITY_MISMATCH";
+        КонецЕсли;
+        Если ТипЗнч(Запрос.code) <> Тип("Строка") Тогда
+            ВызватьИсключение "ITL_CLIENT_CODE_INVALID_CODE";
+        КонецЕсли;
+        Результат = Неопределено;
