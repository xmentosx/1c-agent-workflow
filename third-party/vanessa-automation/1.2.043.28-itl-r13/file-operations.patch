+&НаКлиенте
+Функция ITLИмяФайлаЗапроса(ИмяСобытия, Вид)
+    ФайлСобытия = Новый Файл(ИмяСобытия);
+    Идентификатор = Сред(ФайлСобытия.Имя, 11, 36);
+    Возврат ФайлСобытия.Путь + Вид + "_ITL_" + Идентификатор + ".json";
+КонецФункции
+
+&НаКлиенте
+Функция ITLНормализоватьКаталог(Каталог)
+    ОбъектФайла = Новый Файл(Каталог);
+    Результат = ОбъектФайла.ПолноеИмя;
+    Пока Прав(Результат, 1) = "/" Или Прав(Результат, 1) = "\" Цикл
+        Результат = Лев(Результат, СтрДлина(Результат) - 1);
+    КонецЦикла;
+    Возврат Результат;
+КонецФункции
+
+&НаКлиенте
+Процедура ITLЗаписатьJSONАтомарно(ИмяФайла, Значение)
+    Если Ванесса.ФайлСуществуетКомандаСистемы(ИмяФайла) Тогда
+        ВызватьИсключение "ITL_CLIENT_CODE_STATE_ALREADY_EXISTS: " + ИмяФайла;
+    КонецЕсли;
+    ВременныйФайл = ИмяФайла + ".tmp";
+    Если Ванесса.ФайлСуществуетКомандаСистемы(ВременныйФайл) Тогда
+        Ванесса.УдалитьФайлыКомандаСистемы(ВременныйФайл);
+    КонецЕсли;
+    Запись = Новый ЗаписьJSON;
+    Запись.ОткрытьФайл(ВременныйФайл);
+    Попытка
+        ЗаписатьJSON(Запись, Значение);
+    Исключение
+        Запись.Закрыть();
+        ВызватьИсключение;
+    КонецПопытки;
+    Запись.Закрыть();
+    ПереместитьФайл(ВременныйФайл, ИмяФайла);
+КонецПроцедуры
+
+&НаКлиенте
+Функция ITLПрочитатьJSONФайл(ИмяФайла)
+    Чтение = Новый ЧтениеJSON;
+    Чтение.ОткрытьФайл(ИмяФайла);
+    Попытка
+        Значение = ПрочитатьJSON(Чтение);
+    Исключение
+        Чтение.Закрыть();
+        ВызватьИсключение;
+    КонецПопытки;
+    Чтение.Закрыть();
+    Возврат Значение;
+КонецФункции
+
+&НаКлиенте
+Функция ITLПрочитатьСостояниеЗапроса(ИмяСобытия, ОжидаемыйВладелец)
+    ИмяСостояния = ITLИмяФайлаЗапроса(ИмяСобытия, "Pending");
+    Если НЕ Ванесса.ФайлСуществуетКомандаСистемы(ИмяСостояния) Тогда
+        ВызватьИсключение "ITL_CLIENT_CODE_PENDING_STATE_MISSING: " + ИмяСобытия;
+    КонецЕсли;
+    Состояние = ITLПрочитатьJSONФайл(ИмяСостояния);
+    ФайлСобытия = Новый Файл(ИмяСобытия);
+    Идентификатор = Сред(ФайлСобытия.Имя, 11, 36);
+    Если НЕ Состояние.Свойство("protocol") Или Состояние.protocol <> "itl-file-code-request-v1"
+        Или НЕ Состояние.Свойство("id") Или Состояние.id <> Идентификатор
+        Или НЕ Состояние.Свойство("owner") Или Состояние.owner <> ОжидаемыйВладелец
+        Или НЕ Состояние.Свойство("target") Или НЕ Состояние.Свойство("code") Тогда
+        ВызватьИсключение "ITL_CLIENT_CODE_PENDING_STATE_INVALID: " + ИмяСостояния;
+    КонецЕсли;
+    Возврат Состояние;
+КонецФункции
+
+&НаКлиенте
+Процедура ITLПроверитьПовторКоманды(ИмяСобытия, Владелец, Цель, ТекстКода)
+    Состояние = ITLПрочитатьСостояниеЗапроса(ИмяСобытия, Владелец);
+    Если Состояние.target <> Цель Или Состояние.code <> ТекстКода Тогда
+        ВызватьИсключение "ITL_CLIENT_CODE_COMPLETION_UNKNOWN: " + ИмяСобытия;
+    КонецЕсли;
+КонецПроцедуры
+
+&НаКлиенте
+Функция ITLПодготовитьКаталогКанала(БазовыйКаталог, Владелец)
+    Ванесса.СоздатьКаталогКомандаСистемы(БазовыйКаталог);
+    Незавершенные = Новый Массив;
+    Для Каждого ФайлКанала Из НайтиФайлы(БазовыйКаталог, "Channel_ITL.json", Истина) Цикл
+        Попытка
+            Канал = ITLПрочитатьJSONФайл(ФайлКанала.ПолноеИмя);
+            Если НЕ Канал.Свойство("protocol") Или Канал.protocol <> "itl-file-code-channel-v1"
+                Или НЕ Канал.Свойство("owner") Тогда
+                ВызватьИсключение "ITL_CLIENT_CODE_CHANNEL_STATE_INVALID: " + ФайлКанала.ПолноеИмя;
+            КонецЕсли;
+        Исключение
+            ВызватьИсключение "ITL_CLIENT_CODE_CHANNEL_STATE_INVALID: " + ФайлКанала.ПолноеИмя;
+        КонецПопытки;
+        Если Канал.owner <> Владелец Тогда Продолжить; КонецЕсли;
+        КоличествоНезавершенныхДо = Незавершенные.Количество();
+        Для Каждого ФайлСостояния Из НайтиФайлы(ФайлКанала.Путь, "Pending_ITL_*.json") Цикл
+            Идентификатор = Сред(ФайлСостояния.Имя, 13, 36);
+            ИмяСобытия = ФайлКанала.Путь + "Event_ITL_" + Идентификатор + ".json";
+            Состояние = ITLПрочитатьСостояниеЗапроса(ИмяСобытия, Владелец);
+            Если НЕ Ванесса.ФайлСуществуетКомандаСистемы(ITLИмяФайлаЗапроса(ИмяСобытия, "Ack")) Тогда
+                Незавершенные.Добавить(Новый Структура("directory,request,state", ФайлКанала.Путь, ИмяСобытия, Состояние));
+            Иначе
+                ITLПроверитьПодтверждениеРезультата(ИмяСобытия, Владелец);
+            КонецЕсли;
+        КонецЦикла;
+        Если Незавершенные.Количество() = КоличествоНезавершенныхДо Тогда
+            ITLОчиститьЗавершенныйКаталогКанала(ФайлКанала.Путь, Владелец);
+        КонецЕсли;
+    КонецЦикла;
+    Если Незавершенные.Количество() > 1 Тогда
+        ВызватьИсключение "ITL_CLIENT_CODE_RESTART_AMBIGUOUS";
+    КонецЕсли;
+    Если Незавершенные.Количество() = 1 Тогда
+        Незавершенная = Незавершенные[0];
+        ИмяЗахвата = ITLИмяФайлаЗапроса(Незавершенная.request, "Claim");
+        ИмяРезультата = ITLИмяФайлаЗапроса(Незавершенная.request, "Result");
+        Если НЕ Ванесса.ФайлСуществуетКомандаСистемы(Незавершенная.request)
+            И НЕ Ванесса.ФайлСуществуетКомандаСистемы(ИмяЗахвата)
+            И НЕ Ванесса.ФайлСуществуетКомандаСистемы(ИмяРезультата) Тогда
+            Запрос = Новый Структура("protocol,id,target,code", "itl-file-code-v1", Незавершенная.state.id, Незавершенная.state.target, Незавершенная.state.code);
+            ITLЗаписатьJSONАтомарно(Незавершенная.request, Запрос);
+        КонецЕсли;
+        КонтекстСохраняемый.Вставить("_ITLВладелецНеподтвержденнойКоманды", Владелец);
+        КонтекстСохраняемый.Вставить("_ITLВладелецПоследнейКоманды", Владелец);
+        КонтекстСохраняемый.Вставить("_ITLНеподтвержденнаяКоманда", Незавершенная.request);
+        КонтекстСохраняемый.Вставить("_ИмяФайлаПоследнегоСобытия", Незавершенная.request);
+        Возврат ITLНормализоватьКаталог(Незавершенная.directory);
+    КонецЕсли;
+    Каталог = БазовыйКаталог + ПолучитьРазделительПути() + "itl-" + Строка(Новый УникальныйИдентификатор) + ПолучитьРазделительПути() + "events";
+    Ванесса.СоздатьКаталогКомандаСистемы(Каталог);
+    ITLЗаписатьJSONАтомарно(Каталог + ПолучитьРазделительПути() + "Channel_ITL.json",
