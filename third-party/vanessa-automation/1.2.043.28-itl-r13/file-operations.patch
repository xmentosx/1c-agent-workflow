+    КонецЕсли;
+    ФайлКаталога = Новый Файл(Каталог);
+    КаталогПоколения = ФайлКаталога.Путь;
+    ФайлПоколения = Новый Файл(КаталогПоколения);
+    ФайлыПоколения = НайтиФайлы(КаталогПоколения, "*", Ложь);
+    Если Лев(ФайлПоколения.Имя, 4) = "itl-"
+        И СтрДлина(ФайлПоколения.Имя) = 40
