+&НаКлиенте
+Функция ITLКлючКлиентаМониторинга()
+    ДанныеКлиента = Ванесса.ТекущиеДанныеКлиентаТестирования();
+    Если ДанныеКлиента = Неопределено Тогда ВызватьИсключение "ITL_CLIENT_CODE_CLIENT_NOT_SELECTED"; КонецЕсли;
+    Если НЕ ЗначениеЗаполнено(ДанныеКлиента.ИмяКомпьютера) Или ДанныеКлиента.ПортЗапускаТестКлиента <= 0
+        Или НЕ ЗначениеЗаполнено(ДанныеКлиента.ПутьКИнфобазе) Тогда
+        ВызватьИсключение "ITL_CLIENT_CODE_CONNECTION_IDENTITY_MISSING";
+    КонецЕсли;
+    // PID may be zero or become known after connection. The selected endpoint stays stable.
+    Части = Новый Массив;
+    Части.Добавить(НРег(СокрЛП(ДанныеКлиента.ИмяКомпьютера)));
+    Части.Добавить(ДанныеКлиента.ПортЗапускаТестКлиента);
+    Части.Добавить(ДанныеКлиента.ПутьКИнфобазе);
+    Запись = Новый ЗаписьJSON;
+    Запись.УстановитьСтроку();
+    ЗаписатьJSON(Запись, Части);
+    Возврат Запись.Закрыть();
+КонецФункции
