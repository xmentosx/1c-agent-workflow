+    Попытка
+        Ответ = ПрочитатьJSON(Чтение);
+    Исключение
+        Чтение.Закрыть();
+        ВызватьИсключение;
+    КонецПопытки;
+    Чтение.Закрыть();
+    Если Ответ.protocol <> "itl-file-code-v1" Или Ответ.id <> Идентификатор Тогда
+        ВызватьИсключение "ITL_CLIENT_CODE_RESPONSE_IDENTITY_MISMATCH";
