+    Если НЕ КонтекстСохраняемый.Свойство("_ITLНеподтвержденнаяКоманда") Тогда
+        КонтекстСохраняемый.Вставить("_ИмяФайлаПоследнегоСобытия", "");
+    КонецЕсли;
+КонецПроцедуры
+
+&НаКлиенте
+Функция ITLПроверитьПодтверждениеРезультата(ИмяСобытия, Владелец)
+    Состояние = ITLПрочитатьСостояниеЗапроса(ИмяСобытия, Владелец);
+    ИмяПодтверждения = ITLИмяФайлаЗапроса(ИмяСобытия, "Ack");
+    Если НЕ Ванесса.ФайлСуществуетКомандаСистемы(ИмяПодтверждения) Тогда Возврат Ложь; КонецЕсли;
+    Подтверждение = ITLПрочитатьJSONФайл(ИмяПодтверждения);
+    Если НЕ Подтверждение.Свойство("protocol") Или Подтверждение.protocol <> "itl-file-code-ack-v1"
+        Или НЕ Подтверждение.Свойство("id") Или Подтверждение.id <> Состояние.id
+        Или НЕ Подтверждение.Свойство("owner") Или Подтверждение.owner <> Владелец Тогда
+        ВызватьИсключение "ITL_CLIENT_CODE_ACK_STATE_INVALID: " + ИмяПодтверждения;
+    КонецЕсли;
+    Возврат Истина;
+КонецФункции
+
+&НаКлиенте
+Функция ITLКаталогКаналаЗавершен(Каталог, Владелец)
+    ИмяКанала = Каталог + ПолучитьРазделительПути() + "Channel_ITL.json";
+    Если НЕ Ванесса.ФайлСуществуетКомандаСистемы(ИмяКанала) Тогда Возврат Ложь; КонецЕсли;
+    Канал = ITLПрочитатьJSONФайл(ИмяКанала);
+    Если НЕ Канал.Свойство("protocol") Или Канал.protocol <> "itl-file-code-channel-v1"
+        Или НЕ Канал.Свойство("owner") Или Канал.owner <> Владелец Тогда
+        ВызватьИсключение "ITL_CLIENT_CODE_CHANNEL_STATE_INVALID: " + ИмяКанала;
+    КонецЕсли;
+    Для Каждого ФайлСостояния Из НайтиФайлы(Каталог, "Pending_ITL_*.json") Цикл
+        Идентификатор = Сред(ФайлСостояния.Имя, 13, 36);
+        ИмяСобытия = Каталог + ПолучитьРазделительПути() + "Event_ITL_" + Идентификатор + ".json";
+        Если НЕ ITLПроверитьПодтверждениеРезультата(ИмяСобытия, Владелец) Тогда Возврат Ложь; КонецЕсли;
