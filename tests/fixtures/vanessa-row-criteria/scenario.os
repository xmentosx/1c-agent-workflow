ПодключитьСценарий(КаталогФикстуры + "/field.os", "ТестируемоеПолеФормы");
ПодключитьСценарий(КаталогФикстуры + "/table.os", "ТестоваяТаблица");
ПодключитьСценарий(КаталогФикстуры + "/server.os", "ТестовыйМспСервер");
ПодключитьСценарий(КаталогФикстуры + "/vanessa.os", "ТестоваяВанесса");
Ванесса = Новый ТестоваяВанесса;

Сценарий = АргументыКоманднойСтроки[0];
ОжидаемаяСтрока = 2;
ОжидаемыйКод = "";
ОжидаемыеВызовы = 1;
Если Сценарий = "identifier" Тогда
    Критерии = "Код=2";
ИначеЕсли Сценарий = "spaces" Тогда
    Критерии = "Дата начала=2026-09-11";
    ОжидаемаяСтрока = 3;
ИначеЕсли Сценарий = "multiple" Тогда
    Критерии = "Дата начала=2026-09-10; Вид операции=Расход";
ИначеЕсли Сценарий = "punctuation" Тогда
    Критерии = "Цена, руб.=200";
ИначеЕсли Сценарий = "case" Тогда
    Критерии = "дАТА НАЧАЛА=2026-09-10; ВИД ОПЕРАЦИИ=Расход";
ИначеЕсли Сценарий = "repeated" Тогда
    Критерии = "Код=1;код=2";
ИначеЕсли Сценарий = "equals" Тогда
    Критерии = "Описание=А=Б";
ИначеЕсли Сценарий = "no-match" Тогда
    Критерии = "Код=999";
    ОжидаемыйКод = "ACTION_FAILED";
ИначеЕсли Сценарий = "unknown-column" Тогда
    Критерии = "Нет колонки=1";
    ОжидаемыйКод = "ACTION_FAILED";
    ОжидаемыеВызовы = 0;
ИначеЕсли Сценарий = "empty" Тогда
    Критерии = "; ;";
    ОжидаемыйКод = "INVALID_PARAMS";
    ОжидаемыеВызовы = 0;
Иначе
    ВызватьИсключение "UNKNOWN_FIXTURE_CASE";
КонецЕсли;

Результат = ПереходКСтрокеТаблицы("Список документов", Критерии);
Если ОжидаемыйКод = "" Тогда
    Если ТипЗнч(Результат) = Тип("Структура") Тогда
        ВызватьИсключение Результат.Код + ": " + Результат.Сообщение;
    КонецЕсли;
    Если Ванесса.ВыбраннаяСтрока <> ОжидаемаяСтрока Тогда ВызватьИсключение "WRONG_SELECTED_ROW"; КонецЕсли;
Иначе
    Если ТипЗнч(Результат) <> Тип("Структура") Тогда ВызватьИсключение "FALSE_NAVIGATION_SUCCESS"; КонецЕсли;
    Если Результат.Код <> ОжидаемыйКод Тогда ВызватьИсключение "WRONG_ERROR_CLASS"; КонецЕсли;
    Если Ванесса.ВыбраннаяСтрока <> 0 Тогда ВызватьИсключение "ERROR_SELECTED_ROW"; КонецЕсли;
    Если Сценарий = "no-match" Тогда
        Если Найти(Результат.Сообщение, "ROW_NOT_FOUND") = 0 Или НЕ Ванесса.ДобавленаДиагностика Тогда
            ВызватьИсключение "ROW_FAILURE_DIAGNOSTICS_LOST";
        КонецЕсли;
    КонецЕсли;
КонецЕсли;
Если Ванесса.ВызовыПерехода <> ОжидаемыеВызовы Тогда ВызватьИсключение "WRONG_NAVIGATION_DISPATCH_COUNT"; КонецЕсли;
Сообщить("ROW_CRITERIA_CASE_PASSED: " + Сценарий);
