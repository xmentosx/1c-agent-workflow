// Only the UI transport is doubled. navigation.bsl is the unchanged upstream
// adapter, or that same adapter with the shipping candidate hunk applied.
Перем Таблица Экспорт;
Перем Строки Экспорт;
Перем ВыбраннаяСтрока Экспорт;
Перем ВызовыПерехода Экспорт;
Перем ДобавленаДиагностика Экспорт;

Процедура ПриСозданииОбъекта()
    Заголовки = СтрРазделить("Код;Дата начала;Вид операции;Описание;Цена, руб.", ";");
    Таблица = Новый ТестоваяТаблица(Заголовки);
    Строки = Новый Массив;
    ДобавитьСтроку("1", "2026-09-10", "Приход", "Начало", "100");
    ДобавитьСтроку("2", "2026-09-10", "Расход", "А=Б", "200");
    ДобавитьСтроку("3", "2026-09-11", "Приход", "Конец", "300");
    ВыбраннаяСтрока = 0;
    ВызовыПерехода = 0;
    ДобавленаДиагностика = Ложь;
КонецПроцедуры

Процедура ДобавитьСтроку(Код, Дата, Операция, Описание, Цена)
    Строка = Новый Соответствие;
    Строка.Вставить("Код", Код);
    Строка.Вставить("Дата начала", Дата);
    Строка.Вставить("Вид операции", Операция);
    Строка.Вставить("Описание", Описание);
    Строка.Вставить("Цена, руб.", Цена);
    Строки.Добавить(Строка);
КонецПроцедуры

Функция Локализовать(Текст) Экспорт
    Возврат Текст;
КонецФункции

Функция ПодставитьПараметрыВСтроку(Текст, Значение) Экспорт
    Возврат СтрЗаменить(Текст, "%1", Значение);
КонецФункции

Функция НайтиТЧПоИмени(Имя) Экспорт
    Если Имя = "Список документов" Тогда Возврат Таблица; КонецЕсли;
    Возврат Неопределено;
КонецФункции

Функция _СтрСоединить(Строки, Разделитель) Экспорт
    Возврат СтрСоединить(Строки, Разделитель);
КонецФункции

Процедура ВТаблицеЯПерехожуКСтроке(Имя, ТабПарам, ПереключитьВыделение = Неопределено, Направление = Неопределено, ДопПараметры = Неопределено) Экспорт
    ВызовыПерехода = ВызовыПерехода + 1;
    Если ТабПарам.Количество() <> 2 Тогда ВызватьИсключение "BAD_NAVIGATION_SHAPE"; КонецЕсли;
    Если ДопПараметры.ПолучатьЗначениеТЧ <> Ложь Тогда ВызватьИсключение "NAVIGATION_MODE_CHANGED"; КонецЕсли;
    Для Индекс = 0 По Строки.Количество() - 1 Цикл
        Совпало = Истина;
        Для Каждого Колонка Из ТабПарам[0] Цикл
            // These rows use the actual display captions. A lowercased caption
            // passed instead of the discovered caption will not resolve here.
            Если Строки[Индекс][Колонка.Значение] <> ТабПарам[1][Колонка.Ключ] Тогда
                Совпало = Ложь;
            КонецЕсли;
        КонецЦикла;
        Если Совпало Тогда
            ВыбраннаяСтрока = Индекс + 1;
            Возврат;
        КонецЕсли;
    КонецЦикла;
    ВызватьИсключение "ROW_NOT_FOUND";
КонецПроцедуры

Процедура ДополнитьОшибку_ТекущееСостояниеТаблицы(Таблица, ТекстОшибки) Экспорт
    ДобавленаДиагностика = Истина;
    ТекстОшибки = ТекстОшибки + "; CURRENT_TABLE_STATE";
КонецПроцедуры
