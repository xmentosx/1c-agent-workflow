#Область ПерехватчикиПримера

// Функция: &Перед неприменима, поэтому &Вместо с ПродолжитьВызов.
&НаСервере
&Вместо("РассчитатьИтог")
Функция ТестРассчитатьИтог(Данные, Режим)
	Возврат ПродолжитьВызов(Данные, Режим);
КонецФункции

&Вместо("ЗаписатьПакет")
Функция ТестЗаписатьПакет(Контекст)
	Попытка
		Результат = ПродолжитьВызов(Контекст);
	Исключение
		ТестЗафиксироватьОшибку(Контекст);
		ВызватьИсключение;
	КонецПопытки;
	Возврат Результат;
КонецФункции

&Перед("ПроверитьОчередь")
Процедура ТестПередПроверкойОчереди(Данные)
	ТестОтметитьЭтап("очередь");
КонецПроцедуры

&Вместо("ПрочитатьСнимок")
Функция ТестПрочитатьСнимок(Версии)
	// ПродолжитьВызов(Версии) в комментарии не вызывает исходный метод.
	Текст = "ПродолжитьВызов(Версии)
	|// не комментарий, а часть строки";
	Возврат ТестСнимокИзКопии(Версии);
КонецФункции

#КонецОбласти

&Вместо("ОпределитьРезультат")
Процедура ТестОпределитьРезультат(Контекст)
	Контекст.ПродолжитьВызов(Контекст);
КонецПроцедуры

Функция ТестСлужебная() Экспорт
	Возврат ПродолжитьВызов();
КонецФункции
