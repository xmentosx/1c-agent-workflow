ПодключитьСценарий(КаталогФикстуры + "/vanessa-agent.os", "ТестоваяВанесса");
ПодключитьСценарий(КаталогФикстуры + "/server.os", "ТестовыйСервер");
Ванесса = Новый ТестоваяВанесса;
VAExtensionОбщегоНазначенияВызовСервера = Новый ТестовыйСервер;
КонтекстСохраняемый = Новый Структура;
СчетчикВызовов = 0;
ВызовыФормы = 0;
ЗапускиМонитора = 0;
Сценарий = АргументыКоманднойСтроки[0];
Корень = АргументыКоманднойСтроки[1];
Ванесса.КаталогКаналаАгента = Корень;
КодШага = "СчетчикВызовов = СчетчикВызовов + 1;";

Если Сценарий = "manual" Или Сценарий = "no-identity" Тогда
    Если Сценарий = "manual" Тогда
        Ванесса.КаталогКаналаАгента = "";
    Иначе
        Ванесса.ТекущийПрофиль = Новый Структура("PIDКлиентаТестирования,ИмяКомпьютера,ПортЗапускаТестКлиента,ПутьКИнфобазе", 0, "", 0, "");
    КонецЕсли;
    ЯВыполняюКодВстроенногоЯзыкаРасширение(КодШага);
    ЯВыполняюКодВстроенногоЯзыкаНаСервереРасширение(КодШага);
    Проверить(ВызовыФормы = 2, "FORM_PATH_NOT_KEPT");
    Проверить(ЗапускиМонитора = 0 И Ванесса.ЗапретыШагов = 0, "CHANNEL_USED_WITHOUT_AGENT_ROUTE");
    Проверить(НайтиФайлы(Корень, "*", Истина).Количество() = 0, "CHANNEL_FILES_WITHOUT_AGENT_ROUTE");
    Сообщить("AGENT_ROUTE_CASE_PASSED: " + Сценарий);
    ЗавершитьРаботу(0);
КонецЕсли;

Если Сценарий = "client" Тогда
    ЯВыполняюКодВстроенногоЯзыкаРасширение(КодШага);
    Проверить(ВызовыФормы = 0, "FORM_OPENED_IN_AGENT_ROUTE");
    Проверить(ЗапускиМонитора = 1 И Ванесса.ЗапретыШагов = 1, "MONITOR_OR_ASYNC_STEP_MISSING");
    Запрос = ПрочитатьJSONФайлПробы(ЕдинственныйФайл("Event_ITL_*.json"));
    Проверить(Запрос.target = "client", "CLIENT_TARGET_CHANGED");
    Проверить(Запрос.code = КодШага + Символы.ПС + "Результат = Неопределено;", "STEP_CODE_CHANGED: " + Запрос.code);
    Ждать();
    Проверить(НЕ Ванесса.Завершено И СчетчикВызовов = 0, "STEP_FINISHED_BEFORE_EXECUTION");
    Потребить();
    Ждать();
    Проверить(Ванесса.Завершено И Ванесса.ОшибкаРезультата = "", "CLIENT_STEP_FAILED: " + Ванесса.ОшибкаРезультата);
    Проверить(СчетчикВызовов = 1, "CLIENT_CODE_NOT_EXECUTED_ONCE");
    Проверить(НайтиФайлы(Корень, "Ack_ITL_*.json", Истина).Количество() = 1, "RESULT_NOT_ACKNOWLEDGED");
    Проверить(НЕ КонтекстСохраняемый.Свойство("_ITLКодШагаАгента"), "AGENT_STEP_STATE_RETAINED");
    // The next step reuses the same per-client monitor.
    Ванесса.Завершено = Ложь;
    ЯВыполняюКодВстроенногоЯзыкаРасширение(КодШага);
    Потребить();
    Ждать();
    Проверить(Ванесса.Завершено И Ванесса.ОшибкаРезультата = "" И СчетчикВызовов = 2, "SECOND_STEP_FAILED: " + Ванесса.ОшибкаРезультата);
    Проверить(ЗапускиМонитора = 1, "MONITOR_STARTED_TWICE");
ИначеЕсли Сценарий = "server" Тогда
    КодСервера = "Результат = 7;";
    ЯВыполняюКодВстроенногоЯзыкаНаСервереРасширение(КодСервера);
    Запрос = ПрочитатьJSONФайлПробы(ЕдинственныйФайл("Event_ITL_*.json"));
    // The form server command runs privileged code; the channel keeps that mode.
    Проверить(Запрос.target = "server-privileged", "SERVER_PRIVILEGE_CHANGED: " + Запрос.target);
    Потребить();
    Ждать();
    Проверить(Ванесса.Завершено И Ванесса.ОшибкаРезультата = "", "SERVER_STEP_FAILED: " + Ванесса.ОшибкаРезультата);
    Проверить(VAExtensionОбщегоНазначенияВызовСервера.Вызовы = 1 И VAExtensionОбщегоНазначенияВызовСервера.ПоследнийПривилегированный = Истина, "SERVER_NOT_PRIVILEGED_ONCE");
ИначеЕсли Сценарий = "failure" Тогда
    КодОшибки = "ВызватьИсключение ""BUSINESS_ERROR с пробелом"";";
    ЯВыполняюКодВстроенногоЯзыкаРасширение(КодОшибки);
    Потребить();
    Ждать();
    Проверить(Ванесса.Завершено, "FAILED_STEP_NOT_FINISHED");
    Проверить(СтрНайти(Ванесса.ОшибкаРезультата, "ITL_CLIENT_CODE_EXECUTION_FAILED") > 0, "FAILURE_NOT_QUALIFIED: " + Ванесса.ОшибкаРезультата);
    Проверить(СтрНайти(Ванесса.ОшибкаРезультата, "BUSINESS_ERROR с пробелом") > 0, "ORIGINAL_ERROR_LOST: " + Ванесса.ОшибкаРезультата);
    Проверить(СтрНайти(Ванесса.ОшибкаРезультата, КодОшибки) > 0, "STEP_CODE_NOT_REPORTED: " + Ванесса.ОшибкаРезультата);
    // A reported failure is terminal and acknowledged; the next step is accepted.
    Ванесса.Завершено = Ложь;
    ЯВыполняюКодВстроенногоЯзыкаРасширение(КодШага);
    Потребить();
    Ждать();
    Проверить(Ванесса.Завершено И Ванесса.ОшибкаРезультата = "" И СчетчикВызовов = 1, "STEP_AFTER_FAILURE_REJECTED: " + Ванесса.ОшибкаРезультата);
ИначеЕсли Сценарий = "result-variable" Тогда
    // A scenario variable named like the consumer's local result is not a JSON value.
    КодРезультата = "Результат = Новый ЧтениеJSON; СчетчикВызовов = СчетчикВызовов + 1;";
    ЯВыполняюКодВстроенногоЯзыкаРасширение(КодРезультата);
    Потребить();
    Ждать();
    Проверить(Ванесса.Завершено И Ванесса.ОшибкаРезультата = "" И СчетчикВызовов = 1, "RESULT_VARIABLE_BROKE_REPLY: " + Ванесса.ОшибкаРезультата);
ИначеЕсли Сценарий = "result-variable-unwrapped" Тогда
    // Reproducer: the same code without the route's reset leaves no reply at all.
    ITLОбеспечитьМониторКаналаАгента(Корень, ITLКлючКлиентаМониторинга());
    ITLОтправитьКодВКанал("Результат = Новый ЧтениеJSON; СчетчикВызовов = СчетчикВызовов + 1;", Истина, Ложь);
    Потребить();
    Проверить(СчетчикВызовов = 1, "UNWRAPPED_CODE_NOT_EXECUTED");
    Проверить(НайтиФайлы(Корень, "Result_ITL_*.json", Истина).Количество() = 0, "UNWRAPPED_REPLY_WRITTEN");
    Сообщить("UNWRAPPED_REPLY_LOST");
ИначеЕсли Сценарий = "restart-recovered" Тогда
    ЯВыполняюКодВстроенногоЯзыкаРасширение(КодШага);
    Событие = ЕдинственныйФайл("Event_ITL_*.json");
    Ждать();
    Проверить(ЗапускиМонитора = 1, "MONITOR_RESTARTED_EARLY");
    // The TestClient process (and its monitor) was replaced while the request waited.
    КонтекстСохраняемый._ITLКодШагаАгента.started = ТекущаяДата() - 61;
    Ждать();
    Проверить(ЗапускиМонитора = 2, "MONITOR_NOT_RESTARTED");
    КаталогМонитора = КонтекстСохраняемый._СписокPIDКлиентовСМониторингомСобытий.Получить(ITLКлючКлиентаМониторинга());
    Проверить(ITLНормализоватьКаталог(КаталогМонитора) = ITLНормализоватьКаталог(Новый Файл(Событие).Путь),
        "RESTARTED_MONITOR_LEFT_THE_REQUEST_CHANNEL: " + КаталогМонитора + " | " + Событие);
    Проверить(НЕ Ванесса.Завершено, "RESTART_FINISHED_STEP");
    Потребить();
    Ждать();
    Проверить(Ванесса.Завершено И Ванесса.ОшибкаРезультата = "" И СчетчикВызовов = 1, "RECOVERED_STEP_FAILED: " + Ванесса.ОшибкаРезультата);
ИначеЕсли Сценарий = "restart-withdrawn" Тогда
    ЯВыполняюКодВстроенногоЯзыкаРасширение(КодШага);
    КонтекстСохраняемый._ITLКодШагаАгента.started = ТекущаяДата() - 61;
    Ждать();
    Проверить(ЗапускиМонитора = 2 И НЕ Ванесса.Завершено, "MONITOR_NOT_RESTARTED");
    КонтекстСохраняемый._ITLКодШагаАгента.restarted = ТекущаяДата() - 61;
    Ждать();
    Проверить(Ванесса.Завершено, "UNCLAIMED_STEP_NOT_FINISHED");
    Проверить(СтрНайти(Ванесса.ОшибкаРезультата, "ITL_CLIENT_CODE_NOT_DISPATCHED") > 0, "WITHDRAWAL_NOT_REPORTED: " + Ванесса.ОшибкаРезультата);
    Проверить(СтрНайти(Ванесса.ОшибкаРезультата, КодШага) > 0, "STEP_CODE_NOT_REPORTED: " + Ванесса.ОшибкаРезультата);
    // A consumer that appears later can never execute the withdrawn request.
    Потребить();
    Проверить(СчетчикВызовов = 0, "WITHDRAWN_REQUEST_EXECUTED");
    Ванесса.Завершено = Ложь;
    ЯВыполняюКодВстроенногоЯзыкаРасширение(КодШага);
    Потребить();
    Ждать();
    Проверить(Ванесса.Завершено И Ванесса.ОшибкаРезультата = "" И СчетчикВызовов = 1, "STEP_AFTER_WITHDRAWAL_REJECTED: " + Ванесса.ОшибкаРезультата);
Иначе
    ВызватьИсключение "UNKNOWN_CASE: " + Сценарий;
КонецЕсли;
Сообщить("AGENT_ROUTE_CASE_PASSED: " + Сценарий);
