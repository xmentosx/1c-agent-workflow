// TestClient window double: its title and the form buttons pressed in it.
Перем Заголовок Экспорт;
Перем Нажатия Экспорт;
Перем ИскомаяКнопка;

Функция НайтиОбъект(ТипОбъекта, ЗаголовокОбъекта = Неопределено, ИмяОбъекта = Неопределено) Экспорт
    ИскомаяКнопка = ИмяОбъекта;
    Возврат ЭтотОбъект;
КонецФункции

Процедура Нажать() Экспорт
    Нажатия.Добавить(ИскомаяКнопка);
КонецПроцедуры

Нажатия = Новый Массив;
