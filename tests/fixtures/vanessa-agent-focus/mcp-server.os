// MCP server double: records the tool errors that a rejected command finishes with.
Перем Ошибки Экспорт;

Процедура ЗавершитьВызовИнструментаСОшибкой(Идентификатор, Код, Текст) Экспорт
    Ошибки.Добавить(Новый Структура("id,code,text", Идентификатор, Код, Текст));
КонецПроцедуры

Ошибки = Новый Массив;
