// TestClient table double. Each Vanessa sleep advances one tick; the current row of a
// tick is a map from the column name to its cell text, or Неопределено for no row.
Перем Последовательность Экспорт;
Перем НомерТика Экспорт;

Процедура Тик() Экспорт
    НомерТика = НомерТика + 1;
КонецПроцедуры

Функция ПолучитьТекстЯчейки(ИмяКолонки) Экспорт
    Индекс = Мин(Макс(НомерТика - 1, 0), Последовательность.ВГраница());
    ТекущаяСтрока = Последовательность[Индекс];
    Если ТекущаяСтрока = Неопределено Тогда
        ВызватьИсключение "Нет текущей строки";
    КонецЕсли;
    Возврат ТекущаяСтрока.Получить(ИмяКолонки);
КонецФункции

НомерТика = 0;
