// VanessaExt double: the foreground window, its owner process and activations.
Перем АктивноеОкно Экспорт;
Перем ВладелецАктивного Экспорт;
Перем Активации Экспорт;

Функция ПолучитьСвойстваОкна(Окно) Экспорт
    Возврат "{""ProcessId"": " + Формат(ВладелецАктивного, "ЧГ=0; ЧН=0") + "}";
КонецФункции

Процедура АктивироватьОкно(Окно) Экспорт
    Активации = Активации + 1;
КонецПроцедуры

Активации = 0;
