// Doubles of the КлиентТестирования framework calls around the paired VAExtension form.
Функция НайтиРеквизитОткрытойФормыПоЗаголовку(Имя, ИскатьПоИмени = Ложь, ВызыватьИсключение = Истина, ТипПоля = Неопределено, ДопПараметры = Неопределено)
    Если НЕ ФормаОбработкиОткрыта Тогда
        Проверить(Имя = ПолеHTML.Имя, "UNEXPECTED_CLIENT_FIELD: " + Имя);
        Возврат ПолеHTML;
    КонецЕсли;
    Проверить(ИскатьПоИмени = Истина, "FORM_ATTRIBUTE_SEARCH_CHANGED: " + Имя);
    Поле = Новый ТестовоеПолеUI;
    Поле.Имя = Имя;
    Поле.Введено = Введено;
    Возврат Поле;
КонецФункции

Функция ПолучитьАктивноеОкноИзТестовоеПриложение(ДопПараметры = Неопределено)
    Возврат ?(ФормаОбработкиОткрыта, ОкноОбработки, ОкноКлиента);
КонецФункции

Процедура ОткрытьНавигационнуюСсылку(Ссылка)
    ОткрытыеСсылки.Добавить(Ссылка);
    ФормаОбработкиОткрыта = Истина;
КонецПроцедуры

// The command of the paired VAExtension form: the typed attributes reach the production
// DOM search exactly as the form attributes do in the TestClient.
Процедура ОжиданиеОкончанияОбработки(БылаОшибка, РеквизитВыражениеВычислено)
    Проверить(ОкноОбработки.Нажатия.Найти("ФормаВыполнитьКод") <> Неопределено, "FORM_COMMAND_NOT_PRESSED");
    Проверить(Введено.Получить("ЗначениеИмяЭлементаФормы") = ПолеHTML.Имя, "ELEMENT_NAME_CHANGED");
    Проверить(Введено.Получить("ЗначениеЗаголовокОкна") = ОкноКлиента.Заголовок, "WINDOW_TITLE_CHANGED");
    ТипГиперссылки = Число(Введено.Получить("ТипГиперссылки"));
    Проверить(ТипГиперссылки = 3, "SEARCH_TYPE_CHANGED");
    ИмяГиперссылки = Введено.Получить("ИмяГиперссылки");
    СсылкаНайдена = Ложь;
    НайденныеСсылки = "";
    ITLНажатьНаГиперссылкуПоDOM(ПолеHTML);
    БылаОшибка = Ложь;
КонецПроцедуры

Функция ПолучитьПредставлениеДанныхЭлементаФормы(Реквизит, ДопПараметры = Неопределено)
    Если Реквизит.Имя = "СсылкаНайдена" Тогда
        Возврат ?(СсылкаНайдена, "Да", "Нет");
    ИначеЕсли Реквизит.Имя = "НайденныеСсылки" Тогда
        Возврат НайденныеСсылки;
    КонецЕсли;
    ВызватьИсключение "UNEXPECTED_ATTRIBUTE: " + Реквизит.Имя;
КонецФункции

Функция ЗначениеФлагаСоответствуетИстина(Представление)
    Возврат Представление = "Да";
КонецФункции

Функция Узел(Тег, Родитель, Текст = "")
    Результат = Новый ТестовыйУзелDOM;
    Результат.tagName = Тег;
    Результат.parentNode = Родитель;
    Результат.textContent = Текст;
    Возврат Результат;
КонецФункции

ПодключитьСценарий(КаталогФикстуры + "/vanessa-agent.os", "ТестоваяВанесса");
ПодключитьСценарий(КаталогФикстуры + "/dom-node.os", "ТестовыйУзелDOM");
ПодключитьСценарий(КаталогФикстуры + "/ui-field.os", "ТестовоеПолеUI");
ПодключитьСценарий(КаталогФикстуры + "/ui-window.os", "ТестовоеОкноUI");
Ванесса = Новый ТестоваяВанесса;
Сценарий = АргументыКоманднойСтроки[0];
Введено = Новый Соответствие;
ОткрытыеСсылки = Новый Массив;
ФормаОбработкиОткрыта = Ложь;

// PM5 desktop HTML menu (06.11.2026): the variant links and Обновить are inside
// collapsed <details> elements, so the platform click does not find them.
Документ = Узел(Неопределено, Неопределено);
Тело = Узел("BODY", Документ);
Меню = Узел("DETAILS", Тело);
Узел("SUMMARY", Меню, "Варианты");
Варианты = Узел("DIV", Меню);
Вариант = Узел("A", Варианты, "  УТ перенос UI" + Символы.НПП + "065261a7 ");
Вариант.setAttribute("href", "e1c:variant/065261a7");
Действия = Узел("details", Тело);
Обновить = Узел("A", Действия, "Обновить");
Обновить.setAttribute("href", "#refresh");
БезАдреса = Узел("A", Тело, "Без адреса");
Документ.Ссылки.Добавить(Вариант);
Документ.Ссылки.Добавить(Обновить);
Документ.Ссылки.Добавить(БезАдреса);
ПолеHTML = Новый ТестовоеПолеUI;
ПолеHTML.Имя = "HTML";
ПолеHTML.Документ = Документ;
ПолеHTML.Введено = Введено;
ПолеHTML.ОшибкаНажатия = "В элементе управления отсутствует указанное значение.";
ОкноКлиента = Новый ТестовоеОкноUI;
ОкноКлиента.Заголовок = "Администрирование рабочего стола *";
ОкноОбработки = Новый ТестовоеОкноUI;
ОкноОбработки.Заголовок = "Нажать гиперссылку HTML документа";

Если Сценарий = "dom-details-text" Тогда
    ИмяГиперссылки = "обновить";
    СсылкаНайдена = Ложь;
    ITLНажатьНаГиперссылкуПоDOM(ПолеHTML);
    Проверить(СсылкаНайдена И Обновить.Клики = 1 И Вариант.Клики = 0, "TEXT_LINK_NOT_CLICKED");
    Проверить(Действия.hasAttribute("open"), "CLOSED_DETAILS_NOT_OPENED");
    Проверить(НЕ Меню.hasAttribute("open"), "UNRELATED_DETAILS_OPENED");
ИначеЕсли Сценарий = "dom-normalized-text" Тогда
    ИмяГиперссылки = "УТ перенос UI 065261a7";
    СсылкаНайдена = Ложь;
    ITLНажатьНаГиперссылкуПоDOM(ПолеHTML);
    Проверить(СсылкаНайдена И Вариант.Клики = 1, "NORMALIZED_TEXT_NOT_CLICKED");
    Проверить(Меню.hasAttribute("open") И НЕ Действия.hasAttribute("open"), "WRONG_DETAILS_OPENED");
ИначеЕсли Сценарий = "dom-href" Тогда
    ИмяГиперссылки = "variant/065261A7";
    СсылкаНайдена = Ложь;
    ITLНажатьНаГиперссылкуПоDOM(ПолеHTML);
    Проверить(СсылкаНайдена И Вариант.Клики = 1 И Обновить.Клики = 0, "HREF_LINK_NOT_CLICKED");
    Проверить(Меню.hasAttribute("open"), "CLOSED_DETAILS_NOT_OPENED");
ИначеЕсли Сценарий = "dom-missing" Тогда
    ИмяГиперссылки = "Нет такой ссылки";
    СсылкаНайдена = Ложь;
    НайденныеСсылки = "";
    ITLНажатьНаГиперссылкуПоDOM(ПолеHTML);
    Проверить(НЕ СсылкаНайдена И Вариант.Клики + Обновить.Клики + БезАдреса.Клики = 0, "MISSING_LINK_CLICKED");
    Проверить(СтрНайти(НайденныеСсылки, "'УТ перенос UI 065261a7' -> e1c:variant/065261a7") > 0, "VARIANT_NOT_LISTED: " + НайденныеСсылки);
    Проверить(СтрНайти(НайденныеСсылки, "'Обновить' -> #refresh") > 0, "REFRESH_NOT_LISTED: " + НайденныеСсылки);
    Проверить(СтрНайти(НайденныеСсылки, "'Без адреса' -> ") > 0, "HREFLESS_NOT_LISTED: " + НайденныеСсылки);
    Проверить(НЕ Меню.hasAttribute("open") И НЕ Действия.hasAttribute("open"), "DETAILS_OPENED_WITHOUT_CLICK");
ИначеЕсли Сценарий = "caller-agent-fallback" Тогда
    Ванесса.АгентскийЗапуск = Истина;
    ITLНажатьГиперссылкуВПолеHTML("HTML", "Обновить", Истина);
    Проверить(Обновить.Клики = 1 И Действия.hasAttribute("open"), "FALLBACK_NOT_CLICKED");
    Проверить(ОткрытыеСсылки.Количество() = 1 И ОткрытыеСсылки[0] = "e1cib/app/Обработка.VAExtension_НажатьГиперссылкуHTMLДокумента", "PAIRED_FORM_NOT_OPENED");
    Проверить(СтрСоединить(ОкноОбработки.Нажатия, ",") = "ФормаВыполнитьКод,ЗакрытьФорму", "FORM_BUTTONS_CHANGED: " + СтрСоединить(ОкноОбработки.Нажатия, ","));
ИначеЕсли Сценарий = "caller-agent-missing" Тогда
    Ванесса.АгентскийЗапуск = Истина;
    ТекстОшибки = "";
    Попытка
        ITLНажатьГиперссылкуВПолеHTML("HTML", "Нет такой ссылки", Истина);
    Исключение
        ТекстОшибки = ОписаниеОшибки();
    КонецПопытки;
    Проверить(СтрНайти(ТекстОшибки, "В элементе управления отсутствует указанное значение.") > 0, "PLATFORM_ERROR_LOST: " + ТекстОшибки);
    Проверить(СтрНайти(ТекстОшибки, "ITL_HTML_HYPERLINK_NOT_FOUND") > 0, "MISSING_LINK_NOT_QUALIFIED: " + ТекстОшибки);
    Проверить(СтрНайти(ТекстОшибки, "'Обновить' -> #refresh") > 0 И СтрНайти(ТекстОшибки, "Администрирование рабочего стола *") > 0, "LINKS_NOT_LISTED: " + ТекстОшибки);
    Проверить(СтрСоединить(ОкноОбработки.Нажатия, ",") = "ФормаВыполнитьКод,ЗакрытьФорму", "PAIRED_FORM_NOT_CLOSED");
ИначеЕсли Сценарий = "caller-manual" Тогда
    ТекстОшибки = "";
    Попытка
        ITLНажатьГиперссылкуВПолеHTML("HTML", "Обновить", Истина);
    Исключение
        ТекстОшибки = ОписаниеОшибки();
    КонецПопытки;
    Проверить(СтрНайти(ТекстОшибки, "В элементе управления отсутствует указанное значение.") > 0, "PLATFORM_ERROR_LOST: " + ТекстОшибки);
    Проверить(СтрНайти(ТекстОшибки, "ITL_HTML_HYPERLINK_NOT_FOUND") = 0 И ОткрытыеСсылки.Количество() = 0 И Обновить.Клики = 0, "MANUAL_LAUNCH_USED_DOM");
ИначеЕсли Сценарий = "caller-index" Тогда
    // A link number keeps the platform click; the DOM search is by text.
    Ванесса.АгентскийЗапуск = Истина;
    ТекстОшибки = "";
    Попытка
        ITLНажатьГиперссылкуВПолеHTML("HTML", 2, Истина);
    Исключение
        ТекстОшибки = ОписаниеОшибки();
    КонецПопытки;
    Проверить(СтрНайти(ТекстОшибки, "В элементе управления отсутствует указанное значение.") > 0 И ОткрытыеСсылки.Количество() = 0, "INDEX_ROUTED_TO_DOM: " + ТекстОшибки);
ИначеЕсли Сценарий = "caller-platform-click" Тогда
    Ванесса.АгентскийЗапуск = Истина;
    ПолеHTML.ОшибкаНажатия = "";
    ITLНажатьГиперссылкуВПолеHTML("HTML", "Обновить", Истина);
    Проверить(ПолеHTML.НажатияПлатформы = 1 И ОткрытыеСсылки.Количество() = 0 И Обновить.Клики = 0, "PLATFORM_CLICK_NOT_KEPT");
Иначе
    ВызватьИсключение "UNKNOWN_CASE: " + Сценарий;
КонецЕсли;
Сообщить("R11_CASE_PASSED: " + Сценарий);
