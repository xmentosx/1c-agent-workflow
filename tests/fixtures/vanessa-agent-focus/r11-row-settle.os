Функция Строка_(Вариант, Описание = "Описание группы")
    Результат = Новый Соответствие;
    Результат.Вставить("ВариантВерсия", Вариант);
    Результат.Вставить("Описание", Описание);
    Возврат Результат;
КонецФункции

ПодключитьСценарий(КаталогФикстуры + "/vanessa-agent.os", "ТестоваяВанесса");
ПодключитьСценарий(КаталогФикстуры + "/row-table.os", "ТестоваяТаблица");
Ванесса = Новый ТестоваяВанесса;
Таблица = Новый ТестоваяТаблица;
Ванесса.ТаблицаСна = Таблица;
Сценарий = АргументыКоманднойСтроки[0];

// PM5 tree ВерсииВариантов (06.11.2026): the criteria row and the group rows that the
// asynchronous ПоказатьДеталиГруппыВарианта handler returned the cursor to.
Искомая = "УТ перенос UI 98bb99b7";
Колонки = Новый Структура("Кол1", "Вариант / версия");
Значения = Новый Структура("Кол1", Искомая);
ПоляПоЗаголовку = Новый Соответствие;
ПоляПоЗаголовку.Вставить(НРег("Вариант / версия"), Новый Структура("Имя,ТекстЗаголовка", "ВариантВерсия", "Вариант / версия"));
ПоляПоЗаголовку.Вставить(НРег("Описание"), Новый Структура("Имя,ТекстЗаголовка", "Описание", "Описание"));
Последовательность = Новый Массив;

Если Сценарий = "settled-match" Тогда
    Последовательность.Добавить(Строка_(Искомая));
    Таблица.Последовательность = Последовательность;
    Ошибка = ITLОшибкаТекущейСтрокиПослеПерехода(Таблица, "ВерсииВариантов", Колонки, Значения, ПоляПоЗаголовку);
    Проверить(Ошибка = "", "SETTLED_ROW_REJECTED: " + Ошибка);
    // Success needs a full settle window, not a single immediate read.
    Проверить(Ванесса.Сны = 4, "SETTLE_WINDOW_CHANGED: " + Ванесса.Сны);
ИначеЕсли Сценарий = "async-return" Тогда
    // Reproducer: the immediate read after navigation shows the requested row, so the
    // former single post-navigation check reported success.
    Последовательность.Добавить(Строка_(Искомая));
    Последовательность.Добавить(Строка_(Искомая));
    Последовательность.Добавить(Строка_("По портфелям и проектам"));
    Таблица.Последовательность = Последовательность;
    Таблица.Тик();
    Проверить(Таблица.ПолучитьТекстЯчейки("ВариантВерсия") = Искомая, "REPRODUCER_FIRST_READ_CHANGED");
    Таблица.НомерТика = 0;
    Ошибка = ITLОшибкаТекущейСтрокиПослеПерехода(Таблица, "ВерсииВариантов", Колонки, Значения, ПоляПоЗаголовку);
    Проверить(СтрНайти(Ошибка, "ITL_ROW_NAVIGATION_NOT_CONFIRMED") = 1, "MOVED_ROW_ACCEPTED: " + Ошибка);
    Проверить(СтрНайти(Ошибка, "Вариант / версия=По портфелям и проектам") > 0, "ACTUAL_ROW_NOT_REPORTED: " + Ошибка);
    Проверить(СтрНайти(Ошибка, "ВерсииВариантов") > 0, "TABLE_NOT_REPORTED: " + Ошибка);
ИначеЕсли Сценарий = "no-current-row" Тогда
    Последовательность.Добавить(Неопределено);
    Таблица.Последовательность = Последовательность;
    Ошибка = ITLОшибкаТекущейСтрокиПослеПерехода(Таблица, "ВерсииВариантов", Колонки, Значения, ПоляПоЗаголовку);
    Проверить(СтрНайти(Ошибка, "ITL_ROW_NAVIGATION_NOT_CONFIRMED") = 1 И СтрНайти(Ошибка, "<нет текущей строки>") > 0, "MISSING_ROW_ACCEPTED: " + Ошибка);
ИначеЕсли Сценарий = "never-settles" Тогда
    Для Номер = 1 По 30 Цикл
        Последовательность.Добавить(Строка_(?(Номер % 2 = 0, Искомая, "Копия: По портфелям и проектам")));
    КонецЦикла;
    Таблица.Последовательность = Последовательность;
    Ошибка = ITLОшибкаТекущейСтрокиПослеПерехода(Таблица, "ВерсииВариантов", Колонки, Значения, ПоляПоЗаголовку);
    Проверить(СтрНайти(Ошибка, "ITL_ROW_NAVIGATION_NOT_CONFIRMED") = 1 И СтрНайти(Ошибка, "не перестала меняться") > 0, "MOVING_ROW_ACCEPTED: " + Ошибка);
    Проверить(Ванесса.Сны = 24, "READ_LIMIT_CHANGED: " + Ванесса.Сны);
ИначеЕсли Сценарий = "normalized-criteria" Тогда
    // Display text matches without regard to case, non-breaking spaces and encoded line breaks.
    Колонки = Новый Структура("Кол1,Кол2", "Вариант / версия", "Описание");
    Значения = Новый Структура("Кол1,Кол2", "ут перенос ui 98BB99B7", "Первая строка\nВторая строка");
    Последовательность.Добавить(Строка_("УТ" + Символы.НПП + "перенос  UI 98bb99b7", "Первая строка" + Символы.ПС + "Вторая строка"));
    Таблица.Последовательность = Последовательность;
    Ошибка = ITLОшибкаТекущейСтрокиПослеПерехода(Таблица, "ВерсииВариантов", Колонки, Значения, ПоляПоЗаголовку);
    Проверить(Ошибка = "", "NORMALIZED_ROW_REJECTED: " + Ошибка);
    Значения.Кол2 = "Другая строка";
    Таблица.НомерТика = 0;
    Ошибка = ITLОшибкаТекущейСтрокиПослеПерехода(Таблица, "ВерсииВариантов", Колонки, Значения, ПоляПоЗаголовку);
    Проверить(СтрНайти(Ошибка, "ITL_ROW_NAVIGATION_NOT_CONFIRMED") = 1, "PARTIAL_MATCH_ACCEPTED: " + Ошибка);
Иначе
    ВызватьИсключение "UNKNOWN_CASE: " + Сценарий;
КонецЕсли;
Сообщить("R11_CASE_PASSED: " + Сценарий);
