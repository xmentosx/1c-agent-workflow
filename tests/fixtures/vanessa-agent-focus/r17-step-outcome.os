ПодключитьСценарий(КаталогФикстуры + "/r17-vanessa.os", "ТестоваяВанесса17");
ПодключитьСценарий(КаталогФикстуры + "/r17-mcp-server.os", "ТестовыйСерверMCP17");
Ванесса = Новый ТестоваяВанесса17;
СерверMCP = Новый ТестовыйСерверMCP17;
Сценарий = АргументыКоманднойСтроки[0];
Доп = Новый Структура("НомерСтроки", 12);

Если Сценарий = "success" Тогда
    Ванесса.Статус = "Success";
    ЗавершитьУспешноеВыполнениеШагаВРедакторе(Доп);
    Проверить(Ванесса.ЗапрошеннаяСтрока = 12, "EXECUTED_LINE_NOT_READ");
    Проверить(СерверMCP.Успехи.Количество() = 1, "SUCCESS_NOT_COMPLETED");
    Проверить(СерверMCP.Успехи[0].text = "Шаг в строке фича файла успешно выполнен", "SUCCESS_TEXT_CHANGED");
ИначеЕсли Сценарий = "failed-status" Или Сценарий = "missing-row" Тогда
    // PM5 10.11.2026: a step with ВызватьИсключение reached the success completion.
    Ванесса.Статус = ?(Сценарий = "failed-status", "Failed", Неопределено);
    ЗавершитьУспешноеВыполнениеШагаВРедакторе(Доп);
    Проверить(СерверMCP.Успехи.Количество() = 1, "OUTCOME_NOT_COMPLETED");
    Текст = СерверMCP.Успехи[0].text;
    Проверить(СтрНачинаетсяС(Текст, "ITL_VANESSA_STEP_NOT_PROVEN: "), "UNPROVEN_STEP_REPORTED_AS_SUCCESS");
    Проверить(СтрНайти(Текст, "успешно выполнен") = 0, "UNPROVEN_STEP_KEEPS_SUCCESS_TEXT");
    Проверить(СтрНайти(Текст, ?(Сценарий = "failed-status", "<Failed>", "<>")) > 0, "STATUS_NOT_NAMED");
ИначеЕсли Сценарий = "step-error" Тогда
    ЗавершитьВыполнениеШагаВРедактореСОшибкой(Доп, Новый Структура("ОписаниеОшибки", "Ошибка калибровки"));
    Проверить(СерверMCP.Успехи.Количество() = 1, "FAILURE_NOT_COMPLETED");
    Текст = СерверMCP.Успехи[0].text;
    Проверить(СтрНачинаетсяС(Текст, "ITL_VANESSA_STEP_FAILED: Ошибка калибровки"), "FAILED_STEP_NOT_CODED");
    Проверить(СтрНайти(Текст, "Активное окно: Настройки канбана") > 0, "ACTIVE_WINDOW_LOST");
Иначе
    ВызватьИсключение "Unknown case " + Сценарий;
КонецЕсли;
// A JSON-RPC error would make the on-demand facade stop the backend.
Проверить(СерверMCP.Ошибки.Количество() = 0, "PROTOCOL_ERROR_SENT");
Проверить(СерверMCP.Успехи[0].id = "mcp-17", "WRONG_CALL_COMPLETED");
Проверить(Ванесса.ИдентификаторЗадачи = Неопределено, "CALL_ID_NOT_CLEARED");
Сообщить("R17_CASE_PASSED: " + Сценарий);
