// MCP server double: records how a call is completed.
Перем Успехи Экспорт;
Перем Ошибки Экспорт;

Процедура ЗавершитьВызовИнструментаУспешно(Идентификатор, Текст) Экспорт
    Успехи.Добавить(Новый Структура("id,text", Идентификатор, Текст));
КонецПроцедуры

Процедура ЗавершитьВызовИнструментаСОшибкой(Идентификатор, Код, Текст) Экспорт
    Ошибки.Добавить(Новый Структура("id,code,text", Идентификатор, Код, Текст));
КонецПроцедуры

Успехи = Новый Массив;
Ошибки = Новый Массив;
