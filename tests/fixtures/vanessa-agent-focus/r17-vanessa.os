// Vanessa double for the r17 execute_feature_step outcome: the executed line's tree
// row, the MCP call id and the framework text helpers.
Перем Статус Экспорт;
Перем ЗапрошеннаяСтрока Экспорт;
Перем ИдентификаторЗадачи Экспорт;

Функция СтрокаДереваПоНомеруСтрокиФичи(Ном) Экспорт
    ЗапрошеннаяСтрока = Ном;
    Если Статус = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;
    Возврат Новый Структура("Статус", Статус);
КонецФункции

Функция ПолучитьИдентификаторЗадачиMCP() Экспорт
    Возврат ИдентификаторЗадачи;
КонецФункции

Процедура УстановитьИдентификаторЗадачиMCP(Значение) Экспорт
    ИдентификаторЗадачи = Значение;
КонецПроцедуры

Функция Локализовать(Текст) Экспорт
    Возврат Текст;
КонецФункции

Функция ПодставитьПараметрыВСтроку(Шаблон, П1) Экспорт
    Возврат СтрЗаменить(Шаблон, "%1", Строка(П1));
КонецФункции

Функция ITLДобавитьИтогУправления(Текст) Экспорт
    Возврат Текст;
КонецФункции

Функция _СтрСоединить(Массив, Разделитель) Экспорт
    Возврат СтрСоединить(Массив, Разделитель);
КонецФункции

ИдентификаторЗадачи = "mcp-17";
