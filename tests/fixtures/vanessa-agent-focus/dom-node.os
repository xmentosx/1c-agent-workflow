// HTML DOM double: an element, or the document whose anchors getElementsByTagName returns.
Перем tagName Экспорт;
Перем textContent Экспорт;
Перем parentNode Экспорт;
Перем Атрибуты Экспорт;
Перем Клики Экспорт;
Перем Ссылки Экспорт;
Перем length Экспорт;

Функция getAttribute(Имя) Экспорт
    Возврат Атрибуты.Получить(Имя);
КонецФункции

Функция hasAttribute(Имя) Экспорт
    Возврат Атрибуты.Получить(Имя) <> Неопределено;
КонецФункции

Процедура setAttribute(Имя, Значение) Экспорт
    Атрибуты.Вставить(Имя, Значение);
КонецПроцедуры

Процедура click() Экспорт
    Клики = Клики + 1;
КонецПроцедуры

Функция getElementsByTagName(Имя) Экспорт
    Если Имя <> "a" Тогда ВызватьИсключение "UNEXPECTED_TAG: " + Имя; КонецЕсли;
    length = Ссылки.Количество();
    Возврат ЭтотОбъект;
КонецФункции

Функция item(Индекс) Экспорт
    Возврат Ссылки[Индекс];
КонецФункции

Атрибуты = Новый Соответствие;
Клики = 0;
Ссылки = Новый Массив;
