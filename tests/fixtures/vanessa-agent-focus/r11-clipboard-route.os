ПодключитьСценарий(КаталогФикстуры + "/vanessa-agent.os", "ТестоваяВанесса");
ПодключитьСценарий(КаталогФикстуры + "/server.os", "ТестовыйСервер");
Ванесса = Новый ТестоваяВанесса;
VAExtensionОбщегоНазначенияВызовСервера = Новый ТестовыйСервер;
КонтекстСохраняемый = Новый Структура;
СчетчикВызовов = 0;
ВызовыФормы = 0;
ЗапускиМонитора = 0;
Сценарий = АргументыКоманднойСтроки[0];
Корень = АргументыКоманднойСтроки[1];
Ванесса.КаталогКаналаАгента = Корень;
// PM5 calibration step 00-calibrate-exception.feature (06.11.2026).
КодИсключения = "ВызватьИсключение ""Калибровка: исключение должно уронить шаг."";";
// The PM5 cleanup expression. The 8.3.27 platform rejects the property access on a Новый
// expression at compile time; OneScript accepts it, so the missing КонецЕсли makes the
// same text a compile error here too.
КодКомпиляции = "П = ""C:\нет такого каталога""; Если (Новый Файл(П)).Существует() Тогда";

Если Сценарий = "clipboard-client-exception" Тогда
    Проверить(ITLВыполнитьКодЧерезБуферОбменаВКаналеАгента(КодИсключения, Истина, Ложь), "AGENT_ROUTE_NOT_TAKEN");
    Запрос = ПрочитатьJSONФайлПробы(ЕдинственныйФайл("Event_ITL_*.json"));
    Проверить(Запрос.target = "client", "CLIENT_TARGET_CHANGED: " + Запрос.target);
    Ждать();
    Проверить(НЕ Ванесса.Завершено, "STEP_FINISHED_BEFORE_EXECUTION");
    Потребить();
    Ждать();
    Проверить(Ванесса.Завершено, "FAILED_STEP_NOT_FINISHED");
    Проверить(СтрНайти(Ванесса.ОшибкаРезультата, "ITL_CLIENT_CODE_EXECUTION_FAILED") > 0, "FAILURE_NOT_QUALIFIED: " + Ванесса.ОшибкаРезультата);
    Проверить(СтрНайти(Ванесса.ОшибкаРезультата, "Калибровка: исключение должно уронить шаг.") > 0, "ORIGINAL_ERROR_LOST: " + Ванесса.ОшибкаРезультата);
ИначеЕсли Сценарий = "clipboard-server-compile" Тогда
    Проверить(ITLВыполнитьКодЧерезБуферОбменаВКаналеАгента(КодКомпиляции, Ложь, Ложь), "AGENT_ROUTE_NOT_TAKEN");
    Запрос = ПрочитатьJSONФайлПробы(ЕдинственныйФайл("Event_ITL_*.json"));
    // The clipboard server step is not privileged; the channel keeps that mode.
    Проверить(Запрос.target = "server", "SERVER_TARGET_CHANGED: " + Запрос.target);
    Потребить();
    Ждать();
    Проверить(Ванесса.Завершено, "FAILED_STEP_NOT_FINISHED");
    Проверить(СтрНайти(Ванесса.ОшибкаРезультата, "ITL_CLIENT_CODE_EXECUTION_FAILED") > 0, "COMPILE_FAILURE_NOT_QUALIFIED: " + Ванесса.ОшибкаРезультата);
    Проверить(СтрНайти(Ванесса.ОшибкаРезультата, КодКомпиляции) > 0, "STEP_CODE_NOT_REPORTED: " + Ванесса.ОшибкаРезультата);
    Проверить(VAExtensionОбщегоНазначенияВызовСервера.Вызовы = 1 И VAExtensionОбщегоНазначенияВызовСервера.ПоследнийПривилегированный = Ложь, "SERVER_MODE_CHANGED");
ИначеЕсли Сценарий = "clipboard-privileged-success" Тогда
    Проверить(ITLВыполнитьКодЧерезБуферОбменаВКаналеАгента("Результат = 7;", Ложь, Истина), "AGENT_ROUTE_NOT_TAKEN");
    Запрос = ПрочитатьJSONФайлПробы(ЕдинственныйФайл("Event_ITL_*.json"));
    Проверить(Запрос.target = "server-privileged", "PRIVILEGED_TARGET_CHANGED: " + Запрос.target);
    Потребить();
    Ждать();
    Проверить(Ванесса.Завершено И Ванесса.ОшибкаРезультата = "", "PRIVILEGED_STEP_FAILED: " + Ванесса.ОшибкаРезультата);
    Проверить(VAExtensionОбщегоНазначенияВызовСервера.Вызовы = 1 И VAExtensionОбщегоНазначенияВызовСервера.ПоследнийПривилегированный = Истина, "SERVER_NOT_PRIVILEGED_ONCE");
ИначеЕсли Сценарий = "clipboard-manual" Тогда
    Ванесса.КаталогКаналаАгента = "";
    Проверить(НЕ ITLВыполнитьКодЧерезБуферОбменаВКаналеАгента(КодИсключения, Ложь, Ложь), "MANUAL_LAUNCH_ROUTED");
    Проверить(ЗапускиМонитора = 0 И Ванесса.ЗапретыШагов = 0, "CHANNEL_USED_IN_MANUAL_LAUNCH");
    Проверить(НайтиФайлы(Корень, "*", Истина).Количество() = 0, "CHANNEL_FILES_IN_MANUAL_LAUNCH");
ИначеЕсли Сценарий = "clipboard-agent-without-channel" Тогда
    // An agent launch whose channel root did not fit keeps no unchecked clipboard route.
    Ванесса.КаталогКаналаАгента = "";
    Ванесса.АгентскийЗапуск = Истина;
    ТекстОшибки = "";
    Попытка
        ITLВыполнитьКодЧерезБуферОбменаВКаналеАгента(КодИсключения, Ложь, Ложь);
    Исключение
        ТекстОшибки = ОписаниеОшибки();
    КонецПопытки;
    Проверить(СтрНайти(ТекстОшибки, "ITL_CLIENT_CODE_CHANNEL_UNAVAILABLE") > 0, "UNCHECKED_CLIPBOARD_ROUTE_ACCEPTED: " + ТекстОшибки);
    Проверить(СтрНайти(ТекстОшибки, "Калибровка") > 0, "STEP_CODE_NOT_REPORTED: " + ТекстОшибки);
    Проверить(НайтиФайлы(Корень, "*", Истина).Количество() = 0, "CHANNEL_FILES_WITHOUT_CHANNEL");
Иначе
    ВызватьИсключение "UNKNOWN_CASE: " + Сценарий;
КонецЕсли;
Сообщить("R11_CASE_PASSED: " + Сценарий);
