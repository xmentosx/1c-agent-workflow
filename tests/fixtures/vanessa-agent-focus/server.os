// Double of VAExtensionОбщегоНазначенияВызовСервера.ВыполнитьКодСервер: the same
// body as the shipped VAExtension function, plus a record of the privilege flag.
Перем ПоследнийКод Экспорт;
Перем ПоследнийПривилегированный Экспорт;
Перем Вызовы Экспорт;

Функция ВыполнитьКодСервер(КодДляВыполнения, ПривилегированныйРежим) Экспорт
    Вызовы = Вызовы + 1;
    ПоследнийКод = КодДляВыполнения;
    ПоследнийПривилегированный = ПривилегированныйРежим;
    Результат = Неопределено;
    Выполнить(КодДляВыполнения);
    Возврат Результат;
КонецФункции

Вызовы = 0;
