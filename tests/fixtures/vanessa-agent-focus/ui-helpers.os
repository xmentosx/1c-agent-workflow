ПодключитьСценарий(КаталогФикстуры + "/addin.os", "ТестоваяКомпонента");
ВнешняяКомпонентаДляСкриншотов = Новый ТестоваяКомпонента;
Объект = Новый Структура("ДополнительныеПараметры,ИспользоватьКомпонентуVanessaExt", Новый Структура, Истина);
PIDТекущегоКлиентаТестирования = 4242;
ДескрипторОсновногоОкнаТекущегоКлиентаТестирования = 777;
ВнешняяКомпонентаДляСкриншотов.АктивноеОкно = 5;
ВнешняяКомпонентаДляСкриншотов.ВладелецАктивного = 99;

// A manual Vanessa launch carries no agent marker and keeps upstream behavior.
Проверить(НЕ ITLАгентскийЗапуск() И ITLКаталогКаналаКодаАгента() = "", "MANUAL_LAUNCH_MARKED");
ITLАктивироватьКлиентТестированияДляВводаОС();
Проверить(ВнешняяКомпонентаДляСкриншотов.Активации = 0, "MANUAL_LAUNCH_ACTIVATED");
Объект.ДополнительныеПараметры = Неопределено;
Проверить(НЕ ITLАгентскийЗапуск(), "UNSTRUCTURED_PARAMETERS_MARKED");
Объект.ДополнительныеПараметры = Новый Структура("ITLAgentLaunch", "true");
Проверить(НЕ ITLАгентскийЗапуск(), "NON_BOOLEAN_MARKER_ACCEPTED");

// An agent launch without a usable channel root keeps the plain steps on the form path.
Объект.ДополнительныеПараметры = Новый Структура("ITLAgentLaunch", Истина);
Проверить(ITLАгентскийЗапуск() И ITLКаталогКаналаКодаАгента() = "", "ROOTLESS_AGENT_LAUNCH_ROUTED");
Объект.ДополнительныеПараметры = Новый Структура("ITLAgentLaunch,ITLClientCodeChannelRoot", Истина, " C:\агент с пробелом\cc ");
Проверить(ITLКаталогКаналаКодаАгента() = "C:\агент с пробелом\cc", "AGENT_ROOT_CHANGED: " + ITLКаталогКаналаКодаАгента());

// OS input activates the TestClient only when another process owns the foreground.
ITLАктивироватьКлиентТестированияДляВводаОС();
Проверить(ВнешняяКомпонентаДляСкриншотов.Активации = 1, "FOREIGN_FOREGROUND_NOT_ACTIVATED");
ВнешняяКомпонентаДляСкриншотов.ВладелецАктивного = 4242;
ITLАктивироватьКлиентТестированияДляВводаОС();
Проверить(ВнешняяКомпонентаДляСкриншотов.Активации = 1, "CLIENT_FOREGROUND_REACTIVATED");
ВнешняяКомпонентаДляСкриншотов.ВладелецАктивного = 99;
ДескрипторОсновногоОкнаТекущегоКлиентаТестирования = Неопределено;
ITLАктивироватьКлиентТестированияДляВводаОС();
Проверить(ВнешняяКомпонентаДляСкриншотов.Активации = 1, "UNKNOWN_WINDOW_ACTIVATED");
ДескрипторОсновногоОкнаТекущегоКлиентаТестирования = 777;
Объект.ИспользоватьКомпонентуVanessaExt = Ложь;
ITLАктивироватьКлиентТестированияДляВводаОС();
Проверить(ВнешняяКомпонентаДляСкриншотов.Активации = 1, "DISABLED_ADDIN_ACTIVATED");
Сообщить("UI_HELPERS_PASSED");
