// Vanessa framework double for the agent code-step route. Only framework calls
// are replaced; the production VAExtension methods run unchanged.
Перем КаталогКаналаАгента Экспорт;
Перем ОшибкаРезультата Экспорт;
Перем Завершено Экспорт;
Перем ЗапретыШагов Экспорт;
Перем ТекущийПрофиль Экспорт;
Перем Журнал Экспорт;
// r11 doubles: agent marker, upstream clipboard entry, MCP task state and sleep.
Перем АгентскийЗапуск Экспорт;
Перем ТаблицаСна Экспорт;
Перем Сны Экспорт;
Перем ИдентификаторЗадачи Экспорт;
Перем ФлагиОчищены Экспорт;

Функция ITLКаталогКаналаКодаАгента() Экспорт
    Возврат КаталогКаналаАгента;
КонецФункции

Функция ИдетВыполнениеСценариев() Экспорт
    Возврат Истина;
КонецФункции

Функция ТекущиеДанныеКлиентаТестирования() Экспорт
    Если ТекущийПрофиль <> Неопределено Тогда Возврат ТекущийПрофиль; КонецЕсли;
    Возврат Новый Структура("PIDКлиентаТестирования,ИмяКомпьютера,ПортЗапускаТестКлиента,ПутьКИнфобазе", 0, "localhost", 23001, "/F ""агент с пробелом""");
КонецФункции

Процедура ЗапретитьВыполнениеШагов() Экспорт
    ЗапретыШагов = ЗапретыШагов + 1;
КонецПроцедуры

Процедура ПродолжитьВыполнениеШагов(Ошибка = Ложь, Текст = "") Экспорт
    Если Завершено Тогда ВызватьИсключение "STEP_CONTINUED_TWICE"; КонецЕсли;
    Завершено = Истина;
    ОшибкаРезультата = ?(Ошибка, Текст, "");
КонецПроцедуры

Функция ЗначениеТаймаутаДляАсинхронногоШага(КоличествоСекунд) Экспорт
    Возврат Число(КоличествоСекунд);
КонецФункции

Функция МногострочнаяСтрокаИзПараметраШага(Код) Экспорт
    Если ТипЗнч(Код) = Тип("Строка") Тогда Возврат Код; КонецЕсли;
    Возврат СтрСоединить(Код, Символы.ПС);
КонецФункции

Функция Локализовать(Текст) Экспорт
    Возврат Текст;
КонецФункции

Процедура ЗаписатьЛогВЖРИнформация(Событие, Текст) Экспорт
    Журнал = Журнал + Событие + ": " + Текст + Символы.ПС;
КонецПроцедуры

Функция ФайлСуществуетКомандаСистемы(Имя) Экспорт
    Возврат Новый Файл(Имя).Существует();
КонецФункции

Процедура СоздатьКаталогКомандаСистемы(Имя) Экспорт
    СоздатьКаталог(Имя);
КонецПроцедуры

Процедура УдалитьФайлыКомандаСистемы(Имя) Экспорт
    УдалитьФайлы(Имя);
КонецПроцедуры

Процедура УдалитьКаталогКомандаСистемы(Имя) Экспорт
    УдалитьФайлы(Имя);
КонецПроцедуры

Процедура СохранитьЗначениеПеременнойВКонтекст(Имя, Значение) Экспорт
    ВызватьИсключение "AGENT_STEP_STORED_A_VARIABLE: " + Имя;
КонецПроцедуры

Функция ITLАгентскийЗапуск() Экспорт
    Если АгентскийЗапуск <> Неопределено Тогда Возврат АгентскийЗапуск; КонецЕсли;
    Возврат ЗначениеЗаполнено(КаталогКаналаАгента);
КонецФункции

Функция ЗаписатьОбъектJSON(Значение) Экспорт
    Возврат "{}";
КонецФункции

// The upstream clipboard route starts here; reaching it proves the ITL route was skipped.
Функция БуферОбменаVA() Экспорт
    ВызватьИсключение "UPSTREAM_CLIPBOARD_ROUTE";
КонецФункции

Функция ПодставитьПараметрыВСтроку(Шаблон, П1 = "", П2 = "", П3 = "", П4 = "") Экспорт
    Возврат СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(Шаблон, "%1", П1), "%2", П2), "%3", П3), "%4", П4);
КонецФункции

Процедура Sleep(КолСекунд) Экспорт
    Сны = Сны + 1;
    Если ТаблицаСна <> Неопределено Тогда ТаблицаСна.Тик(); КонецЕсли;
КонецПроцедуры

Функция ИдентификаторЗадачиMCP() Экспорт
    Возврат ИдентификаторЗадачи;
КонецФункции

Процедура УстановитьИдентификаторЗадачиMCP(Значение) Экспорт
    ИдентификаторЗадачи = Значение;
КонецПроцедуры

Процедура УстановитьФлагОповеститьMCPСерверПослеВыполненияСценариев(Значение, ДопПараметры) Экспорт
    ФлагиОчищены = ФлагиОчищены + 1;
КонецПроцедуры

Процедура УстановитьФлагОповеститьMCPСерверПослеВыполненияОднойСтрокиФичи(Значение) Экспорт
    ФлагиОчищены = ФлагиОчищены + 1;
КонецПроцедуры

ОшибкаРезультата = "";
Сны = 0;
ФлагиОчищены = 0;
ИдентификаторЗадачи = "mcp-request-1";
Завершено = Ложь;
ЗапретыШагов = 0;
Журнал = "";
