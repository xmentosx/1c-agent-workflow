ПодключитьСценарий(КаталогФикстуры + "/vanessa.os", "ТестоваяВанесса");
Ванесса = Новый ТестоваяВанесса;
Ванесса.Завершено = Ложь; Ванесса.ОшибкаРезультата = "";
КонтекстСохраняемый = Новый Структура;
КонтекстСохраняемый.Вставить("_СписокPIDКлиентовСМониторингомСобытий", Новый Соответствие);
КонтекстСохраняемый.Вставить("_ИмяПеременнойРезультатаСобытия", "Value");
Сценарий = АргументыКоманднойСтроки[0];
Каталог = АргументыКоманднойСтроки[1];
КаталогА = Каталог + "/Клиент А"; СоздатьКаталог(КаталогА);
КаталогБ = Каталог + "/Клиент Б"; СоздатьКаталог(КаталогБ);
ПрофильА = Новый Структура("PIDКлиентаТестирования,ИмяКомпьютера,ПортЗапускаТестКлиента,ПутьКИнфобазе", 0, "localhost", 20001, "/F base-a");
ПрофильБ = Новый Структура("PIDКлиентаТестирования,ИмяКомпьютера,ПортЗапускаТестКлиента,ПутьКИнфобазе", 0, "localhost", 20002, "/F base-b");
Ванесса.ТекущийПрофиль = ПрофильА; КлючА = ITLКлючКлиентаМониторинга();
Ванесса.ТекущийПрофиль = ПрофильБ; КлючБ = ITLКлючКлиентаМониторинга();
Если КлючА = КлючБ Тогда ВызватьИсключение "ZERO_PID_CONNECTIONS_COLLIDED"; КонецЕсли;
КонтекстСохраняемый._СписокPIDКлиентовСМониторингомСобытий.Вставить(КлючА, КаталогА);
Если Сценарий <> "identity-foreign-send" Тогда КонтекстСохраняемый._СписокPIDКлиентовСМониторингомСобытий.Вставить(КлючБ, КаталогБ); КонецЕсли;
Если Сценарий = "identity-foreign-send" Тогда
    ЯВыполняюКодВстроенногоЯзыкаЧерезФайлСобытияРасширениеСлужебный("Результат = ""B"";", Истина);
    ВызватьИсключение "FOREIGN_MONITOR_USED";
КонецЕсли;
Если Сценарий = "identity-missing-endpoint" Тогда
    ПрофильБ.ПортЗапускаТестКлиента = 0; ПрофильБ.PIDКлиентаТестирования = 9001;
    ITLКлючКлиентаМониторинга();
    ВызватьИсключение "MISSING_ENDPOINT_ACCEPTED";
КонецЕсли;
Ванесса.ТекущийПрофиль = ПрофильА;
ОжидаемоеЗначение = "A"; КаталогНазначения = КаталогА; ЧужойКаталог = КаталогБ;
Если Сценарий = "identity-selected-route" Тогда
    Ванесса.ТекущийПрофиль = ПрофильБ;
    ОжидаемоеЗначение = "B"; КаталогНазначения = КаталогБ; ЧужойКаталог = КаталогА;
КонецЕсли;
Если Сценарий = "identity-pid-becomes-known" Тогда
    ПрофильА.PIDКлиентаТестирования = 9001;
    Если КлючА <> ITLКлючКлиентаМониторинга() Тогда ВызватьИсключение "PID_CHANGED_CHANNEL_IDENTITY"; КонецЕсли;
КонецЕсли;
Если Сценарий = "identity-host-case" Тогда
    ПрофильА.ИмяКомпьютера = " LOCALHOST ";
    Если КлючА <> ITLКлючКлиентаМониторинга() Тогда ВызватьИсключение "HOST_CASE_CHANGED_IDENTITY"; КонецЕсли;
КонецЕсли;
ЯВыполняюКодВстроенногоЯзыкаЧерезФайлСобытияРасширениеСлужебный("Результат = """ + ОжидаемоеЗначение + """;", Истина);
ИмяСобытия = КонтекстСохраняемый._ИмяФайлаПоследнегоСобытия;
Если НайтиФайлы(ЧужойКаталог, "Event_ITL_*.json").Количество() <> 0 Тогда ВызватьИсключение "WRONG_CLIENT_DISPATCH"; КонецЕсли;
Если НайтиФайлы(КаталогНазначения, "Event_ITL_*.json").Количество() <> 1 Тогда ВызватьИсключение "OWN_REQUEST_MISSING"; КонецЕсли;
Если Сценарий = "identity-foreign-wait" Тогда Ванесса.ТекущийПрофиль = ПрофильБ; КонецЕсли;
ЯОжидаюСекундРезультатОбработкиПоследнегоСобытияЧерезФайлИЗапоминаюРезультатВПеременнуюРасширение(20, "Value");
Если Сценарий = "identity-foreign-wait" Тогда ВызватьИсключение "FOREIGN_WAIT_ACCEPTED"; КонецЕсли;
Если Сценарий = "identity-switch-during-wait" Тогда Ванесса.ТекущийПрофиль = ПрофильБ; КонецЕсли;
VAExtension_ITLОбработатьФайлКода(Новый Файл(ИмяСобытия));
ЯЖдуРезультатПоследнегоСобытияЧерезФайлОбработчикОжидания();
Если НЕ Ванесса.Завершено Или Ванесса.ОшибкаРезультата <> "" Тогда ВызватьИсключение "OWN_WAIT_FAILED: " + Ванесса.ОшибкаРезультата; КонецЕсли;
Если Ванесса.ЗначениеРезультата <> ОжидаемоеЗначение Тогда ВызватьИсключение "WRONG_CLIENT_REPLY"; КонецЕсли;
Если КонтекстСохраняемый.Свойство("_ITLНеподтвержденнаяКоманда") Тогда ВызватьИсключение "OWN_COMPLETION_NOT_CONSUMED"; КонецЕсли;
Сообщить("CLIENT_IDENTITY_CASE_PASSED: " + Сценарий);
