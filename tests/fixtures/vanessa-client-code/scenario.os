ПодключитьСценарий(КаталогФикстуры + "/vanessa.os", "ТестоваяВанесса");
Ванесса = Новый ТестоваяВанесса;
Ванесса.Завершено = Ложь;
Ванесса.ОшибкаРезультата = "";
КонтекстСохраняемый = Новый Структура;
Сценарий = АргументыКоманднойСтроки[0];
Каталог = АргументыКоманднойСтроки[1];
Если Лев(Сценарий, 7) = "legacy-" Тогда
    ПодключитьСценарий(КаталогФикстуры + "/json-helper.os", "ТестовыйJSON");
    VAExtensionОбщегоНазначения = Новый ТестовыйJSON;
    VAExtension_КаталогиМониторинга = Новый Массив;
    VAExtension_КаталогиМониторинга.Добавить(Каталог);
    Код = "СчетчикВызовов = СчетчикВызовов + 1;";
    Если Сценарий = "legacy-failed" Тогда Код = Код + " ВызватьИсключение ""BUSINESS_ERROR"";"; КонецЕсли;
    ИмяСобытия = Каталог + "/Event_RC_" + Строка(Новый УникальныйИдентификатор) + ".json";
    Запись = Новый ЗаписьJSON; Запись.ОткрытьФайл(ИмяСобытия);
    ЗаписатьJSON(Запись, Новый Структура("ВидСобытия,Данные", "ВыполнитьКодНаКлиенте", Код)); Запись.Закрыть();
    VAExtension_ПроверкаКаталогаНаНовыеСобытия();
    Если СчетчикВызовов <> 1 Тогда ВызватьИсключение "ORIGINAL_ACTION_NOT_REACHED"; КонецЕсли;
    Если Новый Файл(ИмяСобытия).Существует() Тогда ВызватьИсключение "ORIGINAL_REQUEST_NOT_CONSUMED"; КонецЕсли;
    Если НайтиФайлы(Каталог, "Result*.json").Количество() <> 0 Тогда ВызватьИсключение "ORIGINAL_REPLY_EXISTS"; КонецЕсли;
    Сообщить("UPSTREAM_REPLY_LOST: " + Сценарий);
    ЗавершитьРаботу(0);
КонецЕсли;
Если Сценарий = "consume" Тогда
    VAExtension_ITLОбработатьФайлКода(Новый Файл(Каталог));
    Сообщить("CLIENT_CODE_CONSUMER_FINISHED");
    ЗавершитьРаботу(0);
КонецЕсли;
Если Сценарий = "no-monitor" Тогда
    ЯВыполняюКодВстроенногоЯзыкаЧерезФайлСобытияРасширениеСлужебный("", Истина);
    Сообщить("UPSTREAM_FALSE_SUCCESS");
    ЗавершитьРаботу(0);
КонецЕсли;
КонтекстСохраняемый.Вставить("_СписокPIDКлиентовСМониторингомСобытий", Новый Соответствие);
Если Сценарий = "wrong-client" Тогда
    ЯВыполняюКодВстроенногоЯзыкаЧерезФайлСобытияРасширениеСлужебный("", Истина);
    Сообщить("UPSTREAM_FALSE_SUCCESS");
    ЗавершитьРаботу(0);
КонецЕсли;
КлючКлиентаДляПробы = 12345;
КонтекстСохраняемый._СписокPIDКлиентовСМониторингомСобытий.Вставить(КлючКлиентаДляПробы, Каталог);
КонтекстСохраняемый.Вставить("_ИмяПеременнойРезультатаСобытия", "Результат");
Код = "СчетчикВызовов = СчетчикВызовов + 1;";
Если Сценарий = "value" Тогда Код = Код + " Результат = 42;"; КонецЕсли;
Если Сценарий = "failed" Или Сценарий = "repeat-failed" Тогда Код = Код + " ВызватьИсключение ""BUSINESS_ERROR"";"; КонецЕсли;
Если Сценарий = "multiline" Тогда
    Код = Новый Массив;
    Код.Добавить("СчетчикВызовов = СчетчикВызовов + 1;");
    Код.Добавить("Результат = 42;");
КонецЕсли;
ЯВыполняюКодВстроенногоЯзыкаЧерезФайлСобытияРасширениеСлужебный(Код, Истина);
ИмяСобытия = КонтекстСохраняемый._ИмяФайлаПоследнегоСобытия;
ФайлСобытия = Новый Файл(ИмяСобытия);
Если НЕ ФайлСобытия.Существует() Или Новый Файл(ИмяСобытия + ".tmp").Существует() Тогда ВызватьИсключение "REQUEST_NOT_ATOMICALLY_PUBLISHED"; КонецЕсли;
Если Сценарий = "pending" Тогда
    ЯВыполняюКодВстроенногоЯзыкаЧерезФайлСобытияРасширениеСлужебный(Код, Истина);
    ВызватьИсключение "PENDING_REQUEST_REPLACED";
КонецЕсли;
Идентификатор = Сред(ФайлСобытия.Имя, 11, 36);
ИмяРезультата = ФайлСобытия.Путь + "Result_ITL_" + Идентификатор + ".json";
Если Сценарий = "malformed" Тогда
    Запись = Новый ЗаписьТекста(ИмяСобытия, КодировкаТекста.UTF8);
    Запись.Записать("{broken"); Запись.Закрыть();
КонецЕсли;
Если Сценарий = "publish-failure" Тогда СоздатьКаталог(ИмяРезультата); КонецЕсли;
Если Сценарий <> "timeout" Тогда
    VAExtension_ITLОбработатьФайлКода(ФайлСобытия);
    VAExtension_ITLОбработатьФайлКода(ФайлСобытия);
КонецЕсли;
Если Сценарий = "publish-failure" Тогда
    Если СчетчикВызовов <> 1 Тогда ВызватьИсключение "FAILED_REPLY_REPLAYED_CODE"; КонецЕсли;
    Если НЕ КонтекстСохраняемый.Свойство("_ITLНеподтвержденнаяКоманда") Тогда ВызватьИсключение "UNKNOWN_COMPLETION_FORGOTTEN"; КонецЕсли;
    Сообщить("CLIENT_CODE_CASE_PASSED: " + Сценарий);
    ЗавершитьРаботу(0);
КонецЕсли;
Если Сценарий = "wrong-response" Тогда
    Запись = Новый ЗаписьJSON;
    Запись.ОткрытьФайл(ИмяРезультата);
    ЗаписатьJSON(Запись, Новый Структура("protocol,id,status,value,error", "itl-file-code-v1", Строка(Новый УникальныйИдентификатор), "succeeded", 42, ""));
    Запись.Закрыть();
КонецЕсли;
ДатаНачалаОбработкиОжидания = ТекущаяДата() - 20;
КоличествоСекундОбработкаОжидания = 1;
ITLОжидатьРезультатКоманды("unused-test-handler");
Если Сценарий = "repeat-failed" Тогда
    Ванесса.Завершено = Ложь;
    Ванесса.ОшибкаРезультата = "";
    ЯЖдуРезультатПоследнегоСобытияЧерезФайлОбработчикОжидания();
КонецЕсли;
Если НЕ Ванесса.Завершено Тогда ВызватьИсключение "STEP_NEVER_COMPLETED"; КонецЕсли;
Если Сценарий = "timeout" Или Сценарий = "wrong-response" Тогда
    КодОшибки = ?(Сценарий = "timeout", "ITL_CLIENT_CODE_COMPLETION_UNKNOWN", "ITL_CLIENT_CODE_RESPONSE_IDENTITY_MISMATCH");
    Если Найти(Ванесса.ОшибкаРезультата, КодОшибки) = 0 Тогда ВызватьИсключение "FALSE_SUCCESS_WITHOUT_OWN_RESULT"; КонецЕсли;
    Если НЕ КонтекстСохраняемый.Свойство("_ITLНеподтвержденнаяКоманда") Тогда ВызватьИсключение "UNKNOWN_COMPLETION_FORGOTTEN"; КонецЕсли;
Иначе
    Если КонтекстСохраняемый.Свойство("_ITLНеподтвержденнаяКоманда") Тогда ВызватьИсключение "CONFIRMED_REPLY_NOT_CONSUMED"; КонецЕсли;
    Если Сценарий = "failed" Или Сценарий = "repeat-failed" Или Сценарий = "malformed" Тогда
        Если Найти(Ванесса.ОшибкаРезультата, "ITL_CLIENT_CODE_EXECUTION_FAILED") = 0 Тогда ВызватьИсключение "FALSE_SUCCESS_AFTER_FAILURE"; КонецЕсли;
        Если Сценарий = "failed" И Найти(Ванесса.ОшибкаРезультата, "BUSINESS_ERROR") = 0 Тогда ВызватьИсключение "BUSINESS_ERROR_LOST"; КонецЕсли;
    Иначе
        Если Ванесса.ОшибкаРезультата <> "" Тогда ВызватьИсключение Ванесса.ОшибкаРезультата; КонецЕсли;
        Если (Сценарий = "value" Или Сценарий = "multiline") И Ванесса.ЗначениеРезультата <> 42 Тогда ВызватьИсключение "RETURN_VALUE_LOST"; КонецЕсли;
    КонецЕсли;
КонецЕсли;
ОжидаемыеВызовы = ?(Сценарий = "malformed" Или Сценарий = "timeout", 0, 1);
Если СчетчикВызовов <> ОжидаемыеВызовы Тогда ВызватьИсключение "EXECUTION_COUNT_MISMATCH"; КонецЕсли;
Сообщить("CLIENT_CODE_CASE_PASSED: " + Сценарий);
