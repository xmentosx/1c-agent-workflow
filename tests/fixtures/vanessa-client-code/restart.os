ПодключитьСценарий(КаталогФикстуры + "/vanessa.os", "ТестоваяВанесса");
Ванесса = Новый ТестоваяВанесса;
Ванесса.Завершено = Ложь; Ванесса.ОшибкаРезультата = "";
Сценарий = АргументыКоманднойСтроки[0];
БазовыйКаталог = АргументыКоманднойСтроки[1];
ПрофильА = Новый Структура("PIDКлиентаТестирования,ИмяКомпьютера,ПортЗапускаТестКлиента,ПутьКИнфобазе", 0, "localhost", 21001, "/F restart-a");
ПрофильБ = Новый Структура("PIDКлиентаТестирования,ИмяКомпьютера,ПортЗапускаТестКлиента,ПутьКИнфобазе", 0, "localhost", 21002, "/F restart-b");
Ванесса.ТекущийПрофиль = ПрофильА;
КлючА = ITLКлючКлиентаМониторинга();
КонтекстСохраняемый = Новый Структура;
КонтекстСохраняемый.Вставить("_СписокPIDКлиентовСМониторингомСобытий", Новый Соответствие);
КаталогКанала = ITLПодготовитьКаталогКанала(БазовыйКаталог, КлючА);
КонтекстСохраняемый._СписокPIDКлиентовСМониторингомСобытий.Вставить(КлючА, КаталогКанала);
ITLИнициализироватьПоследнееСобытиеКанала();
Если КонтекстСохраняемый._ИмяФайлаПоследнегоСобытия <> "" Тогда ВызватьИсключение "NEW_CHANNEL_LAST_EVENT_NOT_EMPTY"; КонецЕсли;
Код = "СчетчикВызовов = СчетчикВызовов + 1; Результат = 42;";
ЯВыполняюКодВстроенногоЯзыкаЧерезФайлСобытияРасширениеСлужебный(Код, Истина);
ИмяСобытия = КонтекстСохраняемый._ИмяФайлаПоследнегоСобытия;

Если Сценарий = "restart-terminal" Тогда
    VAExtension_ITLОбработатьФайлКода(Новый Файл(ИмяСобытия));
ИначеЕсли Сценарий = "restart-unpublished" Тогда
    УдалитьФайлы(ИмяСобытия);
ИначеЕсли Сценарий = "restart-claimed-unknown" Тогда
    Захват = Новый ФайловыйПоток(ITLИмяФайлаЗапроса(ИмяСобытия, "Claim"), РежимОткрытияФайла.СоздатьНовый);
    Захват.Закрыть();
ИначеЕсли Сценарий = "restart-ambiguous" Тогда
    ДругойКаталог = БазовыйКаталог + "/itl-" + Строка(Новый УникальныйИдентификатор) + "/events";
    Ванесса.СоздатьКаталогКомандаСистемы(ДругойКаталог);
    ITLЗаписатьJSONАтомарно(ДругойКаталог + "/Channel_ITL.json", Новый Структура("protocol,owner", "itl-file-code-channel-v1", КлючА));
    ДругойИдентификатор = Строка(Новый УникальныйИдентификатор);
    ДругойЗапрос = ДругойКаталог + "/Event_ITL_" + ДругойИдентификатор + ".json";
    ITLЗаписатьJSONАтомарно(ITLИмяФайлаЗапроса(ДругойЗапрос, "Pending"),
        Новый Структура("protocol,id,owner,target,code", "itl-file-code-request-v1", ДругойИдентификатор, КлючА, "client", Код));
КонецЕсли;

// Simulate a fresh Vanessa producer with no in-memory request state.
КонтекстСохраняемый = Новый Структура;
КонтекстСохраняемый.Вставить("_СписокPIDКлиентовСМониторингомСобытий", Новый Соответствие);
Если Сценарий = "restart-foreign-owner" Тогда
    Ванесса.ТекущийПрофиль = ПрофильБ;
    КлючБ = ITLКлючКлиентаМониторинга();
    ЧужойКаталог = ITLПодготовитьКаталогКанала(БазовыйКаталог, КлючБ);
    Если ЧужойКаталог = КаталогКанала Тогда ВызватьИсключение "FOREIGN_OWNER_RECOVERED_CHANNEL"; КонецЕсли;
    Сообщить("CLIENT_RESTART_CASE_PASSED: " + Сценарий);
    ЗавершитьРаботу(0);
КонецЕсли;

ВосстановленныйКаталог = ITLПодготовитьКаталогКанала(БазовыйКаталог, КлючА);
Если ВосстановленныйКаталог <> КаталогКанала Тогда ВызватьИсключение "PENDING_CHANNEL_NOT_RECOVERED: " + КаталогКанала + " | " + ВосстановленныйКаталог; КонецЕсли;
КонтекстСохраняемый._СписокPIDКлиентовСМониторингомСобытий.Вставить(КлючА, ВосстановленныйКаталог);
ITLИнициализироватьПоследнееСобытиеКанала();
Если Новый Файл(КонтекстСохраняемый._ИмяФайлаПоследнегоСобытия).ПолноеИмя <> Новый Файл(ИмяСобытия).ПолноеИмя Тогда
    ВызватьИсключение "RECOVERED_LAST_EVENT_WAS_RESET: actual=" + КонтекстСохраняемый._ИмяФайлаПоследнегоСобытия + "; expected=" + ИмяСобытия;
КонецЕсли;
Если Сценарий = "restart-changed-command" Тогда
    ЯВыполняюКодВстроенногоЯзыкаЧерезФайлСобытияРасширениеСлужебный(Код + " Сообщить(1);", Истина);
    ВызватьИсключение "CHANGED_COMMAND_REPLAYED";
КонецЕсли;

ЯВыполняюКодВстроенногоЯзыкаЧерезФайлСобытияРасширениеСлужебный(Код, Истина);
Если НайтиФайлы(БазовыйКаталог, "Event_ITL_*.json", Истина).Количество() <> 1 Тогда
    ВызватьИсключение "RESTART_DUPLICATED_REQUEST";
КонецЕсли;
Если Сценарий = "restart-unclaimed" Или Сценарий = "restart-unpublished" Тогда
    VAExtension_ITLОбработатьФайлКода(Новый Файл(ИмяСобытия));
КонецЕсли;

КонтекстСохраняемый.Вставить("_ИмяПеременнойРезультатаСобытия", "Value");
ДатаНачалаОбработкиОжидания = ТекущаяДата();
КоличествоСекундОбработкаОжидания = 10;
Если Сценарий = "restart-claimed-unknown" Тогда
    ДатаНачалаОбработкиОжидания = ТекущаяДата() - 20;
    КоличествоСекундОбработкаОжидания = 1;
КонецЕсли;
ITLОжидатьРезультатКоманды("restart-handler");
Если Сценарий = "restart-claimed-unknown" Тогда
    Если Найти(Ванесса.ОшибкаРезультата, "ITL_CLIENT_CODE_COMPLETION_UNKNOWN") = 0 Тогда ВызватьИсключение "CLAIMED_REQUEST_REPLAYED"; КонецЕсли;
    Если СчетчикВызовов <> 0 Тогда ВызватьИсключение "CLAIMED_CODE_EXECUTED_AGAIN"; КонецЕсли;
    Если ITLОчиститьЗавершенныйКаталогКанала(КаталогКанала, КлючА) Тогда ВызватьИсключение "UNACKNOWLEDGED_CHANNEL_WAS_DELETED"; КонецЕсли;
    Если НЕ Новый Файл(КаталогКанала).Существует() Тогда ВызватьИсключение "UNACKNOWLEDGED_CHANNEL_WAS_DELETED"; КонецЕсли;
    Сообщить("CLIENT_RESTART_CASE_PASSED: " + Сценарий);
    ЗавершитьРаботу(0);
КонецЕсли;
Если НЕ Ванесса.Завершено Или Ванесса.ОшибкаРезультата <> "" Тогда ВызватьИсключение "RECOVERED_WAIT_FAILED: " + Ванесса.ОшибкаРезультата; КонецЕсли;
Если Ванесса.ЗначениеРезультата <> 42 Тогда ВызватьИсключение "RECOVERED_VALUE_LOST"; КонецЕсли;
Если СчетчикВызовов <> 1 Тогда ВызватьИсключение "RECOVERED_CODE_EXECUTION_COUNT_MISMATCH"; КонецЕсли;
Если НЕ Новый Файл(ITLИмяФайлаЗапроса(ИмяСобытия, "Ack")).Существует() Тогда ВызватьИсключение "RECOVERED_RESULT_NOT_ACKNOWLEDGED"; КонецЕсли;

КонтекстСохраняемый = Новый Структура;
КонтекстСохраняемый.Вставить("_СписокPIDКлиентовСМониторингомСобытий", Новый Соответствие);
СледующийКаталог = ITLПодготовитьКаталогКанала(БазовыйКаталог, КлючА);
Если СледующийКаталог = КаталогКанала Тогда ВызватьИсключение "ACKNOWLEDGED_CHANNEL_RECOVERED_AGAIN"; КонецЕсли;
Если Новый Файл(КаталогКанала).Существует() Тогда ВызватьИсключение "ACKNOWLEDGED_CHANNEL_NOT_CLEANED"; КонецЕсли;
Если НайтиФайлы(БазовыйКаталог, "itl-*", Ложь).Количество() <> 1 Тогда ВызватьИсключение "ACKNOWLEDGED_GENERATION_CONTAINER_NOT_CLEANED"; КонецЕсли;
Сообщить("CLIENT_RESTART_CASE_PASSED: " + Сценарий);
