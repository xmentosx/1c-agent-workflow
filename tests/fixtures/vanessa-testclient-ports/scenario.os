Перем Объект;
Перем ПортыКоторыеСчитаютсяЗанятыми;
Перем ДанныеКлиентовТестирования;
Перем ЭтоLinux;
Перем ЗанятыеНативныеПорты;

Функция Локализовать(Текст)
    Возврат Текст;
КонецФункции
Функция ПодставитьПараметрыВСтроку(Текст, Значение)
    Возврат СтрЗаменить(Текст, "%1", Строка(Значение));
КонецФункции
Функция РазложитьСтрокуВМассивПодстрокКлиент(Текст, Разделитель)
    Возврат СтрРазделить(Текст, Разделитель);
КонецФункции
Функция _СтрРазделить(Текст, Разделитель)
    Возврат СтрРазделить(Текст, Разделитель);
КонецФункции
Процедура ЗаписатьЛогВЖРИнформация(Источник, Текст)
КонецПроцедуры
Процедура ЗаписатьЛогВЖРОшибка(Источник, Текст)
КонецПроцедуры
Функция ФайлСуществуетКомандаСистемы(Путь)
    Возврат Новый Файл(Путь).Существует();
КонецФункции
Процедура ВыполнитьКомандуОС(Команда, Парам2 = Неопределено, Парам3 = Неопределено, Парам4 = Неопределено)
    ВызватьИсключение "Unexpected Linux branch in Windows port probe";
КонецПроцедуры
Процедура ВыполнитьКомандуОСБезПоказаЧерногоОкна(Команда)
    Путь = Сред(Команда, СтрНайти(Команда, "> ") + 2);
    Путь = СтрЗаменить(Путь, """", "");
    Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
    Для Каждого Порт Из ЗанятыеНативныеПорты Цикл
        Запись.ЗаписатьСтроку("  TCP    127.0.0.1:" + Строка(Порт) + "       0.0.0.0:0              LISTENING       1234");
    КонецЦикла;
    Запись.Закрыть();
КонецПроцедуры

// PRODUCTION_FUNCTIONS

Объект = Новый Структура("ДиапазонПортовTestclient", "48000-48001");
ЭтоLinux = Ложь;
ПортыКоторыеСчитаютсяЗанятыми = Новый Соответствие;
ДанныеКлиентовТестирования = Новый Массив;
ДанныеКлиентовТестирования.Добавить(Новый Структура("Имя,ПортЗапускаТестКлиента", "A", 48000));
ДанныеКлиентовТестирования.Добавить(Новый Структура("Имя,ПортЗапускаТестКлиента", "B", 48001));
ЗанятыеНативныеПорты = Новый Массив;
Сценарий = АргументыКоманднойСтроки[0];
Если Сценарий = "baseline" Тогда
    ЗанятыеНативныеПорты.Добавить(48000);
    Порт = ПроверитьПортНаЗанятость(48001);
    Если Порт <> 48000 Тогда ВызватьИсключение "ORIGINAL_WRONG_PORT_NOT_REPRODUCED"; КонецЕсли;
    Сообщить("ORIGINAL_BUSY_PORT_RETURNED");
Иначе
    Если Сценарий = "native-busy" Или Сценарий = "exhausted" Тогда ЗанятыеНативныеПорты.Добавить(48001); КонецЕсли;
    Если Сценарий = "own-free" Или Сценарий = "exhausted" Тогда ЗанятыеНативныеПорты.Добавить(48000); КонецЕсли;
    Если Сценарий = "native-busy" Тогда ДанныеКлиентовТестирования.Очистить(); КонецЕсли;
    ПортЗапроса = 48001;
    Если Сценарий = "foreign-reserved" Тогда ПортЗапроса = 48000; КонецЕсли;
    Если Сценарий = "exhausted" Тогда
        Попытка
            ПроверитьПортНаЗанятость(ПортЗапроса, "B");
        Исключение
            Если СтрНайти(ОписаниеОшибки(), "ITL_TESTCLIENT_NO_FREE_PORT") = 0 Тогда ВызватьИсключение; КонецЕсли;
            Сообщить("PORT_CASE_PASSED: exhausted");
            ЗавершитьРаботу(0);
        КонецПопытки;
        ВызватьИсключение "EXHAUSTED_RANGE_ACCEPTED";
    КонецЕсли;
    Порт = ПроверитьПортНаЗанятость(ПортЗапроса, "B");
    ОжидаемыйПорт = 48001;
    Если Сценарий = "native-busy" Тогда ОжидаемыйПорт = 48000; КонецЕсли;
    Если Порт <> ОжидаемыйПорт Тогда ВызватьИсключение "WRONG_PORT: " + Строка(Порт); КонецЕсли;
    Сообщить("PORT_CASE_PASSED: " + Сценарий);
КонецЕсли;
