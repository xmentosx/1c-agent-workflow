// Framework double for the 1.2.043.42 TestClient port functions. Only the native
// command boundary is simulated: netstat -ano and ss -ltn print the socket table.
Перем Объект Экспорт;
Перем ЭтоLinux Экспорт;
Перем ДанныеКлиентовТестирования Экспорт;
Перем ПортыКоторыеСчитаютсяЗанятыми Экспорт;
Перем Сокеты Экспорт;
Перем Модуль Экспорт;
Перем Команды Экспорт;

Функция МодульОбщегоНазначенияVA() Экспорт
    Возврат Модуль;
КонецФункции

Функция Локализовать(Текст) Экспорт
    Возврат Текст;
КонецФункции

Функция ПодставитьПараметрыВСтроку(Текст, Значение) Экспорт
    Возврат СтрЗаменить(Текст, "%1", Строка(Значение));
КонецФункции

Функция РазложитьСтрокуВМассивПодстрокКлиент(Текст, Разделитель) Экспорт
    Возврат СтрРазделить(Текст, Разделитель);
КонецФункции

Функция _СтрРазделить(Текст, Разделитель) Экспорт
    Возврат СтрРазделить(Текст, Разделитель);
КонецФункции

Процедура ЗаписатьЛогВЖРИнформация(Источник, Текст) Экспорт
КонецПроцедуры

Процедура ЗаписатьЛогВЖРОшибка(Источник, Текст) Экспорт
КонецПроцедуры

Функция ФайлСуществуетКомандаСистемы(Путь) Экспорт
    Возврат Новый Файл(Путь).Существует();
КонецФункции

Функция Колонка(Текст, Ширина)
    Результат = Текст;
    Пока СтрДлина(Результат) < Ширина Цикл
        Результат = Результат + " ";
    КонецЦикла;
    Возврат Результат + " ";
КонецФункции

// netstat -ano of a Russian Windows: localized headers and states, one row per socket.
Процедура ВыполнитьКомандуОСБезПоказаЧерногоОкна(Команда) Экспорт
    Если ЭтоLinux Тогда ВызватьИсключение "UNEXPECTED_WINDOWS_COMMAND: " + Команда; КонецЕсли;
    Если СтрНайти(Команда, "netstat -ano > ") <> 1 Тогда ВызватьИсключение "UNEXPECTED_NETSTAT_COMMAND: " + Команда; КонецЕсли;
    Команды.Добавить(Команда);
    Путь = СтрЗаменить(Сред(Команда, СтрДлина("netstat -ano > ") + 1), """", "");
    Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
    Запись.ЗаписатьСтроку("");
    Запись.ЗаписатьСтроку("Активные подключения");
    Запись.ЗаписатьСтроку("");
    Запись.ЗаписатьСтроку("  Имя    Локальный адрес        Внешний адрес          Состояние       PID");
    Для Каждого Сокет Из Сокеты Цикл
        Запись.ЗаписатьСтроку("  " + Колонка(Сокет.Протокол, 6) + Колонка(Сокет.Локальный, 22)
            + Колонка(Сокет.Внешний, 22) + Колонка(Сокет.СостояниеWindows, 15) + "4242");
    КонецЦикла;
    Запись.Закрыть();
КонецПроцедуры

// ss -ltn prints its header and the listening TCP sockets only.
Процедура ВыполнитьКомандуОС(Команда) Экспорт
    Если НЕ ЭтоLinux Тогда ВызватьИсключение "UNEXPECTED_LINUX_COMMAND: " + Команда; КонецЕсли;
    Начало = "/bin/sh -c ""ss -ltn > '";
    Если СтрНайти(Команда, Начало) <> 1 Или СтрНайти(Команда, "' 2>/dev/null""") = 0 Тогда
        ВызватьИсключение "UNEXPECTED_SS_COMMAND: " + Команда;
    КонецЕсли;
    Команды.Добавить(Команда);
    Путь = Сред(Команда, СтрДлина(Начало) + 1);
    Путь = Лев(Путь, СтрНайти(Путь, "'") - 1);
    Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
    Запись.ЗаписатьСтроку("State  Recv-Q Send-Q Local Address:Port  Peer Address:Port Process");
    Для Каждого Сокет Из Сокеты Цикл
        Если Сокет.Протокол = "TCP" И Сокет.СостояниеLinux = "LISTEN" Тогда
            Запись.ЗаписатьСтроку(Колонка("LISTEN", 6) + Колонка("0", 6) + Колонка("4096", 6)
                + Колонка(Сокет.Локальный, 20) + "0.0.0.0:*");
        КонецЕсли;
    КонецЦикла;
    Запись.Закрыть();
КонецПроцедуры

Процедура ПриСозданииОбъекта()
    Объект = Новый Структура("ДиапазонПортовTestclient", "48000-48001");
    ЭтоLinux = Ложь;
    ДанныеКлиентовТестирования = Новый Массив;
    ПортыКоторыеСчитаютсяЗанятыми = Новый Соответствие;
    Сокеты = Новый Массив;
    Команды = Новый Массив;
КонецПроцедуры
