Перем Ванесса;

// PRODUCTION_FUNCTIONS

Процедура Проверить(Условие, Код)
    Если НЕ Условие Тогда ВызватьИсключение Код; КонецЕсли;
КонецПроцедуры

Процедура ДобавитьСокет(Протокол, Локальный, Внешний, СостояниеWindows, СостояниеLinux)
    Ванесса.Сокеты.Добавить(Новый Структура("Протокол,Локальный,Внешний,СостояниеWindows,СостояниеLinux",
        Протокол, Локальный, Внешний, СостояниеWindows, СостояниеLinux));
КонецПроцедуры

Функция ОшибкаВыделенияПорта()
    Попытка
        Порт = ПроверитьПортНаЗанятость(48001, "B");
    Исключение
        Возврат ОписаниеОшибки();
    КонецПопытки;
    Возврат "PORT_RETURNED: " + Строка(Порт);
КонецФункции

Сценарий = АргументыКоманднойСтроки[0];
ПодключитьСценарий(АргументыКоманднойСтроки[1], "ТестоваяВанесса");
Ванесса = Новый ТестоваяВанесса;
Ванесса.Модуль = ЭтотОбъект;
Ванесса.ЭтоLinux = СтрНайти(Сценарий, "linux-") = 1;

// Two profiles share a two-port range. Client A keeps listening on its port; client B
// was closed normally and is restarted on its assigned port 48001 (PM5 1-branch4).
Ванесса.ДанныеКлиентовТестирования.Добавить(Новый Структура("Имя,ПортЗапускаТестКлиента", "A", 48000));
Ванесса.ДанныеКлиентовТестирования.Добавить(Новый Структура("Имя,ПортЗапускаТестКлиента", "B", 48001));
ДобавитьСокет("TCP", "0.0.0.0:48000", "0.0.0.0:0", "LISTENING", "LISTEN");
ДобавитьСокет("TCP", "127.0.0.1:52000", "127.0.0.1:48000", "ESTABLISHED", "ESTAB");

Если Сценарий = "time-wait" Или Сценарий = "baseline-time-wait" Или Сценарий = "linux-time-wait" Тогда
    ДобавитьСокет("TCP", "127.0.0.1:48001", "127.0.0.1:52011", "TIME_WAIT", "TIME-WAIT");
ИначеЕсли Сценарий = "established" Тогда
    ДобавитьСокет("TCP", "127.0.0.1:48001", "127.0.0.1:52012", "ESTABLISHED", "ESTAB");
    ДобавитьСокет("TCP", "127.0.0.1:52012", "127.0.0.1:48001", "ESTABLISHED", "ESTAB");
ИначеЕсли Сценарий = "close-wait" Тогда
    ДобавитьСокет("TCP", "127.0.0.1:48001", "127.0.0.1:52013", "CLOSE_WAIT", "CLOSE-WAIT");
ИначеЕсли Сценарий = "udp" Тогда
    ДобавитьСокет("UDP", "0.0.0.0:48001", "*:*", "", "UNCONN");
ИначеЕсли Сценарий = "listening" Или Сценарий = "linux-listening" Тогда
    ДобавитьСокет("TCP", "0.0.0.0:48001", "0.0.0.0:0", "LISTENING", "LISTEN");
ИначеЕсли Сценарий = "listening-ipv6" Тогда
    ДобавитьСокет("TCP", "[::]:48001", "[::]:0", "LISTENING", "LISTEN");
ИначеЕсли Сценарий = "listening-localized" Тогда
    // The state column is localized; the unspecified foreign address is not.
    ДобавитьСокет("TCP", "127.0.0.1:48001", "0.0.0.0:0", "ПРОСЛУШИВАНИЕ", "LISTEN");
Иначе
    ВызватьИсключение "UNKNOWN_CASE: " + Сценарий;
КонецЕсли;

Занятые = ПолучитьМассивЗанятыхПортов("B");
Проверить(Ванесса.Команды.Количество() = 1, "NATIVE_COMMAND_NOT_USED");
Проверить(Занятые.Найти(48000) <> Неопределено, "FOREIGN_LISTENER_OR_RESERVATION_LOST");
Если Сценарий = "baseline-time-wait" Тогда
    // r11 counts every netstat row, so a closed client's TIME_WAIT keeps its port busy.
    Ошибка = ОшибкаВыделенияПорта();
    Проверить(СтрНайти(Ошибка, "ITL_TESTCLIENT_NO_FREE_PORT") > 0, "ORIGINAL_TIME_WAIT_NOT_REPRODUCED: " + Ошибка);
    Сообщить("ORIGINAL_TIME_WAIT_REJECTED");
ИначеЕсли СтрНайти(Сценарий, "listening") > 0 Тогда
    Проверить(Занятые.Найти(48001) <> Неопределено, "LISTENER_NOT_OCCUPIED");
    Ошибка = ОшибкаВыделенияПорта();
    Проверить(СтрНайти(Ошибка, "ITL_TESTCLIENT_NO_FREE_PORT") > 0, "LISTENING_PORT_ACCEPTED: " + Ошибка);
    Сообщить("LISTENER_CASE_PASSED: " + Сценарий);
Иначе
    Проверить(Занятые.Найти(48001) = Неопределено, "CLOSED_SOCKET_OCCUPIES_PORT");
    Порт = ПроверитьПортНаЗанятость(48001, "B");
    Проверить(Порт = 48001, "WRONG_PORT: " + Строка(Порт));
    Сообщить("LISTENER_CASE_PASSED: " + Сценарий);
КонецЕсли;
