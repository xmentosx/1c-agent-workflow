#language: ru

@template
Функционал: Изменение прикладных данных

Сценарий: Операция сохраняет ожидаемое состояние
	И я выполняю код встроенного языка на сервере (Расширение)
		"""bsl
			// Замените маркеры на менеджер и реквизиты текущей конфигурации.
			ОбъектДанных = <МенеджерОбъекта>.СоздатьЭлемент();
			ОбъектДанных.<ПолеКлюча> = "<УникальныйКлюч>";
			ОбъектДанных.Записать();
			Ссылка = ОбъектДанных.Ссылка;

			<ПроверяемаяОперация>(Ссылка);

			ПрочитанныйОбъект = Ссылка.ПолучитьОбъект();
			Если ПрочитанныйОбъект.<ПроверяемоеПоле> <> <ОжидаемоеЗначение> Тогда
				ВызватьИсключение "Операция не сохранила ожидаемое состояние";
			КонецЕсли;

			// Если требование касается движений, замените маркеры и проверьте регистр точно.
			Запрос = Новый Запрос(
				"ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество
				|ИЗ РегистрНакопления.<ИмяРегистра> КАК Движения
				|ГДЕ Движения.Регистратор = &Регистратор");
			Запрос.УстановитьПараметр("Регистратор", Ссылка);
			Если Запрос.Выполнить().Выгрузить()[0].Количество <> <ОжидаемоеКоличествоДвижений> Тогда
				ВызватьИсключение "Получено неверное количество движений регистра";
			КонецЕсли;
		"""
