&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Успешно = Ложь;
	ПараметрыКоманды = Неопределено;
	Попытка
		ПараметрыКоманды = ПрочитатьПараметрыЗапуска();
		ЗаголовокПриложения = "";
		ПараметрыКоманды.Свойство("applicationTitle", ЗаголовокПриложения);
		Результат = ВыполнитьОбновлениеНаСервере(ЗаголовокПриложения);
		ЗаписатьРезультат(ПараметрыКоманды.outputPath, ПараметрыКоманды.runId, Результат);
		Успешно = Результат.status = "passed";
	Исключение
		Ошибка = ОписаниеОшибки();
		Если ПараметрыКоманды <> Неопределено Тогда
			Попытка
				РезультатОшибки = НовыйРезультат();
				РезультатОшибки.errorMessage = Ошибка;
				РезультатОшибки.errorDetails = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ЗаписатьРезультат(ПараметрыКоманды.outputPath, ПараметрыКоманды.runId, РезультатОшибки);
			Исключение
				Сообщить(ОписаниеОшибки());
			КонецПопытки;
		Иначе
			Сообщить(Ошибка);
		КонецЕсли;
	КонецПопытки;
	ЗавершитьРаботуСистемы(Ложь,, ?(Успешно, "0", "1"));
КонецПроцедуры

&НаКлиенте
Функция ПрочитатьПараметрыЗапуска()
	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(ПараметрЗапуска, "UTF-8");
	ПараметрыКоманды = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	Если Не ЗначениеЗаполнено(ПараметрыКоманды.runId)
		Или Не ЗначениеЗаполнено(ПараметрыКоманды.outputPath) Тогда
		ВызватьИсключение "Не указаны параметры подтверждения обновления ИБ.";
	КонецЕсли;
	Возврат ПараметрыКоманды;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция НовыйРезультат()
	Возврат Новый Структура("status,updateResult,errorMessage,errorDetails,titleStatus,titleValue,titleError",
		"failed", "", "", "", "not-run", "", "");
КонецФункции

&НаСервереБезКонтекста
Функция ВыполнитьОбновлениеНаСервере(Знач ЗаголовокПриложения)
	Результат = НовыйРезультат();
	Попытка
		Результат.updateResult = ОбновлениеИнформационнойБазы.ВыполнитьОбновлениеИнформационнойБазы(Истина);
		Если Результат.updateResult = "Успешно" Или Результат.updateResult = "НеТребуется" Тогда
			ОбновлениеИнформационнойБазыСлужебный.ЗаписатьПодтверждениеЛегальностиПолученияОбновлений();
			Результат.status = "passed";
		Иначе
			Результат.errorMessage = "Обновление ИБ вернуло результат: " + Строка(Результат.updateResult);
		КонецЕсли;
	Исключение
		Результат.errorMessage = ОписаниеОшибки();
		Результат.errorDetails = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Если Результат.status = "passed" Тогда
		УстановитьЗаголовокПриложения(ЗаголовокПриложения, Результат);
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Заголовок копии ветки хранится в стандартной константе БСП ЗаголовокСистемы.
// Ошибка записи не меняет результат обновления: ITL показывает её предупреждением.
&НаСервереБезКонтекста
Процедура УстановитьЗаголовокПриложения(Знач ЗаголовокПриложения, Результат)
	Если Не ЗначениеЗаполнено(ЗаголовокПриложения) Тогда
		Результат.titleStatus = "not-requested";
		Возврат;
	КонецЕсли;
	Если Метаданные.Константы.Найти("ЗаголовокСистемы") = Неопределено Тогда
		Результат.titleStatus = "skipped";
		Возврат;
	КонецЕсли;
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		МенеджерЗначения = Константы["ЗаголовокСистемы"];
		Если МенеджерЗначения.Получить() = ЗаголовокПриложения Тогда
			Результат.titleStatus = "unchanged";
		Иначе
			МенеджерЗначения.Установить(ЗаголовокПриложения);
			Если МенеджерЗначения.Получить() <> ЗаголовокПриложения Тогда
				ВызватьИсключение "Контрольное чтение константы ЗаголовокСистемы вернуло другое значение.";
			КонецЕсли;
			Результат.titleStatus = "set";
		КонецЕсли;
		Результат.titleValue = Строка(МенеджерЗначения.Получить());
	Исключение
		Результат.titleStatus = "failed";
		Результат.titleError = ОписаниеОшибки();
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьРезультат(Путь, ИдентификаторЗапуска, Результат)
	Запись = Новый ЗаписьJSON;
	Запись.ОткрытьФайл(Путь, "UTF-8");
	Запись.ЗаписатьНачалоОбъекта();
	ЗаписатьСвойствоJSON(Запись, "schemaVersion", 2);
	ЗаписатьСвойствоJSON(Запись, "runId", ИдентификаторЗапуска);
	ЗаписатьСвойствоJSON(Запись, "status", Результат.status);
	ЗаписатьСвойствоJSON(Запись, "updateResult", Результат.updateResult);
	ЗаписатьСвойствоJSON(Запись, "errorMessage", Результат.errorMessage);
	ЗаписатьСвойствоJSON(Запись, "errorDetails", Результат.errorDetails);
	ЗаписатьСвойствоJSON(Запись, "titleStatus", Результат.titleStatus);
	ЗаписатьСвойствоJSON(Запись, "titleValue", Результат.titleValue);
	ЗаписатьСвойствоJSON(Запись, "titleError", Результат.titleError);
	Запись.ЗаписатьКонецОбъекта();
	Запись.Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьСвойствоJSON(Запись, Имя, Значение)
	Запись.ЗаписатьИмяСвойства(Имя);
	Запись.ЗаписатьЗначение(Значение);
КонецПроцедуры
