&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Успешно = Ложь;
	ПараметрыКоманды = Неопределено;
	Попытка
		ПараметрыКоманды = ПрочитатьПараметрыЗапуска();
		Результат = ВыполнитьОбновлениеНаСервере();
		ЗаписатьРезультат(ПараметрыКоманды.outputPath, ПараметрыКоманды.runId, Результат);
		Успешно = Результат.status = "passed";
	Исключение
		Ошибка = ОписаниеОшибки();
		Если ПараметрыКоманды <> Неопределено Тогда
			Попытка
				РезультатОшибки = Новый Структура("status,updateResult,errorMessage,errorDetails",
					"failed", "", Ошибка, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				ЗаписатьРезультат(ПараметрыКоманды.outputPath, ПараметрыКоманды.runId, РезультатОшибки);
			Исключение
				Сообщить(ОписаниеОшибки());
			КонецПопытки;
		Иначе
			Сообщить(Ошибка);
		КонецЕсли;
	КонецПопытки;
	ЗавершитьРаботуСистемы(Ложь,, ?(Успешно, "0", "1"));
КонецПроцедуры

&НаКлиенте
Функция ПрочитатьПараметрыЗапуска()
	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(ПараметрЗапуска, "UTF-8");
	ПараметрыКоманды = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	Если Не ЗначениеЗаполнено(ПараметрыКоманды.runId)
		Или Не ЗначениеЗаполнено(ПараметрыКоманды.outputPath) Тогда
		ВызватьИсключение "Не указаны параметры подтверждения обновления ИБ.";
	КонецЕсли;
	Возврат ПараметрыКоманды;
КонецФункции

&НаСервереБезКонтекста
Функция ВыполнитьОбновлениеНаСервере()
	Результат = Новый Структура("status,updateResult,errorMessage,errorDetails", "failed", "", "", "");
	Попытка
		Результат.updateResult = ОбновлениеИнформационнойБазы.ВыполнитьОбновлениеИнформационнойБазы(Истина);
		Если Результат.updateResult = "Успешно" Или Результат.updateResult = "НеТребуется" Тогда
			ОбновлениеИнформационнойБазыСлужебный.ЗаписатьПодтверждениеЛегальностиПолученияОбновлений();
			Результат.status = "passed";
		Иначе
			Результат.errorMessage = "Обновление ИБ вернуло результат: " + Строка(Результат.updateResult);
		КонецЕсли;
	Исключение
		Результат.errorMessage = ОписаниеОшибки();
		Результат.errorDetails = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ЗаписатьРезультат(Путь, ИдентификаторЗапуска, Результат)
	Запись = Новый ЗаписьJSON;
	Запись.ОткрытьФайл(Путь, "UTF-8");
	Запись.ЗаписатьНачалоОбъекта();
	ЗаписатьСвойствоJSON(Запись, "schemaVersion", 1);
	ЗаписатьСвойствоJSON(Запись, "runId", ИдентификаторЗапуска);
	ЗаписатьСвойствоJSON(Запись, "status", Результат.status);
	ЗаписатьСвойствоJSON(Запись, "updateResult", Результат.updateResult);
	ЗаписатьСвойствоJSON(Запись, "errorMessage", Результат.errorMessage);
	ЗаписатьСвойствоJSON(Запись, "errorDetails", Результат.errorDetails);
	Запись.ЗаписатьКонецОбъекта();
	Запись.Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьСвойствоJSON(Запись, Имя, Значение)
	Запись.ЗаписатьИмяСвойства(Имя);
	Запись.ЗаписатьЗначение(Значение);
КонецПроцедуры
