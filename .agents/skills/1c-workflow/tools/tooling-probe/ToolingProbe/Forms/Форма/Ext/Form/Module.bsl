&НаКлиенте
Процедура ПриОткрытии(Отказ)
    Успешно = Ложь;
    Попытка
        Префикс = "ToolingProbe;Params=";
        Путь = Сред(ПараметрЗапуска, СтрДлина(Префикс) + 1);
        Чтение = Новый ЧтениеJSON;
        Чтение.ОткрытьФайл(Путь, "UTF-8");
        ЗапросПроверки = ПрочитатьJSON(Чтение);
        Чтение.Закрыть();
        Результат = ПроверитьНаСервере(ЗапросПроверки.names, ЗапросПроверки.nonce);
        Запись = Новый ЗаписьJSON;
        Запись.ОткрытьФайл(ЗапросПроверки.outputPath, "UTF-8");
        ЗаписатьJSON(Запись, Результат);
        Запись.Закрыть();
        Успешно = Результат.status = "passed";
    Исключение
        Сообщить(ОписаниеОшибки());
    КонецПопытки;
    ЗавершитьРаботуСистемы(Ложь,, ?(Успешно, "0", "1"));
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьНаСервере(Имена, Маркер)
    Результат = Новый Структура("status,nonce,extensions,error", "failed", Маркер, Новый Массив, "");
    Попытка
        Установленные = РасширенияКонфигурации.Получить();
        Активные = РасширенияКонфигурации.Получить(, ИсточникРасширенийКонфигурации.СеансАктивные);
        Для Каждого Имя Из Имена Цикл
            Сведения = Новый Структура("name,present,active,safeMode,unsafeActionProtection,contentHash,serverCodeObject",
                Имя, Ложь, Ложь, Истина, Истина, "", Ложь);
            Для Каждого Расширение Из Установленные Цикл
                Если Расширение.Имя <> Имя Тогда
                    Продолжить;
                КонецЕсли;
                Сведения.present = Истина;
                Сведения.safeMode = Расширение.БезопасныйРежим;
                Сведения.unsafeActionProtection = Расширение.ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях;
                Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
                Хеш.Добавить(Расширение.ПолучитьДанные());
                Сведения.contentHash = Base64Строка(Хеш.ХешСумма);
                Для Каждого Активное Из Активные Цикл
                    Если Активное.Имя = Имя Тогда
                        Сведения.active = Истина;
                        Прервать;
                    КонецЕсли;
                КонецЦикла;
                Если Имя = "VAExtension" Тогда
                    Сведения.serverCodeObject = Метаданные.Обработки.Найти("VAExtension_ВыполнитьПроизвольныйКод") <> Неопределено;
                КонецЕсли;
                Прервать;
            КонецЦикла;
            Результат.extensions.Добавить(Сведения);
        КонецЦикла;
        Результат.status = "passed";
    Исключение
        Результат.error = ОписаниеОшибки();
    КонецПопытки;
    Возврат Результат;
КонецФункции
