// Copy these helpers into the project's pinned Vanessa/EPF adapter.
// Call ready only after own TestClient/session setup and runtime-proof discovery.
// The feature's existing polling/wait step waits for go; do not busy-wait here.
// Call done only after actual form/server readiness; cleanup comes afterward.

Процедура ЗаписатьСигналЗамера(КаталогИтерации, ИмяСигнала, ИдентификаторЗадания) Экспорт
    Сигнал = Новый Структура("jobId,ready", ИдентификаторЗадания, Истина);
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Сигнал);
    Текст = Запись.Закрыть();
    КонечныйПуть = КаталогИтерации + "/" + ИмяСигнала + ".json";
    ВременныйПуть = КонечныйПуть + ".tmp";
    Файл = Новый ЗаписьТекста(ВременныйПуть, КодировкаТекста.UTF8);
    Файл.Записать(Текст);
    Файл.Закрыть();
    ПереместитьФайл(ВременныйПуть, КонечныйПуть);
КонецПроцедуры

Функция РазрешенСтартЗамера(КаталогИтерации, ИдентификаторЗадания) Экспорт
    Путь = КаталогИтерации + "/go.json";
    ФайлСигнала = Новый Файл(Путь);
    Если Не ФайлСигнала.Существует() Тогда
        Возврат Ложь;
    КонецЕсли;
    Чтение = Новый ЧтениеJSON;
    Чтение.ОткрытьФайл(Путь);
    Сигнал = ПрочитатьJSON(Чтение);
    Чтение.Закрыть();
    Возврат Сигнал.jobId = ИдентификаторЗадания;
КонецФункции
