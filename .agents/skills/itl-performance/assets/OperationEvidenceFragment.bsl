// Нейтральный producer-фрагмент для D1 operation map.
// Этот код не пишет в каталог worker: серверный/фоновый сеанс может его не видеть.
// Продуктовый адаптер обязан перенести JSON-фрагмент на клиент или в harness,
// а Python publish_operation_evidence() объединит фрагменты после замеряемой границы.
// Передавайте только семантику и размеры, но не произвольные значения данных.

Функция СоздатьФрагментОперации(ИдентификаторЗадания, НомерИтерации, ИдентификаторОперации, ИдентификаторЭмиттера, Домен) Экспорт
    Результат = Новый Структура;
    Результат.Вставить("schemaVersion", 1);
    Результат.Вставить("jobId", ИдентификаторЗадания);
    Результат.Вставить("iterationId", НомерИтерации);
    Результат.Вставить("operationId", ИдентификаторОперации);
    Результат.Вставить("emitterId", ИдентификаторЭмиттера);
    Результат.Вставить("domain", Домен);
    Результат.Вставить("coverage", "partial");
    Результат.Вставить("streamStatus", Новый Структура("complete,truncated,droppedEvents", Ложь, Ложь, 0));
    Результат.Вставить("clocks", Новый Массив);
    Результат.Вставить("spans", Новый Массив);
    Результат.Вставить("links", Новый Массив);
    Результат.Вставить("payloads", Новый Массив);
    Результат.Вставить("milestones", Новый Массив);
    Результат.Вставить("backgroundOperations", Новый Массив);
    Результат.Вставить("limitations", Новый Массив);
    Возврат Результат;
КонецФункции

Процедура ДобавитьЧасыОперации(Фрагмент, ИдентификаторЧасов, ВидЧасов, Единица) Экспорт
    Часы = Новый Структура("clockId,kind,unit", ИдентификаторЧасов, ВидЧасов, Единица);
    Фрагмент.clocks.Добавить(Часы);
КонецПроцедуры

Процедура ДобавитьИзмеренныйБлокОперации(Фрагмент, ИдентификаторБлока, ИмяБлока, ВидБлока, ИдентификаторЧасов, Длительность, Единица, ИдентификаторРодителя = Неопределено, ИдентификаторВызова = Неопределено, СсылкаНаИсточник = Неопределено) Экспорт
    Мера = Новый Структура("availability,evidenceKind,value,unit", "available", "measured", Длительность, Единица);
    Блок = Новый Структура("spanId,name,domain,kind,clockId,duration,status", ИдентификаторБлока, ИмяБлока, Фрагмент.domain, ВидБлока, ИдентификаторЧасов, Мера, "completed");
    Если ИдентификаторРодителя <> Неопределено Тогда
        Блок.Вставить("parentSpanId", ИдентификаторРодителя);
    КонецЕсли;
    Если ИдентификаторВызова <> Неопределено Тогда
        Блок.Вставить("callId", ИдентификаторВызова);
    КонецЕсли;
    Если СсылкаНаИсточник <> Неопределено Тогда
        Блок.Вставить("sourceRef", СсылкаНаИсточник);
    КонецЕсли;
    Фрагмент.spans.Добавить(Блок);
КонецПроцедуры

Процедура ДобавитьСвязьОперации(Фрагмент, ВидСвязи, ОтБлока, КБлоку, ИдентификаторВызова = Неопределено, ВложенностьДоказана = Неопределено) Экспорт
    Связь = Новый Структура("kind,from,to", ВидСвязи, ОтБлока, КБлоку);
    Если ИдентификаторВызова <> Неопределено Тогда
        Связь.Вставить("callId", ИдентификаторВызова);
    КонецЕсли;
    Если ВложенностьДоказана <> Неопределено Тогда
        Связь.Вставить("contained", ВложенностьДоказана);
    КонецЕсли;
    Фрагмент.links.Добавить(Связь);
КонецПроцедуры

Процедура ДобавитьОписаниеПередачи(Фрагмент, ИдентификаторВызова, Направление, СемантическийВид, Представление, СемантическиеСчетчики, ДиагностическийРазмер, РазмерВПроводе) Экспорт
    Передача = Новый Структура("callId,direction,semanticKind,representation,semanticCounts", ИдентификаторВызова, Направление, СемантическийВид, Представление, СемантическиеСчетчики);
    Передача.Вставить("diagnosticSerializedBytes", ДиагностическийРазмер);
    Передача.Вставить("wireBytes", РазмерВПроводе);
    Фрагмент.payloads.Добавить(Передача);
КонецПроцедуры

Функция ДоступнаяМераОперации(Значение, Единица, ВидДоказательства = "measured") Экспорт
    Возврат Новый Структура("availability,evidenceKind,value,unit", "available", ВидДоказательства, Значение, Единица);
КонецФункции

Функция НеизвестнаяМераОперации(Причина) Экспорт
    Возврат Новый Структура("availability,value,reason", "unknown", Неопределено, Причина);
КонецФункции

Процедура ЗавершитьФрагментОперации(Фрагмент, Покрытие, ПотокПолон = Истина, ПотокОбрезан = Ложь, ПотеряноСобытий = 0) Экспорт
    Фрагмент.coverage = Покрытие;
    Фрагмент.streamStatus = Новый Структура("complete,truncated,droppedEvents", ПотокПолон, ПотокОбрезан, ПотеряноСобытий);
КонецПроцедуры

Функция СериализоватьФрагментОперации(Фрагмент) Экспорт
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    ЗаписатьJSON(Запись, Фрагмент);
    Возврат Запись.Закрыть();
КонецФункции
